<!doctype html>
<html lang="en"><head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="referrer" content="no-referrer">
<title>all — tui</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><text y='13' font-size='12'>🗞️</text></svg>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#111318; --card:#181c23; --line:#262b34; --fg:#e6e9ee;
  --muted:#949ba8; --accent:#4a9eff; --ok:#3fb950; --bad:#f85149;
}
@media (prefers-color-scheme: light){
  :root{ --bg:#f6f7f9; --card:#ffffff; --line:#e3e6eb; --fg:#1b1f26; --muted:#6b7280; --accent:#1a73e8; --bad:#d64545; }
}
*{box-sizing:border-box}
html,body{margin:0;padding:0}
body{
  background:var(--bg); color:var(--fg);
  font:16px/1.55 "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  -webkit-text-size-adjust:100%;
}
.wrap{max-width:640px;margin:0 auto;padding:14px 14px 40px}
header{
  position:sticky;top:0;z-index:10;background:var(--bg);
  display:flex;align-items:center;gap:10px;padding:12px 2px 10px;
  border-bottom:1px solid var(--line);margin-bottom:12px;
}
h1{font-size:20px;margin:0;font-weight:700;letter-spacing:-.02em}
.sub{color:var(--muted);font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.warn{background:rgba(214,69,69,.12);border:1px solid rgba(214,69,69,.5);color:var(--fg);border-radius:10px;padding:10px 12px;margin:-4px 0 12px;font-size:14px}
.health{margin-left:auto;display:flex;align-items:center;gap:12px;font-size:13px;color:var(--muted);white-space:nowrap}
.svc{display:inline-flex;align-items:center;gap:5px}
.hdot{width:8px;height:8px;border-radius:50%;flex:none}
.hdot.ok{background:var(--ok)}
.hdot.bad{background:var(--bad)}
.card{
  background:var(--card);border:1px solid var(--line);border-radius:14px;
  padding:14px 16px;margin-bottom:12px;
}
.ctitle{font-size:17px;line-height:1.35;font-weight:650;color:var(--fg)}
.meta{display:flex;align-items:center;gap:8px;margin-top:8px;font-size:13px;color:var(--muted);flex-wrap:wrap}
.chip{font-weight:700;padding:1px 8px;border-radius:999px;font-size:12px;color:#fff}
.src{font-weight:600;color:var(--fg)}
.dot{opacity:.5}
.body{margin:8px 0 4px;color:var(--fg);white-space:pre-wrap;word-break:break-word;font-size:15px}
.body .link{color:var(--accent);text-decoration:underline;word-break:break-all}
/* how much text the ellipsis is hiding, and the control that reveals it */
.rest{
  margin-left:5px;padding:0;border:0;background:none;font-family:inherit;font-size:13px;font-weight:600;
  color:var(--accent);white-space:nowrap;cursor:pointer;text-decoration:underline;text-underline-offset:2px;
}
/* the embedded post (x's quote box): inset and dimmed so it reads as context,
   not as the post you're on */
.quote{margin:10px 0 2px;padding:10px 12px;border:1px solid var(--line);border-radius:12px;background:rgba(128,128,128,.07)}
.qmeta{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--muted);flex-wrap:wrap}
.qsrc{color:var(--muted);font-weight:600;text-decoration:none}
/* attached stills stay collapsed until the footer's image toggle asks for them,
   so a feed of photo posts is scannable and costs no bandwidth unopened */
.imgbox{margin:10px 0 2px;display:flex;flex-direction:column;gap:8px}
.imgbox img{display:block;width:100%;border-radius:12px;background:var(--line)}
.img[data-on="1"]{color:var(--accent)}
.quote .body{margin:6px 0 0;font-size:14px;color:var(--muted)}
.quote .vidbox{margin-bottom:0}
.quote .vid{max-height:50vh}
.quote .open{font-size:13px;min-height:32px}
.card.read{opacity:.45}
.footer{display:flex;align-items:center;gap:18px;margin-top:12px}
.markall{
  display:block;width:100%;margin:20px 0 0;padding:14px;
  background:var(--card);border:1px dashed var(--line);color:var(--accent);
  border-radius:14px;font-size:15px;font-weight:700;cursor:pointer;min-height:48px;
}
.markall:disabled{opacity:.5;cursor:default}
/* in a deck there is no end of the feed to park this at, so it floats */
.markall.fab{
  position:fixed;z-index:20;width:auto;margin:0;
  right:14px;bottom:calc(14px + env(safe-area-inset-bottom));
  padding:0 16px;min-height:42px;border-radius:999px;border:1px solid var(--line);
  font-size:13px;box-shadow:0 6px 18px rgba(0,0,0,.3);
}
.open{color:var(--accent);text-decoration:none;font-weight:600;font-size:14px;min-height:40px;display:inline-flex;align-items:center;gap:4px}
.expand{background:none;border:none;color:var(--muted);font-size:14px;cursor:pointer;padding:0;min-height:40px}
.speed,.mute,.rot,.save,.img,.share{background:none;border:none;color:var(--muted);font-size:14px;font-weight:700;cursor:pointer;padding:0;min-height:40px}
.save[data-saved="1"]{color:var(--accent)}
.viewlink{color:var(--muted);text-decoration:none;border-bottom:1px dotted var(--line)}
.hid{display:none}
.empty{color:var(--muted);font-style:italic}
.dlg{border:1px solid var(--line);background:var(--card);color:var(--fg);border-radius:16px;padding:20px;max-width:360px;width:calc(100vw - 48px)}
.dlg::backdrop{background:rgba(0,0,0,.55)}
.dlg-title{margin:0 0 6px;font-size:19px;font-weight:700}
.dlg-hint{margin:0 0 16px;color:var(--muted);font-size:15px}
.dlg-actions{display:flex;gap:10px}
.dlg-actions button{flex:1;border-radius:12px;padding:12px 14px;font-size:15px;font-weight:600;min-height:44px;cursor:pointer}
.dlg-go{border:none;background:var(--accent);color:#fff}
.dlg-no{border:1px solid var(--line);background:transparent;color:var(--fg)}
.note{padding:16px;color:var(--muted);border:1px dashed var(--line);border-radius:12px;font-size:15px}
.note a{color:var(--accent);font-weight:600;text-decoration:none}
.linkbtn{padding:0;border:0;background:none;font:inherit;font-weight:600;color:var(--accent);cursor:pointer;text-decoration:underline;text-underline-offset:2px}
.note.offer{margin-top:10px}
.toast{
  position:fixed;left:50%;bottom:18px;transform:translateX(-50%);
  background:var(--fg);color:var(--bg);font-size:14px;font-weight:600;
  padding:8px 16px;border-radius:999px;opacity:0;pointer-events:none;transition:opacity .2s;
}
.yt{position:relative;margin:10px 0 2px;border-radius:12px;overflow:hidden;cursor:pointer;aspect-ratio:16/9;background:#000}
.yt img{width:100%;height:100%;object-fit:cover;display:block;opacity:.85}
.yt .yt-play{
  position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
  font-size:26px;color:#fff;background:rgba(0,0,0,.25);text-shadow:0 1px 8px rgba(0,0,0,.6);
}
.yt-embed{aspect-ratio:16/9;margin:10px 0 2px}
.yt-embed iframe{display:block;width:100%;height:100%;border:0;border-radius:12px}
.yt-blocked{display:block;margin:10px 0 2px;padding:14px;border:1px dashed var(--line);border-radius:12px;color:var(--accent);font-size:14px;font-weight:600;text-decoration:none}
html.ffs-on,html.ffs-on body{overflow-x:hidden;background:#000 !important}
/* guarantee scroll room while rotated: Safari only hides its bars when a swipe
   actually scrolls, and a short or bottomed-out feed otherwise has nowhere to go */
html.ffs-on body{padding-bottom:100lvh}
/* iOS lays out fixed elements against the bars-visible viewport, so the player
   can't cover the status-bar strip or the area around the bottom address bar;
   blank the feed instead so every uncovered edge is seamless black */
html.ffs-on .wrap{visibility:hidden}
.ffs{
  position:fixed !important;top:50vh !important;left:50vw !important;
  top:50lvh !important;left:50lvw !important;
  width:100vh !important;height:100vw !important;
  width:100lvh !important;height:100lvw !important;
  max-height:none !important;margin:0 !important;
  transform:translate(-50%,-50%) rotate(-90deg) !important;transform-origin:center !important;
  border-radius:0 !important;background:#000 !important;
  z-index:2147483646 !important;overflow:hidden !important;
  touch-action:pan-y !important; /* vertical swipes scroll the page, letting mobile Safari hide its bars */
  visibility:visible !important; /* the player lives inside the hidden .wrap */
}
video.ffs{object-fit:cover !important}
.ffs iframe{display:block !important;width:100% !important;height:100% !important;border-radius:0 !important}
.ffs-tap{position:fixed;inset:0;z-index:2147483646;background:transparent;touch-action:manipulation;-webkit-tap-highlight-color:transparent}
.ffs-exit{
  position:fixed;top:max(16px,env(safe-area-inset-top));right:max(16px,env(safe-area-inset-right));
  width:44px;height:44px;border:0;border-radius:50%;padding:0;color:#fff;background:rgba(0,0,0,.65);
  font:24px/44px -apple-system,system-ui,sans-serif;text-align:center;cursor:pointer;
  z-index:2147483647;transform:rotate(-90deg);-webkit-tap-highlight-color:transparent;
}
/* Swipe mode: the feed becomes a deck. One card is on screen at a time, sized
   to the viewport and scrolling inside its own frame, with two empty offset
   cards drawn behind it so the stack reads as "more where that came from". */
/* the deck sits in the middle of what's left of the screen; auto margins
   rather than align-items so a card taller than the space still scrolls to
   its own top instead of being clipped there */
.deckwrap{display:flex;min-height:calc(100dvh - 150px)}
.deckwrap.hid{display:none}
.deckwrap .deck{width:100%;margin:auto 0}
.deck{position:relative}
.deck::before,.deck::after{
  content:'';position:absolute;left:0;right:0;top:0;bottom:0;
  background:var(--card);border:1px solid var(--line);border-radius:14px;z-index:-1;
}
.deck::before{transform:scale(.97) translateY(10px)}
.deck::after{transform:scale(.94) translateY(20px)}
.deck.last::before,.deck.last::after,.deck.last2::after{display:none}
.deck .card{
  margin-bottom:0;
  touch-action:pan-y; /* sideways is ours, up and down stays the browser's scroll */
  -webkit-tap-highlight-color:transparent;
}
.deck .card.fly{transition:transform .26s ease-out, opacity .26s ease-out}
.deck .card.read{opacity:1} /* a swiped card leaves the screen; no need to grey it */
.dragging{user-select:none;-webkit-user-select:none}
.stamp{
  position:absolute;top:14px;left:50%;transform:translateX(-50%);z-index:3;pointer-events:none;
  padding:4px 12px;border-radius:999px;border:2px solid var(--accent);color:var(--accent);
  background:var(--bg);font-size:13px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;
  opacity:0;transition:opacity .1s;
}
.vidbox{position:relative;margin:10px 0 2px}
.vid{display:block;width:100%;max-height:70vh;border-radius:12px;background:#000}
/* how long the clip runs, over the poster: enough to judge a tap before any of
   it downloads (preload="none" means nothing has yet) */
.vlen{
  position:absolute;top:8px;left:8px;pointer-events:none;
  background:rgba(0,0,0,.72);color:#fff;font-size:12px;font-weight:700;
  padding:2px 7px;border-radius:6px;font-variant-numeric:tabular-nums;
}
</style>
</head><body>
<div id="state" data-xauth="{{if .XAuth}}true{{else}}false{{end}}" data-xtab="{{.XTab}}" data-savedview="{{if .SavedView}}true{{else}}false{{end}}" data-swipe="{{if .Swipe}}true{{else}}false{{end}}" hidden></div>
<div class="wrap">
<header>
  <div class="sub" id="sub">{{if .SavedView}}<a class="viewlink" href="/">unread</a> <span id="savedn">{{.Saved}}</span> saved{{else}}{{if .HasApps}}<span id="unreadn">{{.Unread}}</span> unread {{end}}<a class="viewlink" href="/?saved=1"><span id="savedn">{{.Saved}}</span> saved</a>{{end}}</div>
{{if .Health}}<div class="health">{{range .Health}}<span class="svc" title="{{.Title}}"><span class="hdot {{if .OK}}ok{{else}}bad{{end}}"></span>{{.Label}}</span>{{end}}</div>
{{end}}</header>
{{if .Warn}}<div class="warn">⚠ {{.Warn}}</div>
{{end}}{{if .SavedView}}{{if not .Cards}}<div class="note">Nothing saved yet. Tap <b>save</b> on any item to keep it here.</div>
{{end}}{{else if not .HasApps}}<div class="note">No reader app is logged in. Run <code>tui &lt;app&gt; --auth</code> on the host, then refresh this page.</div>
{{else if not .Cards}}<div class="note">Inbox zero across every timeline.</div>
{{if .OfferForYou}}<div class="note offer">All caught up. <a href="/?x=foryou">Continue with For You from x →</a></div>
{{end}}{{end}}{{if and .Swipe .Cards}}<div class="deckwrap"><div class="deck" id="deck">{{range .Cards}}{{template "card" .}}
{{end}}<div class="stamp" id="stamp"></div></div></div>
<div class="note hid" id="deckEnd">Deck's empty — that's every card. <button class="linkbtn" id="deckBack" type="button">← back to the last one</button></div>
{{else}}{{range .Cards}}{{template "card" .}}
{{end}}{{end}}{{if and .Cards (not .SavedView)}}<button id="markAll" class="markall{{if .Swipe}} fab{{end}}" type="button">✓ mark all read</button>
{{end}}<div id="toast" class="toast"></div>
<dialog id="forYou" class="dlg">
  <div class="dlg-body">
    <p class="dlg-title">All read.</p>
    <p class="dlg-hint">Everything's clear. Want to keep going on x's For You timeline?</p>
  </div>
  <div class="dlg-actions">
    <button id="forYouGo" class="dlg-go" type="button">For You</button>
    <button id="forYouNo" class="dlg-no" type="button">Not now</button>
  </div>
</dialog>
<script>
// --swipe serves the same cards as a deck: one on screen, thrown away by hand.
// Everything else on the page (video, images, save, share, expand) is shared
// between the two modes; only the layout and what marks a card read differ.
var SWIPE = document.getElementById('state').getAttribute('data-swipe') === 'true';
var SAVED_VIEW = document.getElementById('state').getAttribute('data-savedview') === 'true';

// Reading = scrolling: the moment a card is fully off-screen (its bottom edge
// clears the top of the viewport) it is marked read and muted in place — it
// stays in the list, greyed, so scrolling back up shows what you've read.
// Marks are batched per app so a fast scroll is one --mark-read call per app.
var pending = {};   // app -> ids that scrolled off, awaiting a flush
var flushTimer = null;
function flushPending(){
  flushTimer = null;
  var apps = Object.keys(pending);
  var dirty = apps.some(function(a){ return pending[a].length > 0; });
  if(!dirty) return;
  apps.forEach(function(app){
    var ids = pending[app]; if(!ids.length) return;
    pending[app] = [];
    var fd = new FormData(); fd.append('app', app); fd.append('json','1');
    ids.forEach(function(id){ fd.append('id', id); });
    fetch('/mark',{method:'POST',body:fd})
      .then(function(res){ return res.json(); })
      .then(function(d){ if(!d.ok) throw 0; decCount(ids.length); })
      .catch(function(){ toast('could not save some reads'); });
  });
}
function decCount(n){
  var s = document.getElementById('unreadn'); if(!s) return;
  var c = (parseInt(s.textContent, 10) || 0) - n; if(c < 0) c = 0;
  s.textContent = c;
  if(c === 0) maybeOfferForYou();   // whole list read
}
function toast(m){ var t=document.getElementById('toast'); t.textContent=m; t.style.opacity='1'; setTimeout(function(){t.style.opacity='0'},1200); }
// queueRead marks one card read: muted in place and batched for the next flush.
function queueRead(el){
  if(el.classList.contains('read')) return false;  // already counted once
  var app = el.dataset.app, id = el.dataset.id;
  if(!app || !id) return false;
  el.classList.add('read');
  (pending[app] = pending[app] || []).push(id);
  if(!flushTimer) flushTimer = setTimeout(flushPending, 400);
  return true;
}
var obs = new IntersectionObserver(function(entries){
  if (ffs) return; // fake fullscreen scrolls the feed behind the video (hiding
                   // Safari's bars); that motion must not mark cards read
  entries.forEach(function(en){
    if(en.isIntersecting) return;                 // still visible
    var el = en.target;
    if(el.getBoundingClientRect().bottom > 0) return; // below, not yet scrolled past
    queueRead(el);
  });
},{threshold:0});
// The saved list is for re-reading, so scrolling through it must not mark
// anything read; in swipe mode the throw does the marking, not the scroll.
if (!SWIPE && !SAVED_VIEW) {
  document.querySelectorAll('article.card').forEach(function(c){ obs.observe(c); });
}

// Save / unsave one item. The button posts just app+id; the server pairs that
// with the item it last rendered and persists the whole thing, so a saved item
// survives the feed moving on.
function setSaved(card, on){
  var b = card.querySelector('button.save');
  var fd = new FormData();
  fd.append('app', card.dataset.app);
  fd.append('id', card.dataset.id);
  fd.append('save', on ? '1' : '0');
  if (b) b.disabled = true;
  return fetch('/save', {method:'POST', body:fd})
    .then(function(res){ if(!res.ok) throw new Error(res.status === 409 ? 'reload the page and try again' : 'could not save'); return res.json(); })
    .then(function(d){
      if (b){ b.dataset.saved = on ? '1' : '0'; b.textContent = on ? 'saved' : 'save'; }
      var n = document.getElementById('savedn');
      if (n) n.textContent = d.saved;
    })
    .catch(function(err){ toast(err.message || 'could not save'); })
    .then(function(){ if (b) b.disabled = false; });
}
document.addEventListener('click', function(e){
  var b = e.target.closest ? e.target.closest('button.save') : null;
  if (!b) return;
  setSaved(b.closest('article.card'), b.dataset.saved !== '1');
});

// Share hands the item's own text (not its quoted post's) to the OS share
// sheet. navigator.share needs a secure context, which a LAN http:// page is
// not, so the same text is copied to the clipboard there instead — the button
// always does something.
function sharePayload(card){
  var title = card.querySelector(':scope > .preview > .ctitle');
  var body = card.querySelector(':scope > .full > .body');   // full, so no clip and no word-count badge
  var link = card.querySelector(':scope > .footer > a.open[target]');
  var parts = [];
  if (title) parts.push(title.textContent.trim());
  if (body) parts.push(body.textContent.trim());
  var d = {text: parts.join('\n\n')};
  if (title) d.title = title.textContent.trim();
  if (link) d.url = link.href;
  return d;
}
function copyText(t){
  if (navigator.clipboard && navigator.clipboard.writeText) return navigator.clipboard.writeText(t);
  return new Promise(function(res, rej){
    var ta = document.createElement('textarea');
    ta.value = t; ta.setAttribute('readonly',''); ta.style.position = 'fixed'; ta.style.opacity = '0';
    document.body.appendChild(ta); ta.select();
    var ok = document.execCommand && document.execCommand('copy');
    ta.remove();
    ok ? res() : rej(new Error('copy failed'));
  });
}
document.addEventListener('click', function(e){
  var b = e.target.closest ? e.target.closest('button.share') : null;
  if (!b) return;
  var d = sharePayload(b.closest('article.card'));
  if (!d.text && !d.url) { toast('nothing to share'); return; }
  if (navigator.share){
    navigator.share(d).catch(function(err){
      if (err && err.name === 'AbortError') return; // sheet dismissed, not a failure
      toast('could not share');
    });
    return;
  }
  copyText([d.text, d.url].filter(Boolean).join('\n\n'))
    .then(function(){ toast('copied'); })
    .catch(function(){ toast('could not share'); });
});

// Attached stills render only when asked for: the footer's image toggle reveals
// every image block on the card (the post's own and its quoted post's) and
// swaps data-src to src the first time, so an unopened card downloads nothing.
document.addEventListener('click', function(e){
  var b = e.target.closest ? e.target.closest('button.img') : null;
  if (!b) return;
  var on = b.dataset.on !== '1';
  b.closest('article.card').querySelectorAll('.imgbox').forEach(function(box){
    box.classList.toggle('hid', !on);
    if (!on) return;
    box.querySelectorAll('img[data-src]').forEach(function(img){
      img.src = img.dataset.src;
      img.removeAttribute('data-src');
    });
  });
  b.dataset.on = on ? '1' : '0';
});

// YouTube links get an inline click-to-play embed: a lazy thumbnail per video
// that swaps on tap to the official IFrame-API player, so the global speed and
// mute toggles drive it too. Embedding is the owner's call — when it's
// disabled (error 101/150) no embed can play the video, so the player is
// swapped for a watch-on-YouTube link instead of a dead black frame.
var ytPlayers = [];
var ytApiRequested = false;
function ytApi(cb){
  if (window.YT && window.YT.Player){ cb(); return; }
  if (!ytApiRequested){
    ytApiRequested = true;
    var s = document.createElement('script');
    s.src = 'https://www.youtube.com/iframe_api';
    document.head.appendChild(s);
  }
  var wait = setInterval(function(){
    if (window.YT && window.YT.Player){ clearInterval(wait); cb(); }
  }, 100);
}
function ytId(href){
  var m = href.match(/(?:youtube\.com\/watch\?[^#]*v=|youtu\.be\/|youtube\.com\/shorts\/|youtube\.com\/embed\/)([\w-]{11})/);
  return m ? m[1] : null;
}
// The length badge a native video renders server-side: YouTube states it
// nowhere the page can read, so the server looks it up and the badge lands on
// the thumbnail when the answer arrives. A tap before then just plays it.
function ytLen(thumb, id){
  fetch('/ytlen?v=' + encodeURIComponent(id))
    .then(function(res){ return res.json(); })
    .then(function(d){
      if (!d.len) return;
      var s = document.createElement('span');
      s.className = 'vlen';
      s.textContent = d.len;
      thumb.appendChild(s);
    })
    .catch(function(){}); // no badge is fine; it is a hint, not the content
}
function ytPlay(thumb, id){
  var wrap = document.createElement('div');
  wrap.className = 'yt-embed';
  var target = document.createElement('div');
  wrap.appendChild(target);
  thumb.replaceWith(wrap);
  ytApi(function(){
    var pending = true;
    var p = new YT.Player(target, {
      videoId: id,
      host: 'https://www.youtube-nocookie.com',
      playerVars: {autoplay: 1, playsinline: 1, origin: location.origin},
      events: {
        onReady: function(e){
          e.target.setPlaybackRate(SPEED);
          if (MUTED) e.target.mute(); else e.target.unMute();
          e.target.playVideo();
        },
        onStateChange: function(e){
          if (e.data === YT.PlayerState.PLAYING && pending){
            e.target.setPlaybackRate(SPEED); // loading resets the rate
            pending = false;
          }
        },
        onError: function(){
          var a = document.createElement('a');
          a.className = 'yt-blocked';
          a.href = 'https://www.youtube.com/watch?v=' + id;
          a.target = '_blank'; a.rel = 'noopener';
          a.textContent = 'embedding disabled — watch on YouTube ↗';
          wrap.replaceWith(a);
          ytPlayers = ytPlayers.filter(function(q){ return q !== p; });
        }
      }
    });
    ytPlayers.push(p);
    wrap._ytPlayer = p; // fake fullscreen finds the player via its wrapper
  });
}
document.querySelectorAll('article.card').forEach(function(card){
  var seen = {};
  card.querySelectorAll('a[href]').forEach(function(a){
    var id = ytId(a.href); if(!id || seen[id]) return; seen[id] = true;
    var d = document.createElement('div');
    d.className = 'yt';
    var img = document.createElement('img');
    img.src = 'https://i.ytimg.com/vi/' + id + '/hqdefault.jpg';
    img.alt = ''; img.loading = 'lazy';
    var play = document.createElement('span');
    play.className = 'yt-play'; play.textContent = '▶';
    d.appendChild(img); d.appendChild(play);
    ytLen(d, id);
    d.addEventListener('click', function(){ ytPlay(d, id); });
    var foot = card.querySelector('.footer');
    foot.before(d);
    // The speed/mute toggles are server-rendered only for native videos;
    // give YouTube cards the same footer controls (no save — YouTube doesn't
    // hand out direct streams the way video.twimg.com does).
    if (!foot.querySelector('button.speed')){
      var sp = document.createElement('button'); sp.type = 'button'; sp.className = 'speed'; sp.title = 'playback speed for all videos';
      var mu = document.createElement('button'); mu.type = 'button'; mu.className = 'mute'; mu.title = 'sound for all videos';
      var ro = document.createElement('button'); ro.type = 'button'; ro.className = 'rot'; ro.title = 'rotated fullscreen'; ro.textContent = 'rotate';
      var ex = foot.querySelector('button.expand');
      foot.insertBefore(sp, ex); foot.insertBefore(mu, ex); foot.insertBefore(ro, ex);
    }
  });
});

// Video playback settings are global: the speed (default 2x) and mute
// (default muted) buttons on any card apply to every player — native <video>
// and YouTube embeds alike — so the whole feed behaves one way. The rate is
// re-applied on play because loading media resets it. Clicks are delegated
// since YouTube cards get their buttons injected after this runs.
var SPEED = 2;
var MUTED = true;
function applyVideoPrefs(){
  document.querySelectorAll('video.vid').forEach(function(v){
    v.defaultPlaybackRate = SPEED; v.playbackRate = SPEED; v.muted = MUTED;
  });
  ytPlayers.forEach(function(p){
    if (p.setPlaybackRate) p.setPlaybackRate(SPEED);
    if (p.mute && p.unMute){ if (MUTED) p.mute(); else p.unMute(); }
  });
  document.querySelectorAll('button.speed').forEach(function(b){ b.textContent = SPEED + '×'; });
  document.querySelectorAll('button.mute').forEach(function(b){ b.textContent = MUTED ? 'unmute' : 'mute'; });
}
document.addEventListener('click', function(e){
  var b = e.target.closest ? e.target.closest('button.speed, button.mute') : null;
  if (!b) return;
  if (b.classList.contains('speed')) SPEED = SPEED === 2 ? 1 : 2;
  else MUTED = !MUTED;
  applyVideoPrefs();
});
document.querySelectorAll('video.vid').forEach(function(v){
  v.addEventListener('play', function(){ v.playbackRate = SPEED; });
});
applyVideoPrefs();

// Fake fullscreen (pipepipe-web's trick): pin the card's player over the
// viewport, sized 100vh×100vw and rotated -90°, so a landscape video fills a
// portrait phone without native fullscreen. A transparent tap layer splits
// the screen into thirds — top seeks +30s, bottom -30s, middle toggles play —
// and the rotated × (or Escape) exits, restoring the scroll position.
var FFS_SEEK = 30;
var ffs = null; // {el, scrollY} while active
function ffsPlayers(){
  if (!ffs) return {};
  if (ffs.el.tagName === 'VIDEO') return {video: ffs.el};
  return {yt: ffs.el._ytPlayer}; // may still be null while the API loads
}
function enterFfs(card){
  if (ffs || !card) return;
  var el = card.querySelector('video.vid') || card.querySelector('.yt-embed');
  if (!el){
    var thumb = card.querySelector('.yt'); // not started yet: start it now
    if (thumb) thumb.click();
    el = card.querySelector('.yt-embed');
    if (!el) return;
  }
  ffs = {el: el, scrollY: window.scrollY || 0};
  var v = ffsPlayers();
  if (v.video && v.video.paused) v.video.play();
  document.documentElement.classList.add('ffs-on');
  el.classList.add('ffs');
  var tap = document.createElement('div');
  tap.className = 'ffs-tap';
  tap.addEventListener('click', ffsTap);
  document.body.appendChild(tap);
  var exit = document.createElement('button');
  exit.className = 'ffs-exit'; exit.type = 'button'; exit.title = 'exit fullscreen';
  exit.textContent = '×';
  exit.addEventListener('click', exitFfs);
  document.body.appendChild(exit);
}
function exitFfs(){
  if (!ffs) return;
  document.documentElement.classList.remove('ffs-on');
  ffs.el.classList.remove('ffs');
  var t = document.querySelector('.ffs-tap'); if (t) t.remove();
  var x = document.querySelector('.ffs-exit'); if (x) x.remove();
  window.scrollTo(0, ffs.scrollY);
  ffs = null;
}
function ffsTap(e){
  e.preventDefault();
  var pos = e.clientY / window.innerHeight;
  if (pos < 1/3) ffsSeek(FFS_SEEK);
  else if (pos > 2/3) ffsSeek(-FFS_SEEK);
  else ffsToggle();
}
function ffsSeek(d){
  var v = ffsPlayers();
  if (v.yt && v.yt.seekTo){
    var dur = (v.yt.getDuration && v.yt.getDuration()) || Infinity;
    v.yt.seekTo(Math.min(dur, Math.max(0, v.yt.getCurrentTime() + d)), true);
  } else if (v.video){
    var vd = isFinite(v.video.duration) ? v.video.duration : Infinity;
    v.video.currentTime = Math.min(vd, Math.max(0, v.video.currentTime + d));
  }
}
function ffsToggle(){
  var v = ffsPlayers();
  if (v.yt && v.yt.getPlayerState){
    if (v.yt.getPlayerState() === YT.PlayerState.PLAYING) v.yt.pauseVideo();
    else v.yt.playVideo();
  } else if (v.video){
    if (v.video.paused) v.video.play(); else v.video.pause();
  }
}
document.addEventListener('click', function(e){
  var b = e.target.closest ? e.target.closest('button.rot') : null;
  if (b) enterFfs(b.closest('article.card'));
});
document.addEventListener('keydown', function(e){ if (e.key === 'Escape') exitFfs(); });

// Expand/collapse reveals the full post content — the card's own body and the
// quoted post's, which each render as their own preview/full pair. Expanding
// is the "+N words" count at the end of the clipped text (server-rendered, so
// delegate); collapsing is the footer button, which exists only while there is
// something expanded to collapse.
document.addEventListener('click', function(e){
  var b = e.target.closest ? e.target.closest('button.rest, button.expand') : null;
  if (!b) return;
  var card = b.closest('article.card');
  card.querySelectorAll('.preview, .full').forEach(function(el){ el.classList.toggle('hid'); });
  var expanded = card.querySelector('.preview').classList.contains('hid');
  var less = card.querySelector('.footer > button.expand');
  if (less) less.classList.toggle('hid', !expanded);
});
// Mark everything read with one tap (scroll can't reach the last cards).
var markAllBtn = document.getElementById('markAll');
if(markAllBtn) markAllBtn.addEventListener('click', function(){
  var groups = {};
  document.querySelectorAll('article.card:not(.read)').forEach(function(card){
    var app = card.dataset.app, id = card.dataset.id;
    if(!app || !id) return;
    (groups[app] = groups[app] || []).push(id);
    card.classList.add('read');
  });
  var n = 0;
  Object.keys(groups).forEach(function(app){
    var ids = groups[app]; n += ids.length;
    var fd = new FormData(); fd.append('app', app); fd.append('json','1');
    ids.forEach(function(id){ fd.append('id', id); });
    fetch('/mark',{method:'POST',body:fd})
      .then(function(res){ return res.json(); })
      .then(function(d){ if(!d.ok) throw 0; })
      .catch(function(){ toast('could not save all reads'); });
  });
  decCount(n);
  markAllBtn.textContent = '✓ all read';
  markAllBtn.disabled = true;
});

// The deck (--swipe): one card on screen, dealt with by hand. Throw it left to
// mark it read and deal the next; pull right to walk back through what's
// already been dealt, as far back as the first card. Up and down are left
// alone so the page scrolls as it always did, and saving stays the footer
// button it already was. On a desktop → deals and ← walks back.
if (SWIPE) (function(){
  var deck = document.getElementById('deck');
  if (!deck) return;
  var cards = [].slice.call(deck.querySelectorAll('article.card'));
  var stamp = document.getElementById('stamp');
  var endEl = document.getElementById('deckEnd');
  var backEl = document.getElementById('deckBack');
  var at = 0;

  function current(){ return at < cards.length ? cards[at] : null; }
  function show(){
    cards.forEach(function(c, i){ c.classList.toggle('hid', i !== at); });
    var left = cards.length - at;
    deck.classList.toggle('last2', left === 2);
    deck.classList.toggle('last', left <= 1);
    window.scrollTo(0, 0); // the card that scrolled is gone; start the next at its top
    var done = at >= cards.length;
    // Hide the centering wrapper, not just the deck, or its height would leave
    // a hole above the end note. Reversible: walking back brings it out again.
    deck.parentNode.classList.toggle('hid', done);
    if (endEl) endEl.classList.toggle('hid', !done);
  }
  // A card that leaves the screen takes its audio with it.
  function quiet(card){
    card.querySelectorAll('video').forEach(function(v){ v.pause(); });
    card.querySelectorAll('.yt-embed').forEach(function(w){
      if (w._ytPlayer && w._ytPlayer.pauseVideo) w._ytPlayer.pauseVideo();
    });
  }
  function place(card, dx){
    card.style.transform = dx ? 'translateX(' + dx + 'px) rotate(' + (dx / 28) + 'deg)' : '';
  }
  function settle(card){
    card.classList.add('fly');
    place(card, 0);
    setTimeout(function(){ card.classList.remove('fly'); }, 260);
  }
  function throwOut(card, dx){
    quiet(card);
    card.classList.add('fly');
    place(card, dx);
    card.style.opacity = '0';
    setTimeout(function(){
      card.classList.remove('fly');
      card.style.transform = '';
      card.style.opacity = '';
      at++;
      show();
    }, 260);
  }
  function mark(card){
    if (!SAVED_VIEW) queueRead(card); // the flush decrements the header count
    throwOut(card, -(window.innerWidth + 120));
  }
  // Walk back through what's already been dealt, as far as the first card.
  // Those items stay read — you read them — this is only a second look.
  function back(){
    if (at === 0){ toast('this is the first one'); return false; }
    var leaving = current();
    if (leaving){
      quiet(leaving);
      leaving.classList.remove('fly');
      place(leaving, 0);
    }
    at--;
    show();
    var card = current();
    card.classList.remove('fly');
    place(card, -(window.innerWidth + 120)); // returns from the side it left by
    void card.offsetWidth;                   // land the start position before transitioning
    card.classList.add('fly');
    place(card, 0);
    setTimeout(function(){ card.classList.remove('fly'); }, 260);
    return true;
  }
  function showStamp(text, amount){
    if (!stamp) return;
    if (text) stamp.textContent = text;
    stamp.style.opacity = amount;
  }

  function thX(){ return Math.min(120, window.innerWidth * 0.28); } // read per gesture: the phone may have rotated
  var drag = null;
  deck.addEventListener('pointerdown', function(e){
    if (ffs || (e.button != null && e.button !== 0)) return;
    var card = current();
    if (!card || card !== e.target.closest('article.card')) return;
    // The card's own controls (player, links, footer buttons) own their taps.
    if (e.target.closest('button, a, video, iframe, input, .yt')) return;
    drag = {card: card, id: e.pointerId, x0: e.clientX, y0: e.clientY, dx: 0, dy: 0, axis: '', t0: Date.now()};
  });
  deck.addEventListener('pointermove', function(e){
    if (!drag || e.pointerId !== drag.id) return;
    var card = drag.card;
    drag.dx = e.clientX - drag.x0;
    drag.dy = e.clientY - drag.y0;
    if (!drag.axis){
      if (Math.abs(drag.dx) < 8 && Math.abs(drag.dy) < 8) return;
      // A vertical drag is the page scrolling: let go of it entirely.
      if (Math.abs(drag.dy) >= Math.abs(drag.dx)){ drag = null; return; }
      drag.axis = 'x';
      document.body.classList.add('dragging');
      deck.setPointerCapture(e.pointerId);
    }
    e.preventDefault();
    place(card, drag.dx);
    showStamp(drag.dx < 0 ? 'read' : 'back', Math.min(1, Math.abs(drag.dx) / thX()));
  });
  function release(e){
    if (!drag || (e && e.pointerId !== drag.id)) return;
    var card = drag.card, dx = drag.dx, axis = drag.axis;
    var quick = Date.now() - drag.t0 < 300; // a flick counts for less distance
    drag = null;
    document.body.classList.remove('dragging');
    showStamp('', 0);
    if (!axis) return;                      // never passed the slop: a tap, not a throw
    if (Math.abs(dx) < thX() && !(quick && Math.abs(dx) > 55)){ settle(card); return; }
    if (dx < 0) mark(card);                 // thrown left: read it and deal the next
    else if (!back()) settle(card);         // pulled right: the one before this, if there is one
  }
  deck.addEventListener('pointerup', release);
  deck.addEventListener('pointercancel', release);
  if (backEl) backEl.addEventListener('click', back); // the end of the deck has no card to pull

  document.addEventListener('keydown', function(e){
    if (ffs || e.metaKey || e.ctrlKey || e.altKey) return;
    if (e.key === 'ArrowLeft'){ e.preventDefault(); back(); }
    else if (e.key === 'ArrowRight'){
      var card = current();
      if (card){ e.preventDefault(); mark(card); }
    }
  });
  show();
})();

// x feed state (from the server): whether x is authed and which tab is live.
var st = document.getElementById('state');
var X_AUTHED = st ? st.getAttribute('data-xauth') === 'true' : false;
var X_TAB = st ? st.getAttribute('data-xtab') : 'following';
var forYouPrompted = false;
// The ?x=foryou hand-off is one-shot: strip the param so any later reload
// returns to the normal Following default.
if(location.search.indexOf('x=foryou') !== -1){ history.replaceState(null, '', location.pathname); }
// Once the whole list is read, offer to keep going on x For You.
function maybeOfferForYou(){
  if(forYouPrompted || !X_AUTHED || X_TAB !== 'following') return;
  forYouPrompted = true;
  document.getElementById('forYou').showModal();
}
document.getElementById('forYouGo').addEventListener('click', function(){ location.href = '/?x=foryou'; });
document.getElementById('forYouNo').addEventListener('click', function(){ document.getElementById('forYou').close(); });
</script>
</div></body></html>
{{define "card"}}<article class="card" data-app="{{.App}}" data-id="{{.ID}}"><div class="meta"><span class="chip" style="background:{{.Color}}">{{.Chip}}</span>{{if .Source}}<span class="src">{{.Source}}</span>{{end}}{{if .Author}}<span class="dot">·</span><span>{{.Author}}</span>{{end}}{{if .Age}}<span class="dot">·</span><span>{{.Age}}</span>{{end}}</div><div class="preview">{{if .Title}}<div class="ctitle">{{.Title}}</div>{{end}}{{if .PreviewBody}}<div class="body">{{.PreviewBody}}</div>{{end}}</div><div class="full hid">{{if .Title}}<div class="ctitle">{{.Title}}</div>{{end}}{{if .FullBody}}<div class="body">{{.FullBody}}</div>{{end}}</div>{{if .Video}}<div class="vidbox"><video class="vid" controls playsinline muted preload="none"{{if .Poster}} poster="{{.Poster}}"{{end}} src="{{.Video}}"></video>{{if .VidLen}}<span class="vlen">{{.VidLen}}</span>{{end}}</div>{{end}}{{if .Images}}<div class="imgbox hid">{{range .Images}}<img data-src="{{.}}" alt="" loading="lazy">{{end}}</div>{{end}}{{with .Quote}}<blockquote class="quote"><div class="qmeta">{{if .URL}}<a class="qsrc" href="{{.URL}}" target="_blank" rel="noopener" title="open the quoted post">{{.Source}} ↗</a>{{else}}<span class="qsrc">{{.Source}}</span>{{end}}{{if .Author}}<span class="dot">·</span><span>{{.Author}}</span>{{end}}</div>{{if .PreviewBody}}<div class="preview"><div class="body">{{.PreviewBody}}</div></div><div class="full hid"><div class="body">{{.FullBody}}</div></div>{{end}}{{if .Images}}<div class="imgbox hid">{{range .Images}}<img data-src="{{.}}" alt="" loading="lazy">{{end}}</div>{{end}}{{if .Video}}<div class="vidbox"><video class="vid" controls playsinline muted preload="none"{{if .Poster}} poster="{{.Poster}}"{{end}} src="{{.Video}}"></video>{{if .VidLen}}<span class="vlen">{{.VidLen}}</span>{{end}}</div><a class="open" href="/dl?n=x-{{$.ID}}-quote.mp4&u={{.Video}}" title="download the quoted video"><span>keep</span></a>{{end}}</blockquote>{{end}}<div class="footer">{{if .URL}}<a class="open" href="{{.URL}}" target="_blank" rel="noopener" title="open original"><span>open</span></a>{{end}}<button class="save" type="button" data-saved="{{if .Saved}}1{{else}}0{{end}}" title="keep this item in the saved list">{{if .Saved}}saved{{else}}save{{end}}</button><button class="share" type="button" title="share this item">share</button>{{if .HasVideo}}<button class="speed" type="button" title="playback speed for all videos">2×</button><button class="mute" type="button" title="sound for all videos">unmute</button><button class="rot" type="button" title="rotated fullscreen">rotate</button>{{end}}{{if .HasImage}}<button class="img" type="button" data-on="0" title="show the attached images">image</button>{{end}}{{if .Video}}<a class="open" href="/dl?n=x-{{.ID}}.mp4&u={{.Video}}" title="download video"><span>keep</span></a>{{end}}{{if .Expand}}<button class="expand hid" type="button">less</button>{{end}}</div></article>{{end}}
