<!doctype html>
<html lang="en"><head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="referrer" content="no-referrer">
<script>
// Which way the feed runs, whether it is a list or a deck, and how saved items
// are laid out are this browser's to remember. The server does the sorting and
// laying out because a page carries a window of the backlog; rearranging cards
// already here would work on a slice rather than the feed. These choices live
// in the URL. localStorage supplies a remembered choice when the URL names
// none; an explicit URL replaces the remembered choice. All preferences settle
// in one pass, so restoration redirects at most once.
//
// The server defaults to the list and full saved cards, so only remembered
// alternatives need a redirect. A browser with nothing remembered yet gets one
// guess from the device it is: a coarse pointer is a thumb, and a thumb wants a
// card at a time. Guessing once beats a flag on the server, which could only
// ever be right about one of the devices reading the same feed.
(function(){
  try{
    var u = new URL(location.href);
    if (u.pathname !== '/') return;
    function redirect(){ location.replace(u.toString()); }
    var moved = false;
    if (u.searchParams.get('saved') === '1'){
      var compact = u.searchParams.get('compact');
      if (compact === '1' || compact === '0') localStorage.setItem('tui:saved-compact', compact);
      else if (localStorage.getItem('tui:saved-compact') === '1'){
        u.searchParams.set('compact', '1'); moved = true;
      }
      if (moved) redirect();
      return;
    }
    if (u.searchParams.get('blocked') === '1') return;
    // In the list a card is marked read by scrolling past it, which makes where
    // the page starts ours rather than the browser's to restore: Firefox puts a
    // reload back at the old offset, and every card above it would then be
    // reported as scrolled past by an observer that never saw you scroll. Start
    // at the top, where what is left of the list begins.
    if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
    var order = u.searchParams.get('order');
    if (order === 'asc' || order === 'desc' || order === 'best') localStorage.setItem('tui:order', order);
    else {
      var keptOrder = localStorage.getItem('tui:order');
      if (keptOrder === 'desc' || keptOrder === 'best'){ u.searchParams.set('order', keptOrder); moved = true; }
    }
    var deck = u.searchParams.get('deck');
    if (deck === '1' || deck === '0') localStorage.setItem('tui:deck', deck);
    else {
      var kept = localStorage.getItem('tui:deck');
      if (kept !== '1' && kept !== '0' && matchMedia('(pointer: coarse)').matches) kept = '1';
      if (kept === '1'){ u.searchParams.set('deck', '1'); moved = true; }
    }
    if (moved) redirect();
  }catch(e){}
})();
</script>
<title>{{.HeadTitle}}</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><text y='13' font-size='12'>🗞️</text></svg>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#111318; --card:#181c23; --line:#262b34; --fg:#e6e9ee;
  --muted:#949ba8; --accent:#4a9eff; --ok:#3fb950; --bad:#f85149;
}
@media (prefers-color-scheme: light){
  :root{ --bg:#f6f7f9; --card:#ffffff; --line:#e3e6eb; --fg:#1b1f26; --muted:#6b7280; --accent:#1a73e8; --bad:#d64545; }
}
*{box-sizing:border-box}
html,body{margin:0;padding:0}
body{
  background:var(--bg); color:var(--fg);
  font:16px/1.55 "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  -webkit-text-size-adjust:100%;
}
.wrap{max-width:640px;margin:0 auto;padding:14px 14px 40px}
header{
  position:sticky;top:0;z-index:10;background:var(--bg);
  display:flex;align-items:center;gap:10px;padding:12px 2px 10px;
  border-bottom:1px solid var(--line);margin-bottom:12px;
}
h1{font-size:20px;margin:0;font-weight:700;letter-spacing:-.02em}
/* the counts take the room the controls at the far end leave, and give it back
   by cropping themselves rather than pushing them off */
.sub{flex:1;min-width:0;color:var(--muted);font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.warn{background:rgba(214,69,69,.12);border:1px solid rgba(214,69,69,.5);color:var(--fg);border-radius:10px;padding:10px 12px;margin:-4px 0 12px;font-size:14px}
.card{
  background:var(--card);border:1px solid var(--line);border-radius:14px;
  padding:14px 16px;margin-bottom:12px;
}
.ctitle{font-size:17px;line-height:1.35;font-weight:650;color:var(--fg)}
#state[data-blockedview="true"]+.wrap .ctitle{font-weight:400}
.compact-only{display:none}
.card.compact.expandable>.preview>.ctitle:not(.compact-only),
.card.compact.expandable>.preview>.body,
.card.compact.expandable>.full,
.card.compact.expandable>.vidbox,
.card.compact.expandable>.aud,
.card.compact.expandable>.imgbox,
.card.compact.expandable>.quote,
.card.compact.expandable>.yt,
.card.compact.expandable>.yt-embed,
.card.compact.expandable>.yt-blocked{display:none}
.card.compact.expandable .compact-only{display:block}
.card.compact[data-app="x"] .ctitle,
.card.compact[data-app="xforyou"] .ctitle{
  display:-webkit-box;overflow:hidden;-webkit-box-orient:vertical;-webkit-line-clamp:3;
  font-size:15px;font-weight:400;white-space:pre-wrap;word-break:break-word;
}
.meta{display:flex;align-items:center;gap:8px;margin-top:8px;font-size:13px;color:var(--muted);flex-wrap:wrap}
.chip{font-weight:700;padding:1px 8px;border-radius:999px;font-size:12px;color:#fff}
.src{font-weight:600;color:var(--fg)}
.dot{opacity:.5}
.body{margin:8px 0 4px;color:var(--fg);white-space:normal;overflow-wrap:anywhere;font-size:15px}
.body .link{color:var(--accent);text-decoration:underline;word-break:break-all}
.body>:first-child{margin-top:0}
.body>:last-child{margin-bottom:0}
.body p{margin:8px 0}
.body h1,.body h2,.body h3,.body h4,.body h5,.body h6{
  margin:14px 0 6px;font-size:16px;line-height:1.35;letter-spacing:0;
}
.body .table-scroll{width:100%;margin:12px 0;overflow-x:auto;overscroll-behavior-x:contain}
.body table{width:max-content;min-width:100%;border-collapse:collapse;font-size:13px;white-space:normal}
.body th,.body td{min-width:96px;padding:6px 8px;border:1px solid var(--line);vertical-align:top}
.body th{background:var(--bg);font-weight:700}
.body code{padding:1px 4px;border-radius:4px;background:var(--bg);font-size:.9em}
/* a code block scrolls sideways rather than wrapping: a wrapped program reads
   as a different program, and the card is narrower than most lines of code */
.body pre{
  margin:12px 0;padding:10px 12px;border:1px solid var(--line);border-radius:8px;
  background:var(--bg);font-size:13px;line-height:1.45;
  overflow-x:auto;overscroll-behavior-x:contain;
}
.body pre code{padding:0;border-radius:0;background:none;font-size:inherit}
/* how much text the ellipsis is hiding, and the control that reveals it */
.rest{
  margin-left:5px;padding:0;border:0;background:none;font-family:inherit;font-size:13px;font-weight:600;
  color:var(--accent);white-space:nowrap;cursor:pointer;text-decoration:underline;text-underline-offset:2px;
}
/* the embedded post (x's quote box): inset and dimmed so it reads as context,
   not as the post you're on */
.quote{margin:10px 0 2px;padding:10px 12px;border:1px solid var(--line);border-radius:12px;background:rgba(128,128,128,.07)}
.qmeta{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--muted);flex-wrap:wrap}
.qsrc{color:var(--muted);font-weight:600;text-decoration:none}
/* attached stills stay collapsed until the footer's image toggle asks for them,
   so a feed of photo posts is scannable and costs no bandwidth unopened */
.imgbox{margin:10px 0 2px;display:flex;flex-direction:column;gap:8px}
.imgbox img{display:block;width:100%;border-radius:12px;background:var(--line)}
.img[data-on="1"]{color:var(--accent)}
.quote .body{margin:6px 0 0;font-size:14px;color:var(--muted)}
.quote .vidbox{margin-bottom:0}
.quote .vid{max-height:50vh}
.quote .open{font-size:13px;min-height:32px}
/* A row of chips over the first card, grouped by axis: which service it came
   from, what it carries. One is on at a time, and picking it loads a page of
   its items alone, so each chip is a link rather than a switch.
   The groups are display:contents so every chip is a flex item of the one row
   and they fill it as they come — a nested flex box per group would break the
   line at the group boundary and leave the rest of it empty. */
.filters{display:flex;flex-wrap:wrap;align-items:center;gap:6px;margin:0 0 12px}
.fgroup{display:contents}
/* groups are set apart by a wider gap, not a rule: the row wraps as chips are
   added, and a rule at the start of a wrapped line reads as a stray mark */
.fgroup+.fgroup>.fchip:first-child{margin-left:8px}
.filtersep{color:var(--line);font-size:16px;margin:0 2px}
.fchip{
  display:inline-flex;align-items:center;gap:5px;cursor:pointer;
  background:var(--card);border:1px solid var(--line);border-radius:999px;
  padding:3px 9px;min-height:32px;color:var(--muted);
  font:inherit;font-size:13px;font-weight:600;text-decoration:none;
}
.fchip[data-on="1"]{border-color:var(--accent);color:var(--fg)}
.fchip .fn{font-variant-numeric:tabular-nums;opacity:.65}
/* a source chip's count is that service's status light too, which is what the
   header's separate row of dots used to be: green means the last sweep of it
   worked, red means it didn't and this number is stale */
.fchip .fn.ok{color:var(--ok);opacity:1}
.fchip .fn.bad{color:var(--bad);opacity:1}
/* A source with a backlog carries a second half: the chip picks, the icon beside
   it asks for a briefing of what the chip counts. The two are drawn as one pill
   with a divider rather than as two controls, because they are one thing — that
   source — offering the two things you can do with it. The pair is a single flex
   item of the row (the groups are display:contents) so it cannot wrap apart. */
.fpair{display:inline-flex;align-items:stretch}
.fpair>.fchip{border-top-right-radius:0;border-bottom-right-radius:0;border-right:0}
.fsum{
  display:inline-flex;align-items:center;justify-content:center;cursor:pointer;
  width:34px;min-height:32px;padding:0;
  background:var(--card);border:1px solid var(--line);
  border-top-right-radius:999px;border-bottom-right-radius:999px;
  border-left:1px solid var(--line);color:var(--muted);
  -webkit-tap-highlight-color:transparent;
}
.fsum svg{width:17px;height:17px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linejoin:round}
/* Asked for and not yet answered: the sparkle gives way to a ring, because a
   briefing takes minutes and a chip that looked idle would be asked for twice. */
.fsum .fspin{display:none;width:15px;height:15px;border:2px solid var(--line);border-top-color:var(--accent);border-radius:50%;animation:fspin .7s linear infinite}
.fsum[data-state="running"] .fsumi{display:none}
.fsum[data-state="running"] .fspin{display:block}
/* Written and waiting: the sparkle fills in. Only the sparkle — an accent
   border on the chip means that source is the pick this page is narrowed to, and
   nothing else gets to say that. */
.fsum[data-state="done"]{color:var(--accent)}
.fsum[data-state="done"] svg{fill:currentColor;stroke:currentColor}
.fpair>.fchip[data-on="1"]+.fsum{border-color:var(--accent)}
@keyframes fspin{to{transform:rotate(360deg)}}
/* the second layer, under the source row: which subreddit, which rss feed. Only
   the busiest of them fit — a source can have dozens, and a wall of them would
   push the first card off the screen — so the script keeps one row and the rest
   are behind "more". Pulled up tight against the row it narrows, so the two read
   as one control rather than two. */
.subs{margin-top:-6px}
/* a feed title runs as long as its owner felt like; the chip is capped and the
   whole of it stays in the tooltip */
.subs .slabel{max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.fmore{color:var(--accent)}
.card.read{opacity:.45}
/* The unread count opens browser-local settings without adding another header
   control to the narrow row. */
.settings{
  padding:0;border:0;background:none;font:inherit;color:inherit;cursor:pointer;
}
/* when the last fetch landed. It used to sit beside the count in the header,
   which is four links wide on a phone and had no room for a fifth thing. */
.settingnote{margin-top:18px;font-size:12px;color:var(--muted)}
/* a card with a player carries most of a dozen actions, more than a phone is
   wide: the row scrolls sideways rather than wrapping into a second line that
   would push the next card down */
.footer{
  display:flex;align-items:center;gap:18px;margin-top:12px;
  overflow-x:auto;overscroll-behavior-x:contain;scrollbar-width:none;
  touch-action:pan-x; /* sideways here is the row's, not the deck's */
}
.footer::-webkit-scrollbar{display:none}
.footer>*{flex:none}
.markall{
  display:block;width:100%;margin:20px 0 0;padding:14px;
  background:var(--card);border:1px dashed var(--line);color:var(--accent);
  border-radius:14px;font-size:15px;font-weight:700;cursor:pointer;min-height:48px;
}
.markall:disabled{opacity:.5;cursor:default}
/* why the button's number is smaller than the header's: the page carries a
   window of the backlog, and this is the rest of it */
.markall .behind{font-weight:600;font-size:12px;color:var(--muted);margin-left:6px}
/* The deck's single-item and bulk read actions sit under either thumb. */
.markall.fab{
  position:fixed;z-index:20;margin:0;
  bottom:calc(14px + env(safe-area-inset-bottom));
  width:52px;height:52px;min-height:0;padding:0;
  display:flex;align-items:center;justify-content:center;
  border:1px solid var(--line);border-radius:999px;
  box-shadow:0 6px 18px rgba(0,0,0,.3);color:var(--muted);opacity:.5;
}
.markall.fab#markAll{right:14px}
.markall.fab svg{display:block;height:22px;width:auto}
.markall.hid{display:none} /* .hid alone loses to .markall.fab */
/* The deck's controls, an edge to a thumb: < and > walk the deck. What the
   arrow keys are on a desktop, for a phone that has none. */
.deckctl{
  position:fixed;z-index:20;top:50%;
  display:flex;flex-direction:column;transform:translateY(-50%);
}
.deckctl.atleft{left:max(-8px,calc(50% - 328px))}
.deckctl.atright{right:max(-8px,calc(50% - 328px))}
.deckbtn{
  width:44px;height:52px;padding:0;display:flex;align-items:center;justify-content:center;
  border:0;background:transparent;color:var(--muted);cursor:pointer;opacity:.5;
  font-size:28px;font-weight:400;line-height:1;transition:opacity .12s,color .12s,transform .12s;
}
/* The two that walk the deck are drawn rather than typed: a text < is a
   mathematical sign set at whatever weight the font feels like, and these are
   the controls a thumb spends the whole session on. Stroked like the mark-all
   check, so the three controls a phone carries are one hand. */
.deckbtn#deckPrev svg,.deckbtn#deckNext svg{width:26px;height:26px;display:block}
.deckbtn:disabled{opacity:.18;cursor:default}
.deckctl.hid{display:none}
/* ...and only there: a mouse has the arrow keys these stand in for, so on a
   desktop they are two columns of chrome beside the card for nothing. Same
   test the head script picks the deck by, so the controls show up exactly
   where the deck is what you land on. */
@media (pointer: fine){.deckctl{display:none}}
.open{color:var(--muted);text-decoration:none;font-weight:700;font-size:14px;min-height:40px;display:inline-flex;align-items:center;gap:4px}
.expand{background:none;border:none;color:var(--muted);font-size:14px;cursor:pointer;padding:0;min-height:40px}
.speed,.mute,.rot,.save,.img,.share,.rgv,.loop,.detail,.gist{background:none;border:none;color:var(--muted);font-size:14px;font-weight:700;cursor:pointer;padding:0;min-height:40px}
/* the discussion under a Hacker News card, asked for from the card. Filled in
   the accent colour once there is one, the same thing the source sparkles say,
   and dimmed while the model is reading the thread. */
.gist[data-state="done"]{color:var(--accent)}
.gist[data-state="running"]{opacity:.55;cursor:default}
/* ...and where it lands: under the footer that asked for it, inside the card,
   set off by the same rule the tag row uses rather than a box of its own. */
.gistbox{margin-top:14px;padding-top:12px;border-top:1px solid var(--line);font-size:14px}
.gmeta{display:flex;align-items:center;gap:8px;margin-bottom:6px;font-size:12px;color:var(--muted);flex-wrap:wrap}
.gistbox .body{font-size:14px}
.gistbox .body ul,.gistbox .body ol{margin:6px 0;padding-left:20px}
.gistbox .body li{margin:3px 0}
.gistbox .body p{margin:6px 0}
.gagain{
  margin-left:auto;padding:0;border:0;background:none;font-family:inherit;font-size:12px;font-weight:600;
  color:var(--accent);white-space:nowrap;cursor:pointer;text-decoration:underline;text-underline-offset:2px;
}
.rgv:disabled{opacity:.6;cursor:default}
.rgv[data-on="1"]{color:var(--accent)}
.loop[data-on="1"]{color:var(--accent)}
.save[data-saved="1"]{color:var(--accent)}
.tagrow{display:flex;flex-wrap:wrap;gap:6px;margin-top:14px;padding-top:12px;border-top:1px solid var(--line)}
.itemtag{
  min-height:30px;padding:3px 9px;border:1px solid var(--line);border-radius:999px;
  background:transparent;color:var(--muted);font:inherit;font-size:12px;font-weight:600;cursor:pointer;
}
.itemtag[data-on="1"]{border-color:var(--accent);color:var(--accent);background:rgba(74,158,255,.08)}
.itemtag:disabled{opacity:.5;cursor:default}
.viewlink{color:var(--muted);text-decoration:none;border-bottom:1px dotted var(--line)}
/* The row is four names and no numbers: the counts are what pushed the last of
   them off the edge of a phone, and the chips under it already say how deep the
   backlog is. The view you are on wears the accent instead of a count. */
.viewon{color:var(--accent);border-bottom-color:var(--accent)}
/* which way the feed runs and which shape it is in, at the far end of the
   header: each word is what the page already is, and the tap turns it around.
   They keep their width while the counts beside them are free to ellipsis,
   since a header narrow enough to crop something should crop the numbers
   rather than the only controls there. */
.sortlink,.decklink{
  flex:none;display:inline-flex;align-items:center;gap:4px;
  color:var(--muted);font-size:13px;white-space:nowrap;text-decoration:none;
  border-bottom:1px dotted var(--line);
}
.sortlink .sarrow,.decklink .dmark{font-size:12px;opacity:.7}
button.headbutton{padding:0;background:none;border:0;border-bottom:1px dotted var(--line);font-family:inherit;font-size:13px;cursor:pointer}
button.headbutton:disabled{opacity:.5;cursor:default}
/* the keywords link is a button (it opens a dialog, it doesn't go anywhere),
   so it has to be talked back into looking like the links beside it */
button.viewlink{background:none;border:0;border-bottom:1px dotted var(--line);padding:0;font:inherit;cursor:pointer}
/* which word caught a blocked post, on its row: the list's whole job is to be
   scanned, so this reads as a tag rather than as more of the post */
.kw{padding:0 7px;border-radius:999px;border:1px solid var(--line);font-size:12px;font-weight:600}
/* the block list, edited in the browser's own modal */
.kwdlg{
  width:min(92vw,460px);padding:16px;color:var(--fg);background:var(--card);
  border:1px solid var(--line);border-radius:14px;font:inherit;
}
.kwdlg::backdrop{background:rgba(0,0,0,.55)}
.kwdlg h2{margin:0 0 6px;font-size:17px;font-weight:700;letter-spacing:-.02em}
.kwdlg .kwhelp{margin:0 0 10px;color:var(--muted);font-size:13px;line-height:1.45}
/* 16px, not the 14px the rest of this dialog is set in: mobile Safari zooms the
   page into any text field it focuses that is set smaller, and the way out of
   that is a readable field, not a viewport that refuses to be pinched */
.kwdlg textarea{
  display:block;width:100%;padding:10px;color:var(--fg);background:var(--bg);
  border:1px solid var(--line);border-radius:10px;resize:vertical;
  font:16px/1.6 ui-monospace,SFMono-Regular,Menlo,monospace;
}
.kwdlg menu{display:flex;justify-content:flex-end;gap:10px;margin:12px 0 0;padding:0}
.kwdlg menu button{
  padding:8px 14px;min-height:40px;cursor:pointer;font:inherit;font-size:14px;font-weight:600;
  color:var(--muted);background:var(--card);border:1px solid var(--line);border-radius:10px;
}
.kwdlg menu button#kwsave{color:var(--accent);border-color:var(--accent)}
.settingrow{display:flex;align-items:center;justify-content:space-between;gap:18px;min-height:44px;font-size:14px;font-weight:600}
.settingrow input{width:20px;height:20px;margin:0;accent-color:var(--accent)}
/* the interest list: a column rather than a row, since a textarea and the help
   above it have nothing to line up against on the right */
.settingcol{display:flex;flex-direction:column;gap:6px;margin-top:16px}
.settingcol>span{font-weight:600}
.settingfoot{display:flex;justify-content:flex-end}
.settingfoot button{font:inherit;padding:4px 12px;border:1px solid var(--line);border-radius:8px;background:var(--card);color:var(--accent);cursor:pointer}
.settingfoot button:disabled{opacity:.5;cursor:default}

/* a setting with more than two states is a row of radios rather than a switch;
   the label sits beside its own dot so a tap anywhere on either picks it */
.radios{display:flex;align-items:center;gap:16px;font-weight:600}
.radios label{display:inline-flex;align-items:center;gap:6px;cursor:pointer}
.radios span{color:var(--muted)}
.radios input:checked+span{color:var(--fg)}
.hid{display:none}
.empty{color:var(--muted);font-style:italic}
.note{padding:16px;color:var(--muted);border:1px dashed var(--line);border-radius:12px;font-size:15px}
.note a{color:var(--accent);font-weight:600;text-decoration:none}
.note.offer{margin-top:10px}
/* The briefing over a source's backlog, in place of the cards it is a briefing
   of: one card-shaped block, since it is one piece of prose about the whole
   pick rather than a row per item. Hiding the feed rather than replacing it
   keeps every card where it was — the scroll position, the players, whatever is
   part-expanded — so coming back is coming back and not a reload. */
.summary{display:none;background:var(--card);border:1px solid var(--line);border-radius:14px;padding:14px 16px}
body.sumon .summary{display:block}
/* the summary chip's own page is nothing but the digest, so it stands in for no
   cards and has nothing to be toggled against */
.summary.digest{display:block}
.smeta{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--muted);flex-wrap:wrap}
/* the briefing has been overtaken: items arrived that it never read. Loud
   enough to catch the eye next to "next", which is what it is telling you to
   do, and gone entirely when there is nothing to say. */
.sold{padding:1px 8px;border:1px solid var(--accent);border-radius:999px;color:var(--accent);font-weight:600}
.sold:empty{display:none}
/* "next" sits under the prose rather than above it: it clears every item the
   summary read, which is what you do once you have read it */
.sfoot{display:flex;justify-content:flex-end;margin-top:14px;padding-top:12px;border-top:1px solid var(--line)}
.sfoot .rest{margin-left:0;font-size:14px}
.summary .body{font-size:15px}
.summary .body h2{margin:18px 0 6px;font-size:16px;font-weight:700}
.summary .body ul,.summary .body ol{margin:8px 0;padding-left:22px}
.summary .body li{margin:4px 0}
/* a cited item wears a label, not a URL: nothing here wants breaking mid-word
   the way a bare link in a post's body does */
.summary .body .link{word-break:normal;text-underline-offset:2px}
/* What the briefing stands in for is hidden while it is open. #markAll is not on
   this list: having read a briefing and decided the items behind it are not worth
   opening, clearing them is the next thing you do, so the button stays where the
   thumb left it. A briefing is only ever of one source, so that is all it clears. */
body.sumon article.card,
body.sumon .deckwrap,
body.sumon #deckNav,
body.sumon #deckEnd,
body.sumon .wrap>.note{display:none}
/* a feed page is fetched before it is sent, so a tap that refetches leaves the
   old page on screen with nothing happening; cover it while the wait runs */
.loading{
  position:fixed;inset:0;z-index:50;display:flex;align-items:center;justify-content:center;
  background:rgba(0,0,0,.5);color:#fff;font-size:15px;font-weight:600;
}
.loading.hid{display:none} /* .hid alone loses to .loading */
.loading span{animation:pulse 1.1s ease-in-out infinite}
@keyframes pulse{0%,100%{opacity:.45}50%{opacity:1}}
@media (prefers-color-scheme: light){
  .loading{background:rgba(246,247,249,.75);color:var(--fg)}
}
.toast{
  position:fixed;left:50%;bottom:calc(18px + env(safe-area-inset-bottom));transform:translateX(-50%);
  background:var(--fg);color:var(--bg);font-size:14px;font-weight:600;
  padding:8px 16px;border-radius:999px;opacity:0;pointer-events:none;transition:opacity .2s;
  z-index:60; /* the deck's floating mark-all sits down here too */
  max-width:min(88vw,380px);text-align:center;line-height:1.35;
}
.yt{position:relative;margin:10px 0 2px;border-radius:12px;overflow:hidden;cursor:pointer;aspect-ratio:16/9;background:#000}
.yt img{width:100%;height:100%;object-fit:cover;display:block;opacity:.85}
.yt .yt-play{
  position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
  font-size:26px;color:#fff;background:rgba(0,0,0,.25);text-shadow:0 1px 8px rgba(0,0,0,.6);
}
.yt-embed{aspect-ratio:16/9;margin:10px 0 2px}
.yt-embed iframe{display:block;width:100%;height:100%;border:0;border-radius:12px}
.yt-blocked{display:block;margin:10px 0 2px;padding:14px;border:1px dashed var(--line);border-radius:12px;color:var(--accent);font-size:14px;font-weight:600;text-decoration:none}
html.ffs-on,html.ffs-on body{overflow-x:hidden;background:#000 !important}
/* guarantee scroll room while rotated: Safari only hides its bars when a swipe
   actually scrolls, and a short or bottomed-out feed otherwise has nowhere to go */
html.ffs-on body{padding-bottom:100lvh}
/* iOS lays out fixed elements against the bars-visible viewport, so the player
   can't cover the status-bar strip or the area around the bottom address bar;
   blank the feed instead so every uncovered edge is seamless black */
html.ffs-on .wrap{visibility:hidden}
.ffs{
  position:fixed !important;top:50vh !important;left:50vw !important;
  top:50lvh !important;left:50lvw !important;
  width:100vh !important;height:100vw !important;
  width:100lvh !important;height:100lvw !important;
  max-height:none !important;margin:0 !important;
  transform:translate(-50%,-50%) rotate(-90deg) !important;transform-origin:center !important;
  border-radius:0 !important;background:#000 !important;
  z-index:2147483646 !important;overflow:hidden !important;
  touch-action:pan-y !important; /* vertical swipes scroll the page, letting mobile Safari hide its bars */
  visibility:visible !important; /* the player lives inside the hidden .wrap */
}
video.ffs{object-fit:cover !important}
.ffs iframe{display:block !important;width:100% !important;height:100% !important;border-radius:0 !important}
.ffs-tap{position:fixed;inset:0;z-index:2147483646;background:transparent;touch-action:manipulation;-webkit-tap-highlight-color:transparent}
.ffs-exit{
  position:fixed;top:max(16px,env(safe-area-inset-top));right:max(16px,env(safe-area-inset-right));
  width:44px;height:44px;border:0;border-radius:50%;padding:0;color:#fff;background:rgba(0,0,0,.65);
  font:24px/44px -apple-system,system-ui,sans-serif;text-align:center;cursor:pointer;
  z-index:2147483647;transform:rotate(-90deg);-webkit-tap-highlight-color:transparent;
}
/* Swipe mode: the feed becomes a deck. One card is on screen at a time, sized
   to the viewport and scrolling inside its own frame, with two empty offset
   cards drawn behind it so the stack reads as "more where that came from". */
/* the deck starts where the chips end, rather than floating in the middle of
   what's left of the screen: centring put a short card a long way down, and
   moved every card as the next one's height changed. Top-aligned, the card's
   top edge stays put across a whole swipe session, and one taller than the
   screen simply scrolls instead of being clipped above the fold. */
.deckwrap{display:flex}
.deckwrap.hid{display:none}
.deckwrap .deck{width:100%;min-width:0}
.deck{position:relative}
.deck::before,.deck::after{
  content:'';position:absolute;left:0;right:0;top:0;bottom:0;
  background:var(--card);border:1px solid var(--line);border-radius:14px;z-index:-1;
}
.deck::before{transform:scale(.97) translateY(10px)}
.deck::after{transform:scale(.94) translateY(20px)}
.deck.last::before,.deck.last::after,.deck.last2::after{display:none}
.deck .card{
  margin-bottom:0;
  -webkit-tap-highlight-color:transparent;
}
.deck .card.read{opacity:1} /* a dealt card leaves the screen; no need to grey it */
.vidbox{position:relative;margin:10px 0 2px}
.vid{display:block;width:100%;max-height:70vh;border-radius:12px;background:#000}
/* a podcast episode: the browser's own audio bar, full width. Unlike video it
   preloads metadata, so the controls can state how long the episode runs before
   a tap starts it — the audio answer to the .vlen badge */
.aud{display:block;width:100%;margin:10px 0 2px}
/* how long the clip runs, over the poster: enough to judge a tap before any of
   it downloads (preload="none" means nothing has yet) */
.vlen{
  position:absolute;top:8px;left:8px;pointer-events:none;
  background:rgba(0,0,0,.72);color:#fff;font-size:12px;font-weight:700;
  padding:2px 7px;border-radius:6px;font-variant-numeric:tabular-nums;
}
</style>
</head><body>
<div id="state" data-savedview="{{if .SavedView}}true{{else}}false{{end}}" data-blockedview="{{if .BlockedView}}true{{else}}false{{end}}" data-skippedview="{{if .SkippedView}}true{{else}}false{{end}}" data-itemview="{{if .ItemView}}true{{else}}false{{end}}" data-swipe="{{if .Swipe}}true{{else}}false{{end}}" data-deckstart="{{.DeckStart}}" data-more="{{if .More}}true{{else}}false{{end}}" data-sel="{{.Sel}}" data-sumlang="{{.SumLang}}" hidden></div>
<div class="wrap">
<header>
  <div class="sub" id="sub">{{if .ItemView}}<a class="viewlink" href="/">unread</a> <span class="viewon">one item</span> <a class="viewlink" href="/?saved=1">saved</a>{{else}}{{if .FeedView}}<button class="settings viewon" id="settingsOpen" type="button" title="{{if .Capped}}settings — a service's backlog runs deeper than the sweep reached{{else}}settings{{end}}">unread</button>{{else}}<a class="viewlink" href="/">unread</a>{{end}} <a class="viewlink{{if .SavedView}} viewon{{end}}" href="/?saved=1">saved</a> <a class="viewlink{{if .SkippedView}} viewon{{end}}" href="/?skipped=1" title="what the sift skipped for you — read them here to check it">skipped</a> <a class="viewlink{{if .BlockedView}} viewon{{end}}" href="/?blocked=1">blocked</a>{{if .BlockedView}} <button class="viewlink" id="kwopen" type="button" title="edit the blocked keywords"><span id="kwn">{{.Keywords}}</span> keywords</button>{{end}}{{end}}</div>
  {{if .SavedModeHref}}<a class="decklink" id="savedmode" href="{{.SavedModeHref}}" title="{{if .SavedCompact}}title-only saved items — tap for full cards{{else}}full saved cards — tap for titles only{{end}}"><span class="dmark">{{if .SavedCompact}}≡{{else}}▤{{end}}</span>{{if .SavedCompact}}compact{{else}}full{{end}}</a>
  {{end}}{{if .ClearBlocked}}<button class="sortlink headbutton" id="clearBlocked" type="button" data-total="{{.Blocked}}" title="delete all stored blocked items">clear</button>
  {{end}}{{if and .HasApps (not .SkippedView)}}<button class="sortlink headbutton" id="siftBtn" type="button" title="every fetch is sifted on its own — this asks typesafe to read whatever is left unjudged now"><span class="sarrow">⚟</span><span id="siftlabel">sift</span></button>
  {{end}}{{if .DeckHref}}<a class="decklink" id="decklink" href="{{.DeckHref}}" title="{{if .Swipe}}a deck, one card at a time — tap for the scrolling list{{else}}a scrolling list — tap for the swipe deck{{end}}"><span class="dmark">{{if .Swipe}}▭{{else}}▤{{end}}</span>{{if .Swipe}}deck{{else}}list{{end}}</a>
  {{end}}{{if .SortHref}}<a class="sortlink" id="sortlink" href="{{.SortHref}}" title="{{.SortTitle}}"><span class="sarrow">{{.SortMark}}</span>{{.SortWord}}</a>
  {{end}}</header>
{{if .Warn}}<div class="warn">⚠ {{.Warn}}</div>
{{end}}{{if or .Filters .TagFilters}}<div class="filters" id="filters">{{range .Filters}}<div class="fgroup">{{range .Chips}}{{if .Summarize}}<span class="fpair">{{end}}<a class="fchip{{if .Hidden}} hid{{end}}" href="{{.Href}}" data-kind="{{.Kind}}" data-key="{{.Key}}" data-on="{{if .On}}1{{else}}0{{end}}"{{if .Title}} title="{{.Title}}"{{end}}>{{if .Color}}<span class="chip" style="background:{{.Color}}">{{.Label}}</span>{{else}}<span>{{.Label}}</span>{{end}}<span class="fn{{if .State}} {{.State}}{{end}}">{{.Count}}{{if .Capped}}+{{end}}</span></a>{{if .Summarize}}<button class="fsum" id="fsum-{{.Key}}" type="button" data-app="{{.Key}}" data-says="{{.Says}}" data-state="idle" title="summarize {{.Says}}'s unread backlog" aria-label="summarize {{.Says}}'s unread backlog"><svg class="fsumi" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.2l1.85 4.45L18.3 9.5l-4.45 1.85L12 15.8l-1.85-4.45L5.7 9.5l4.45-1.85z"/><path d="M18.1 15.1l.78 1.87 1.87.78-1.87.78-.78 1.87-.78-1.87-1.87-.78 1.87-.78z"/></svg><span class="fspin" aria-hidden="true"></span></button></span>{{end}}{{end}}</div>{{end}}{{if and .Filters .TagFilters}}<span class="filtersep">|</span>{{end}}{{if .TagFilters}}<span class="fgroup tagfilters" id="tagfilters">{{range .TagFilters}}<a class="fchip{{if .Hidden}} hid{{end}}" href="{{.Href}}" data-kind="tag" data-key="{{.Key}}" data-on="{{if .On}}1{{else}}0{{end}}"><span>{{.Label}}</span><span class="fn">{{.Count}}</span></a>{{end}}</span>{{end}}</div>
{{end}}{{if .Subs}}<div class="filters subs" id="subs">{{range .Subs}}<a class="fchip" href="{{.Href}}" data-kind="sub" data-key="{{.Key}}" data-on="{{if .On}}1{{else}}0{{end}}" title="{{.Title}}"><span class="slabel">{{.Label}}</span><span class="fn">{{.Count}}</span></a>{{end}}<button class="fchip fmore hid" id="fmore" type="button" title="show the rest of them">more</button></div>
{{end}}{{if .SummaryApp}}<div class="summary" id="summary" data-app="{{.SummaryApp}}" data-open="{{if .SummaryOpen}}1{{else}}0{{end}}"></div>
{{end}}{{if .BlockedView}}{{if not .Cards}}<div class="note">{{if .Sel}}Nothing blocked from that chip.{{else}}Nothing blocked yet. Add a <b>keyword</b> and any post whose title carries it is kept out of the feed and filed here instead.{{end}}</div>
{{end}}{{else if .SavedView}}{{if not .Cards}}<div class="note">{{if or .Sel .TagSelected}}Nothing saved from that chip.{{else}}Nothing saved yet. Tap <b>save</b> on any item to keep it here.{{end}}</div>
{{end}}{{else if .SkippedView}}{{if not .Cards}}<div class="note">{{if .Sel}}Nothing set aside from that chip.{{else}}Nothing set aside. Every fetch is sifted as it lands, and what the model thinks you can skip shows up here, to be read anyway or cleared in one go.{{end}}</div>
{{end}}{{else if .DigestView}}{{with .Digest}}<div class="summary digest" id="digest" data-id="{{.ID}}" data-gen="{{.Stamp}}" data-running="{{if .Running}}1{{else}}0{{end}}"><div class="smeta">{{.Count}} unread items{{if .When}}, summarized {{.When}}{{end}}{{if gt .Waiting 1}}<span class="sold" title="summaries waiting behind this one">{{.Waiting}} waiting</span>{{end}}<button class="rest" id="digretry" type="button" title="write this summary again over the same items">retry</button></div><div class="body">{{.HTML}}</div><div class="sfoot"><button class="rest" id="dignext" type="button" title="mark every item this read as read, and show the next summary">next</button></div></div>
{{else}}<div class="note" id="dignote" data-running="{{if .DigestRunning}}1{{else}}0{{end}}">{{if .DigestRunning}}Reading the backlog — this takes a minute or two.{{else}}No summary waiting. Every fetch summarizes the next couple of hundred unread items and leaves the briefing here.{{end}}</div>
{{end}}{{else if .ItemView}}{{else if not .HasApps}}<div class="note">No reader app is logged in. Run <code>tui &lt;app&gt; --auth</code> on the host, then refresh this page.</div>
{{else if not .Cards}}<div class="note">{{if .Sel}}Nothing unread from that chip.{{else}}Inbox zero across every timeline.{{end}}</div>
{{end}}{{if and .Swipe .Cards}}<div class="deckwrap"><div class="deck" id="deck">{{range .Cards}}{{template "card" .}}
{{end}}</div></div>
<div class="note hid" id="deckEnd">Deck's empty — that's every card.</div>
{{else}}{{range .Cards}}{{template "card" .}}
{{end}}{{end}}{{if and .Swipe .Cards}}<div id="deckNav" class="deckctl"><button id="deckPrev" class="deckbtn" type="button" title="mark unread and show the previous item" aria-label="previous item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5L8 12L15 19"/></svg></button><button id="deckNext" class="deckbtn" type="button" title="mark read and show the next item" aria-label="next item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5L16 12L9 19"/></svg></button></div>
{{end}}{{if and .Cards .BulkMark}}<button id="markAll" class="markall{{if .Swipe}} fab{{end}}" type="button" data-total="{{.Total}}"{{if .Swipe}} title="mark all {{.Total}} items in this feed read"{{end}}>{{if .Swipe}}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5L10 17.5L19 6.5"/></svg>{{else}}✓ mark all {{.Total}} read{{end}}</button>
{{end}}{{if .HasApps}}<dialog id="settingsdlg" class="kwdlg settingsdlg"><form method="dialog"><h2>settings</h2><label class="settingrow"><span>place deck card controls on left</span><input id="controlsLeft" type="checkbox"></label><label class="settingrow"><span>start every player muted</span><input id="muteDefault" type="checkbox"></label><div class="settingrow"><span>summarize in</span><span class="radios" id="sumLang"><label><input type="radio" name="sumlang" value="en"><span>English</span></label><label><input type="radio" name="sumlang" value="zh"><span>中文</span></label></span></div><div class="settingcol"><span>what you are following right now</span><textarea id="intext" rows="6" placeholder="one subject per line, in your own words&#10;the Fed&#39;s rate path&#10;anything about Zig" spellcheck="false" autocapitalize="none" autocorrect="off" autocomplete="off">{{.Interests}}</textarea><div class="settingfoot"><button id="insave" type="button">save</button></div></div>{{if .Updated}}<div class="settingnote">last fetch: <span id="upd">{{if .Fetching}}happening now{{else}}{{.Updated}}{{end}}</span>{{if .Capped}} · a service's backlog runs deeper than the sweep reached, so the count is short of the truth{{end}}</div>{{end}}<menu><button value="done">done</button></menu></form></dialog>
{{end}}{{if .BlockedView}}<dialog id="kwdlg" class="kwdlg"><form method="dialog"><h2>blocked keywords</h2><p class="kwhelp">One per line. A post whose <b>title</b> carries one of these — anywhere in it, upper or lower case — is kept out of the feed and filed here instead. A post with no title of its own (an x post) is never blocked. Saving also clears whatever the words catch in the backlog you already have.</p><textarea id="kwtext" rows="10" spellcheck="false" autocapitalize="none" autocorrect="off" autocomplete="off">{{.KeywordText}}</textarea><menu><button value="cancel">cancel</button><button id="kwsave" value="save">save</button></menu></form></dialog>
{{end}}<div id="toast" class="toast"></div>
<div id="loading" class="loading hid"><span>loading…</span></div>
<script>
// ?deck=1 serves the same cards as a deck: one on screen, thrown away by hand.
// Everything else on the page (video, images, save, share, expand) is shared
// between the two modes; only the layout and what marks a card read differ.
var SWIPE = document.getElementById('state').getAttribute('data-swipe') === 'true';
var MORE = document.getElementById('state').getAttribute('data-more') === 'true';
// How many cards at the head of the deck are ones you have already read. The
// deck starts past them, so they are only ever reached by walking back — which
// is the point: a deck that ran out and reloaded for the next window would
// otherwise have thrown away everything behind you.
var DECK_START = parseInt(document.getElementById('state').getAttribute('data-deckstart'), 10) || 0;
// Which chip the page is narrowed to ("app:reddit", "gist:gist"), blank for the
// whole list: a pick is a page load, so this is settled by the time anything
// here runs.
var SEL = document.getElementById('state').getAttribute('data-sel') || '';
// Set means the deck's arrows take the left edge instead of the right.
var CONTROLS_LEFT = false;
try { CONTROLS_LEFT = localStorage.getItem('tui:deck-controls-left') === '1'; } catch(e){}
// Which language a briefing is asked for in. The server holds this one, unlike
// the layout choices around it: the summaries a fetch writes by itself are
// written without a page open to ask, so the setting has to live somewhere a
// fetch can read — and having done that, it is the one setting that is the same
// on your phone and your desktop. Every page adopts what the server says; what
// is in localStorage is a cache, for the views that carry no answer (the saved
// and blocked lists, an item on its own page).
var SUM_LANG = 'en';
try {
  var langHeld = localStorage.getItem('tui:summary-lang');
  if (langHeld === 'zh' || langHeld === 'en') SUM_LANG = langHeld;
} catch(e){}
var SUM_LANG_SAID = document.getElementById('state').getAttribute('data-sumlang') || '';
if (SUM_LANG_SAID === 'zh' || SUM_LANG_SAID === 'en'){
  SUM_LANG = SUM_LANG_SAID;
  try { localStorage.setItem('tui:summary-lang', SUM_LANG); } catch(e){}
}
var SAVED_TAGS = {{.SavedTags}};
var TAG_OPTIONS = {{.TagOptions}};
// The gist pile (?gist=1): the items whose discussion you asked for. It is not
// a slice of the feed but a pile taken out of it, so the header's unread and the
// source chips have already let these go, and reading one here moves the gist
// chip alone.
var GIST_PILE = SEL === 'gist:gist';
var SAVED_VIEW = document.getElementById('state').getAttribute('data-savedview') === 'true';
// The blocked list: rows the feed never carried, so nothing here is unread, and
// each one is a title alone rather than a card to play or expand.
var BLOCKED_VIEW = document.getElementById('state').getAttribute('data-blockedview') === 'true';
// The skipped pile: a feed like any other as far as this page is concerned —
// cards, the deck, mark-all — except that what put the items here was a model
// rather than a keyword, and reading one is how that gets checked.
var SKIPPED_VIEW = document.getElementById('state').getAttribute('data-skippedview') === 'true';
// One item on its own URL: a card with no list around it. Reached by being sent
// the link rather than by working through the feed, so nothing on it is read by
// having been looked at.
var ITEM_VIEW = document.getElementById('state').getAttribute('data-itemview') === 'true';
// Set while the briefing is up in place of the cards. The cards are still on the
// page, hidden, and a hidden card must not count as one you scrolled past.
var SUMMARY_ON = false;
// ...and what it read, while it is up: the key its job is filed under and how
// many items it covered. Mark-all follows it rather than the pick, since the
// whole feed's briefing is capped and the pick behind it can hold items it never
// mentioned. Null whenever no briefing is up.
var BRIEF = null;
// Which end of the feed this page is reading from. It rides with an ask for a
// briefing, because a capped one is taken from the end you are reading.
var FEED_ASC = {{if .Asc}}true{{else}}false{{end}};
// Reading = scrolling: the moment a card is fully off-screen (its bottom edge
// clears the top of the viewport) it is marked read and muted in place — it
// stays in the list, greyed, so scrolling back up shows what you've read.
// Marks are batched per app so a fast scroll is one --mark-read call per app.
var pending = {};   // app -> ids marked read, awaiting a flush
var flushTimer = null;
var markFlights = Promise.resolve();
// /mark only writes the server's cache, so it answers at once. A request that
// hangs instead is the same trouble as one that is refused, and quieter about
// it, so cap the wait — a failure has to be noticed either way.
function markFetch(fd){
  var o = {method:'POST', body:fd};
  if(window.AbortSignal && AbortSignal.timeout) o.signal = AbortSignal.timeout(15000);
  return fetch('/mark', o);
}
// Returns when every mark it sent has landed, so a caller that is about to
// throw the page away (clearing the filters reloads) can wait for it first.
function flushPending(){
  flushTimer = null;
  var apps = Object.keys(pending);
  var dirty = apps.some(function(a){ return pending[a].length > 0; });
  if(!dirty) return markFlights;
  var calls = [], failed = false;
  apps.forEach(function(app){
    var ids = pending[app]; if(!ids.length) return;
    pending[app] = [];
    var fd = new FormData(); fd.append('app', app); fd.append('json','1');
    ids.forEach(function(id){ fd.append('id', id); });
    calls.push(markFetch(fd)
      .then(function(res){ return res.json(); })
      .then(function(d){ if(!d.ok) throw 0; decFeedCount(ids.length); decBulkCount(ids.length); retried = false; })
      // Put them back rather than dropping them, so the retry has something to
      // send and the queue stays the honest record of what the server has not
      // heard about.
      .catch(function(){ pending[app] = ids.concat(pending[app]); failed = true; }));
  });
  var flight = Promise.all(calls).then(function(){ if(failed) resync(); });
  markFlights = Promise.all([markFlights, flight]).then(function(){}, function(){});
  return flight;
}
// The queue waits 400ms for company, so a refresh or a closed tab inside that
// window would take the last few reads with it — the cards come back unread and
// you read them again. A beacon outlives the page, which a fetch does not, so
// send whatever is in hand; there is nobody left to hear a failure, and the next
// load is the honest record either way.
window.addEventListener('pagehide', function(){
  Object.keys(pending).forEach(function(app){
    var ids = pending[app]; if(!ids.length) return;
    pending[app] = [];
    var fd = new FormData(); fd.append('app', app); fd.append('json','1');
    ids.forEach(function(id){ fd.append('id', id); });
    if(navigator.sendBeacon) navigator.sendBeacon('/mark', fd);
    else markFetch(fd).catch(function(){});
  });
});
// Leaving this page for another of ours: whatever marks are still queued go
// first, because leaving is exactly when one that hasn't reached the server
// would be lost. The cover goes up as the tap lands, since the wait is the
// flush plus whatever the next page costs to build.
function leaveFor(href){
  document.getElementById('loading').classList.remove('hid');
  if (flushTimer) clearTimeout(flushTimer);
  flushPending().then(function(){ location.assign(href); });
}
// A mark the server never took leaves the page lying to you: those cards are
// greyed and off the counts over a state the server does not have, and swiping
// on only widens the gap. One retry covers a blip — a dropped packet, a phone
// waking up — because throwing the deck away for that would be its own
// annoyance. Past that, the page is beyond repairing in place, so reload: what
// comes back is what the server actually has. Reads that never landed return
// unread, which is the truth, and if the server really is gone the browser says
// so more plainly than this page could.
var retried = false;
function resync(){
  if(!retried){
    retried = true;
    if(!flushTimer) flushTimer = setTimeout(flushPending, 1500);
    return;
  }
  try { sessionStorage.setItem('tui:resync', '1'); } catch(e){}
  location.reload();
}
// Takes n off the header's unread count; a negative n hands them back, which is
// what a mark that failed after the count already moved has to do.
function decCount(n){
  // The skipped view has no count of its own to take down — you are in the
  // pile, and mark-all's own label is what says how deep it is.
  var s = document.getElementById('unreadn'); if(!s) return;
  var c = (parseInt(s.textContent, 10) || 0) - n; if(c < 0) c = 0;
  s.textContent = c;
}
// What mark-all is about to clear, in words. A briefing is of one source's
// backlog, so while one is open the button and its confirm name that source
// rather than the vaguer "this feed" — clearing it must not read as clearing
// everything unread.
function markAllScope(){
  if (SKIPPED_VIEW) return ' the sift set aside';
  var app = new URLSearchParams(location.search).get('app') || '';
  return SUMMARY_ON && app ? ' in ' + app : ' in this feed';
}
// How many the button is about to clear: under a briefing, the items that
// briefing read, which is not the pick behind it once the whole feed's cap has
// bitten. Everywhere else, the pick the server counted.
function markAllCount(){
  var b = document.getElementById('markAll');
  if(BRIEF) return BRIEF.count;
  return b ? (parseInt(b.dataset.total, 10) || 0) : 0;
}
function labelMarkAll(){
  var b = document.getElementById('markAll');
  if(!b) return;
  var total = markAllCount();
  if(BRIEF){
    var says = 'mark the ' + total + (total === 1 ? ' item' : ' items') + ' this briefing read as read';
    if(SWIPE) b.title = says;
    else b.textContent = "✓ mark the briefing's " + total + " read";
    b.title = says;
    return;
  }
  b.title = 'mark all ' + total + ' items' + markAllScope() + ' read';
  if(!SWIPE) b.textContent = '✓ mark all ' + total + ' read';
}
// The gist pile is not in the header's unread: asking for a discussion took the
// item out of the feed that number counts. Reading one out of the chip moves the
// chip, not the header.
function decFeedCount(n){ if (!GIST_PILE) decCount(n); }
function decBulkCount(n){
  var b = document.getElementById('markAll');
  if(!b) return;
  b.dataset.total = Math.max(0, (parseInt(b.dataset.total, 10) || 0) - n);
  labelMarkAll();
}
// A chip's number is what picking it would bring, so reading takes it down with
// the header's. Debounced: a fast scroll marks cards faster than there is any
// point recounting.
var recountTimer = null;
function scheduleRecount(){
  if(recountTimer) return;
  recountTimer = setTimeout(recountChips, 150);
}
// What the server said each chip holds, kept before anything writes over it.
(function(){
  document.querySelectorAll('#filters .fchip[data-kind], #subs .fchip[data-kind]').forEach(function(chip){
    var n = chip.querySelector('.fn');
    if(n) chip.dataset.n0 = n.textContent;
  });
})();
function recountChips(){
  recountTimer = null;
  // One bucket per chip axis, keyed the way that axis's chips are: the sift's
  // rungs and "for me" are counts of the same cards as the source and type
  // chips, so reading an item has to come off all of them at once.
  var gone = {app:{}, type:{}, sub:{}, rank:{}, mine:{}, gist:{}, all:0};
  // The deck's history cards are excluded for good, not just while they carry
  // the class: they were counted out of the chips when they were first read, and
  // walking back onto one and forward again must not count it out twice.
  document.querySelectorAll('article.card.read:not([data-history])').forEach(function(c){
    // The gist pile is the one axis that is not a slice of the feed: asking for
    // a discussion took the item out of what the source and type chips count.
    // Reading it here comes off the gist chip and off nothing else.
    if(GIST_PILE){
      gone.gist.gist = (gone.gist.gist || 0) + 1;
      return;
    }
    gone.all++;
    gone.app[c.dataset.app] = (gone.app[c.dataset.app] || 0) + 1;
    gone.type[c.dataset.type] = (gone.type[c.dataset.type] || 0) + 1;
    if(c.dataset.sub) gone.sub[c.dataset.sub] = (gone.sub[c.dataset.sub] || 0) + 1;
    ['rank','mine'].forEach(function(k){
      var key = c.dataset[k];
      if(key) gone[k][key] = (gone[k][key] || 0) + 1;
    });
  });
  // ...and the other direction: a card you have just asked a discussion of has
  // this moment joined the pile, so the chip goes up by one and shows itself.
  var aside = document.querySelectorAll('article.card[data-gisting]').length;
  document.querySelectorAll('#filters .fchip[data-kind], #subs .fchip[data-kind]').forEach(function(chip){
    var n = chip.querySelector('.fn'), base = parseInt(chip.dataset.n0, 10);
    if(!n || isNaN(base)) return;
    var group = gone[chip.dataset.kind];
    // The whole feed's chip and For You's both count every card on the page:
    // one because it stands for all of them, the other because its page is
    // nothing else.
    var whole = chip.dataset.kind === 'x' || chip.dataset.kind === 'all';
    var off = whole ? gone.all : (group && group[chip.dataset.key] || 0);
    var count = Math.max(0, base - off + (chip.dataset.kind === 'gist' ? aside : 0));
    n.textContent = count;
    if(chip.dataset.kind === 'gist') chip.classList.toggle('hid', count === 0);
  });
}
function toast(m){ var t=document.getElementById('toast'); t.textContent=m; t.style.opacity='1'; setTimeout(function(){t.style.opacity='0'},1200); }
// A page that reloads itself under you is startling; say once, in passing, why.
// Nothing to act on — the reload was the fix — so it fades like any other note.
try {
  if(sessionStorage.getItem('tui:resync')){
    sessionStorage.removeItem('tui:resync');
    toast("reloaded: the server didn't take some reads");
  }
} catch(e){}
// queueRead marks one card read: muted in place and batched for the next flush.
function queueRead(el){
  if(el.classList.contains('read')) return false;  // already counted once
  // A card whose discussion is still being read is not one to mark read on the
  // way past. Asking for the thread is asking to come back to it, and the gist
  // chip is where it waits until there is something to come back to.
  var g = el.querySelector(':scope > .footer > button.gist');
  if(g && g.dataset.state === 'running') return false;
  var app = el.dataset.app, id = el.dataset.id;
  if(!app || !id) return false;
  el.classList.add('read');
  (pending[app] = pending[app] || []).push(id);
  if(!flushTimer) flushTimer = setTimeout(flushPending, 400);
  scheduleRecount();
  return true;
}
function queueUnread(el){
  var app = el.dataset.app, id = el.dataset.id;
  if(!app || !id) return Promise.resolve();
  var ids = pending[app] || [];
  pending[app] = ids.filter(function(q){ return q !== id; });
  return markFlights.then(function(){
    var fd = new FormData(); fd.append('app', app); fd.append('id', id);
    return fetch('/unmark', {method:'POST', body:fd})
      .then(function(res){ return res.json(); })
      .then(function(d){
        if(!d.ok) throw 0;
        el.classList.remove('read');
        if(d.changed){ decFeedCount(-1); decBulkCount(-1); }
        scheduleRecount();
      });
  }).catch(function(){ toast('could not mark unread'); });
}
var obs = new IntersectionObserver(function(entries){
  if (ffs) return; // fake fullscreen scrolls the feed behind the video (hiding
                   // Safari's bars); that motion must not mark cards read
  if (SUMMARY_ON) return; // nor does the feed collapsing behind the briefing
  entries.forEach(function(en){
    var el = en.target;
    // On screen: whatever it was before, it has now been in front of you, so
    // scrolling past it from here is a read.
    if(en.isIntersecting){ delete el.dataset.behind; return; }
    // Above the viewport since the page arrived and never seen since. The head
    // script asks the browser not to restore a scroll offset, but a browser
    // that restores one anyway (or an anchor, or a back button) must not turn
    // the whole list above it into reads: nobody scrolled past these.
    if(el.dataset.behind) return;
    var r = el.getBoundingClientRect();
    if(r.height === 0 && r.top === 0) return;
    if(r.bottom > 0) return;                      // below, not yet scrolled past
    queueRead(el);
  });
},{threshold:0});
// Exempt every card that is above the viewport right now: whatever put the page
// here, it wasn't you scrolling through them on this page.
function exemptBehind(){
  document.querySelectorAll('article.card:not(.read)').forEach(function(c){
    if (c.getBoundingClientRect().bottom <= 0) c.dataset.behind = '1';
  });
}
// The saved list is for re-reading, the blocked one for looking over, and a
// single item's page is a link somebody followed, so scrolling through any of
// them must not mark anything read; in swipe mode the throw does the marking,
// not the scroll.
if (!SWIPE && !SAVED_VIEW && !BLOCKED_VIEW && !ITEM_VIEW) {
  exemptBehind();
  document.querySelectorAll('article.card').forEach(function(c){ obs.observe(c); });
  // A restore can also land after this script has run, and it arrives as a
  // scroll event like any other. One that jumps a whole screen or more before
  // you have touched anything is the browser's, not yours, so what it leaves
  // above the viewport is exempt too. Only ever the first one: past that, a
  // jump that size is you dragging the scrollbar, which does read.
  var gestured = false;
  ['wheel', 'touchstart', 'keydown'].forEach(function(ev){
    window.addEventListener(ev, function(){ gestured = true; }, {passive:true});
  });
  var from = window.scrollY || 0;
  var onFirstScroll = function(){
    window.removeEventListener('scroll', onFirstScroll);
    if (!gestured && (window.scrollY || 0) - from >= window.innerHeight) exemptBehind();
  };
  window.addEventListener('scroll', onFirstScroll);
}

// Save / unsave one item. The button posts just app+id; the server pairs that
// with the item it last rendered and persists the whole thing, so a saved item
// survives the feed moving on.
function setSaved(card, on){
  var b = card.querySelector('button.save');
  var fd = new FormData();
  fd.append('app', card.dataset.app);
  fd.append('id', card.dataset.id);
  fd.append('save', on ? '1' : '0');
  if (b) b.disabled = true;
  return fetch('/save', {method:'POST', body:fd})
    .then(function(res){ if(!res.ok) throw new Error(res.status === 409 ? 'reload the page and try again' : 'could not save'); return res.json(); })
    .then(function(d){
      if (b){ b.dataset.saved = on ? '1' : '0'; b.textContent = on ? 'saved' : 'save'; }
      var n = document.getElementById('savedn');
      if (n) n.textContent = d.saved;
    })
    .catch(function(err){ toast(err.message || 'could not save'); })
    .then(function(){ if (b) b.disabled = false; });
}
document.addEventListener('click', function(e){
  var b = e.target.closest ? e.target.closest('button.save') : null;
  if (!b) return;
  setSaved(b.closest('article.card'), b.dataset.saved !== '1');
});

if(SAVED_VIEW) document.querySelectorAll('article.card').forEach(function(card){
  var footer = card.querySelector(':scope > .footer');
  if(!footer) return;
  var key = card.dataset.app + '\u0000' + card.dataset.id;
  var selected = SAVED_TAGS[key] || [];
  var row = document.createElement('div');
  row.className = 'tagrow';
  TAG_OPTIONS.forEach(function(tag){
    var button = document.createElement('button');
    button.className = 'itemtag';
    button.type = 'button';
    button.dataset.tag = tag;
    button.dataset.on = selected.indexOf(tag) >= 0 ? '1' : '0';
    button.setAttribute('aria-pressed', button.dataset.on === '1' ? 'true' : 'false');
    button.textContent = tag;
    row.appendChild(button);
  });
  footer.insertAdjacentElement('afterend', row);
});

function adjustTagCount(tag, amount){
  var chip = document.querySelector('#tagfilters a[data-key="' + tag + '"]');
  if(!chip) return;
  var count = chip.querySelector('.fn');
  var next = Math.max(0, (parseInt(count.textContent, 10) || 0) + amount);
  count.textContent = next;
  chip.classList.toggle('hid', next === 0 && chip.dataset.on !== '1');
}
document.addEventListener('click', function(e){
  var button = e.target.closest ? e.target.closest('button.itemtag') : null;
  if(!button) return;
  var card = button.closest('article.card');
  var row = button.closest('.tagrow');
  var before = row.querySelectorAll('button.itemtag[data-on="1"]').length;
  var on = button.dataset.on !== '1';
  var fd = new FormData();
  fd.append('app', card.dataset.app);
  fd.append('id', card.dataset.id);
  fd.append('tag', button.dataset.tag);
  fd.append('on', on ? '1' : '0');
  button.disabled = true;
  fetch('/tags', {method:'POST', body:fd})
    .then(function(res){ if(!res.ok) throw new Error(res.status === 409 ? 'item is no longer saved' : 'could not update tag'); return res.json(); })
    .then(function(d){
      button.dataset.on = d.on ? '1' : '0';
      button.setAttribute('aria-pressed', d.on ? 'true' : 'false');
      adjustTagCount(d.tag, d.on ? 1 : -1);
      if(before === 0 && d.on) adjustTagCount('untagged', -1);
      if(before === 1 && !d.on) adjustTagCount('untagged', 1);
      var active = document.querySelector('#tagfilters a[data-on="1"]');
      if(active && ((active.dataset.key === d.tag && !d.on) || (active.dataset.key === 'untagged' && before === 0 && d.on))){
        location.reload();
      }
    })
    .catch(function(err){ toast(err.message || 'could not update tag'); })
    .then(function(){ button.disabled = false; });
});

// Share hands the item's own text (not its quoted post's) to the OS share
// sheet. navigator.share needs a secure context, which a LAN http:// page is
// not, so the same text is copied to the clipboard there instead — the button
// always does something.
function sharePayload(card){
  var title = card.querySelector(':scope > .preview > .ctitle');
  var body = card.querySelector(':scope > .full > .body');   // full, so no clip and no word-count badge
  var link = card.querySelector(':scope > .footer > a.open[target]');
  var parts = [];
  if (title) parts.push(title.textContent.trim());
  if (body) parts.push(body.textContent.trim());
  var d = {text: parts.join('\n\n')};
  if (title) d.title = title.textContent.trim();
  if (link) d.url = link.href;
  return d;
}
function copyText(t){
  if (navigator.clipboard && navigator.clipboard.writeText) return navigator.clipboard.writeText(t);
  return new Promise(function(res, rej){
    var ta = document.createElement('textarea');
    ta.value = t; ta.setAttribute('readonly',''); ta.style.position = 'fixed'; ta.style.opacity = '0';
    document.body.appendChild(ta); ta.select();
    var ok = document.execCommand && document.execCommand('copy');
    ta.remove();
    ok ? res() : rej(new Error('copy failed'));
  });
}
document.addEventListener('click', function(e){
  var b = e.target.closest ? e.target.closest('button.share') : null;
  if (!b) return;
  var d = sharePayload(b.closest('article.card'));
  if (!d.text && !d.url) { toast('nothing to share'); return; }
  if (navigator.share){
    navigator.share(d).catch(function(err){
      if (err && err.name === 'AbortError') return; // sheet dismissed, not a failure
      toast('could not share');
    });
    return;
  }
  copyText([d.text, d.url].filter(Boolean).join('\n\n'))
    .then(function(){ toast('copied'); })
    .catch(function(){ toast('could not share'); });
});

// Attached stills render only when asked for: the footer's image toggle reveals
// every image block on the card (the post's own and its quoted post's) and
// swaps data-src to src the first time, so an unopened card downloads nothing.
document.addEventListener('click', function(e){
  var b = e.target.closest ? e.target.closest('button.img') : null;
  if (!b) return;
  var on = b.dataset.on !== '1';
  b.closest('article.card').querySelectorAll('.imgbox').forEach(function(box){
    box.classList.toggle('hid', !on);
    if (!on) return;
    box.querySelectorAll('img[data-src]').forEach(function(img){
      img.src = img.dataset.src;
      img.removeAttribute('data-src');
    });
  });
  b.dataset.on = on ? '1' : '0';
});

// The speed/mute/rotate toggles are server-rendered only for the players the
// server knew about; a player that arrives later — a YouTube embed, a resolved
// redgifs clip — needs the same footer controls added by hand. A card whose
// audio player already brought the speed button needs only the rest.
function addPlayerControls(foot){
  var ex = foot.querySelector('button.expand'); // null appends, which is the same place
  if (!foot.querySelector('button.speed')){
    var sp = document.createElement('button'); sp.type = 'button'; sp.className = 'speed'; sp.title = 'playback speed for every player';
    foot.insertBefore(sp, ex);
  }
  if (!foot.querySelector('button.rot')){
    var mu = document.createElement('button'); mu.type = 'button'; mu.className = 'mute'; mu.title = 'sound for this item';
    var ro = document.createElement('button'); ro.type = 'button'; ro.className = 'rot'; ro.title = 'rotated fullscreen'; ro.textContent = 'rotate';
    foot.insertBefore(mu, ex); foot.insertBefore(ro, ex);
  }
  if (!foot.querySelector('button.loop')){
    var lo = document.createElement('button'); lo.type = 'button'; lo.className = 'loop'; lo.title = 'repeat every video'; lo.dataset.on = '0';
    foot.insertBefore(lo, ex); // last of the actions, as the server renders it
  }
}

// YouTube links get an inline click-to-play embed: a lazy thumbnail per video
// that swaps on tap to the official IFrame-API player, so the global speed and
// mute toggles drive it too. Embedding is the owner's call — when it's
// disabled (error 101/150) no embed can play the video, so the player is
// swapped for a watch-on-YouTube link instead of a dead black frame.
var ytPlayers = [];
var ytApiRequested = false;
function ytApi(cb){
  if (window.YT && window.YT.Player){ cb(); return; }
  if (!ytApiRequested){
    ytApiRequested = true;
    var s = document.createElement('script');
    s.src = 'https://www.youtube.com/iframe_api';
    document.head.appendChild(s);
  }
  var wait = setInterval(function(){
    if (window.YT && window.YT.Player){ clearInterval(wait); cb(); }
  }, 100);
}
function ytId(href){
  var m = href.match(/(?:youtube\.com\/watch\?[^#]*v=|youtu\.be\/|youtube\.com\/shorts\/|youtube\.com\/embed\/)([\w-]{11})/);
  return m ? m[1] : null;
}
// The length badge a native video renders server-side: YouTube states it
// nowhere the page can read, so the server looks it up and the badge lands on
// the thumbnail when the answer arrives. A tap before then just plays it.
function ytLen(thumb, id){
  fetch('/ytlen?v=' + encodeURIComponent(id))
    .then(function(res){ return res.json(); })
    .then(function(d){
      if (!d.len) return;
      var s = document.createElement('span');
      s.className = 'vlen';
      s.textContent = d.len;
      thumb.appendChild(s);
    })
    .catch(function(){}); // no badge is fine; it is a hint, not the content
}
function ytPlay(thumb, id){
  var card = thumb.closest('article.card');
  var wrap = document.createElement('div');
  wrap.className = 'yt-embed';
  var target = document.createElement('div');
  wrap.appendChild(target);
  thumb.replaceWith(wrap);
  ytApi(function(){
    var pending = true;
    var poll = null;
    // Where this one was left off, asked for as the player is built: `start` is
    // YouTube's own resume point, honored before the first frame, where a
    // seekTo() from onReady races the player's own loading.
    var at = ytResumeAt(card, id);
    var vars = {autoplay: 1, playsinline: 1, origin: location.origin};
    if (at) vars.start = Math.floor(at);
    var p = new YT.Player(target, {
      videoId: id,
      host: 'https://www.youtube-nocookie.com',
      playerVars: vars,
      events: {
        onReady: function(e){
          e.target.setPlaybackRate(ytRate());
          if (MUTED) e.target.mute(); else e.target.unMute();
          e.target._posSent = at; // already where the server has it
          e.target.playVideo();
        },
        onStateChange: function(e){
          if (e.data === YT.PlayerState.PLAYING && pending){
            e.target.setPlaybackRate(ytRate()); // loading resets the rate
            pending = false;
          }
          // An embed has no timeupdate to hang the position report on, so it is
          // polled while playing and taken once more when it stops.
          if (e.data === YT.PlayerState.PLAYING){
            if (!poll) poll = setInterval(function(){ ytSavePos(card, p, id); }, POS_EVERY * 1000);
          } else {
            clearInterval(poll); poll = null;
            if (e.data === YT.PlayerState.PAUSED || e.data === YT.PlayerState.ENDED) ytSavePos(card, e.target, id);
          }
          if (e.data === YT.PlayerState.ENDED && LOOP) e.target.playVideo(); // an embed has no loop attribute
        },
        onError: function(){
          var a = document.createElement('a');
          a.className = 'yt-blocked';
          a.href = 'https://www.youtube.com/watch?v=' + id;
          a.target = '_blank'; a.rel = 'noopener';
          a.textContent = 'embedding disabled — watch on YouTube ↗';
          wrap.replaceWith(a);
          ytPlayers = ytPlayers.filter(function(q){ return q !== p; });
        }
      }
    });
    ytPlayers.push(p);
    p._posCard = card; p._posId = id; // so a closing page can report this one too
    wrap._ytPlayer = p; // fake fullscreen finds the player via its wrapper
  });
}
function ytThumb(card, id){
  var d = document.createElement('div');
  d.className = 'yt';
  var img = document.createElement('img');
  img.src = 'https://i.ytimg.com/vi/' + id + '/hqdefault.jpg';
  img.alt = ''; img.loading = 'lazy';
  var play = document.createElement('span');
  play.className = 'yt-play'; play.textContent = '▶';
  d.appendChild(img); d.appendChild(play);
  ytLen(d, id);
  d.addEventListener('click', function(){ ytPlay(d, id); });
  var foot = card.querySelector('.footer');
  foot.before(d);
  // No save button: YouTube doesn't hand out direct streams the way
  // video.twimg.com does.
  addPlayerControls(foot);
}
// Not on the blocked list: a row there is a title and a link out, and growing a
// player under it would undo the whole point of the row being one line.
if (!BLOCKED_VIEW) document.querySelectorAll('article.card').forEach(function(card){
  var seen = {};
  // The video the server says the card is about, which a link post carries
  // nowhere the card draws it: a reddit post to YouTube is a title, a thumbnail
  // and an open link to the comments, with the video itself in none of them.
  var own = card.dataset.yt;
  if (own){ seen[own] = true; ytThumb(card, own); }
  card.querySelectorAll('a[href]').forEach(function(a){
    var id = ytId(a.href); if(!id || seen[id]) return; seen[id] = true;
    ytThumb(card, id);
  });
});

// A redgifs post is a link post: nothing on the card plays, and the mp4 hides
// behind an id casing only redgifs' API knows. The footer's video button asks
// the server for it, so a card nobody taps costs nothing, and then stays on as
// a show/hide toggle like the image one — the clip is resolved once, and a
// second tap puts the card back the way it was.
document.addEventListener('click', function(e){
  var b = e.target.closest ? e.target.closest('button.rgv') : null;
  if (!b || b.disabled) return;
  var card = b.closest('article.card');
  var shown = card.querySelector('.rgvbox');
  if (shown){
    var on = b.dataset.on !== '1';
    shown.classList.toggle('hid', !on);
    if (!on) shown.querySelector('video').pause();
    b.dataset.on = on ? '1' : '0';
    return;
  }
  b.disabled = true; b.textContent = 'loading…';
  fetch('/redgif?id=' + encodeURIComponent(b.dataset.id))
    .then(function(res){ if(!res.ok) throw 0; return res.json(); })
    .then(function(d){
      if (!d.video) throw 0;
      var box = document.createElement('div');
      box.className = 'vidbox rgvbox';
      var v = document.createElement('video');
      v.className = 'vid'; v.controls = true; v.playsInline = true; v.muted = MUTED; v.src = d.video;
      if (d.poster) v.poster = d.poster;
      box.appendChild(v);
      if (d.len){
        var len = document.createElement('span');
        len.className = 'vlen'; len.textContent = d.len;
        box.appendChild(len);
      }
      var foot = card.querySelector('.footer');
      foot.before(box);
      b.disabled = false; b.dataset.on = '1'; b.textContent = 'video';
      addPlayerControls(foot);
      v.addEventListener('play', function(){ v.playbackRate = SPEED; });
      applyMediaPrefs();
      // the tap that asked for it is the gesture that may play it
      var p = v.play();
      if (p && p.catch) p.catch(function(){});
    })
    .catch(function(){
      b.disabled = false; b.textContent = 'video';
      toast('could not load the video');
    });
});

// Playback settings are global: the speed (cycles 2× → 2.5× → 3× → 1×), mute (default muted)
// and loop (default off) buttons on any card apply to every player — native
// <video>, YouTube embeds, and podcast <audio> alike — so the whole feed
// behaves one way. The rate is re-applied on play because loading media resets
// it. Clicks are delegated since YouTube cards get their buttons injected
// after this runs.
var SPEEDS = [2, 2.5, 3, 1];
var SPEED = SPEEDS[0];
// the IFrame API caps at 2× and ignores anything higher
function ytRate(){ return Math.min(SPEED, 2); }
// Sound is the one preference that is not the page's: the speed you read at is
// the same on every card, but whether a thing should be making noise is about
// that thing. So MUTED is only the default every player starts at — settings
// keeps it, and a card's own mute button overrides it for that card alone. The
// next card is back to the default, which is the whole point: you turn the
// sound on for the one clip worth hearing, not for the rest of the evening.
var MUTED = true;
try { MUTED = localStorage.getItem('tui:muted') !== '0'; } catch(e){}
var LOOP = false;
function mutedFor(card){
  var own = card && card.dataset ? card.dataset.mute : '';
  if (own === '1') return true;
  if (own === '0') return false;
  return MUTED;
}
function cardOf(el){ return el && el.closest ? el.closest('article.card') : null; }
function applyMediaPrefs(){
  document.querySelectorAll('video.vid').forEach(function(v){
    v.defaultPlaybackRate = SPEED; v.playbackRate = SPEED; v.loop = LOOP;
    v.muted = mutedFor(cardOf(v));
  });
  document.querySelectorAll('audio.aud').forEach(function(a){
    a.defaultPlaybackRate = SPEED; a.playbackRate = SPEED;
    a.muted = mutedFor(cardOf(a));
  });
  ytPlayers.forEach(function(p){
    if (p.setPlaybackRate) p.setPlaybackRate(ytRate());
    if (p.mute && p.unMute){ if (mutedFor(p._posCard)) p.mute(); else p.unMute(); }
  });
  document.querySelectorAll('button.speed').forEach(function(b){ b.textContent = SPEED + '×'; });
  document.querySelectorAll('button.mute').forEach(function(b){
    b.textContent = mutedFor(cardOf(b)) ? 'unmute' : 'mute';
  });
  document.querySelectorAll('button.loop').forEach(function(b){
    b.dataset.on = LOOP ? '1' : '0';
    b.textContent = LOOP ? 'looping' : 'loop';
  });
}
document.addEventListener('click', function(e){
  var b = e.target.closest ? e.target.closest('button.speed, button.mute, button.loop') : null;
  if (!b) return;
  if (b.classList.contains('speed')) SPEED = SPEEDS[(SPEEDS.indexOf(SPEED) + 1) % SPEEDS.length];
  else if (b.classList.contains('loop')) LOOP = !LOOP;
  else {
    // This card only, and left on the card so it survives whatever else
    // re-applies the preferences.
    var card = cardOf(b);
    if (card) card.dataset.mute = mutedFor(card) ? '0' : '1';
  }
  applyMediaPrefs();
});
document.querySelectorAll('video.vid, audio.aud').forEach(function(m){
  m.addEventListener('play', function(){ m.playbackRate = SPEED; });
});
applyMediaPrefs();

// The length badge turns into a countdown once the clip is running: before a
// tap it answers "how long is this", after one the useful question is "how much
// is left". The badge's own text is the length, kept in the element so the end
// (or a restart) can put it back. Listens in the capture phase, which also
// catches players that arrive later (a resolved redgifs clip).
function lenBadge(el){
  var box = el.parentElement;
  return box && box.classList.contains('vidbox') ? box.querySelector('.vlen') : null;
}
function fmtLen(secs){
  secs = Math.max(0, Math.round(secs));
  var m = Math.floor(secs / 60) % 60, s = secs % 60;
  var h = Math.floor(secs / 3600);
  var mm = h ? (m < 10 ? '0' + m : '' + m) : '' + m;
  return (h ? h + ':' : '') + mm + ':' + (s < 10 ? '0' + s : '' + s);
}
function countdown(el){
  var b = lenBadge(el);
  if (!b || !isFinite(el.duration) || !el.duration) return;
  if (!b.dataset.len) b.dataset.len = b.textContent;
  var left = el.duration - el.currentTime;
  // Ceil so the last second reads 0:01 rather than sitting on 0:00.
  b.textContent = el.currentTime > 0 ? fmtLen(Math.ceil(left)) : b.dataset.len;
}
function countdownReset(el){
  var b = lenBadge(el);
  if (b && b.dataset.len) b.textContent = b.dataset.len;
}
document.addEventListener('timeupdate', function(e){ countdown(e.target); }, true);
document.addEventListener('seeked', function(e){ countdown(e.target); }, true);
document.addEventListener('ended', function(e){ countdownReset(e.target); }, true);

// Where you left off. A saved item is the one thing here that outlives the
// page, so the position in its player is kept with it: posted back as it plays
// and handed down with the card, so the next visit — on this phone or on
// another device reading the same synced store — picks up there. Media events
// don't bubble, so these listen in the capture phase, which also catches
// players that arrive later (a resolved redgifs clip).
var POS_EVERY = 15; // seconds of playback between reports
var POS_MIN = 5;    // less than this in is not worth coming back to
var POS_END = 10;   // this close to the end, it is finished, not paused
// A player this server streams itself (a bilibili clip) is reached under
// whatever address the phone typed, so its position is pinned to the path alone:
// the same saved item then resumes on another device reading the same store.
function mediaSrc(el){
  var s = el.currentSrc || el.src || '';
  return s.indexOf(location.origin + '/') === 0 ? s.slice(location.origin.length) : s;
}
// postPos sends a position for one player, or 0 to forget it. The card carries
// the last value so a re-render isn't needed to keep the page in step.
function postPos(card, src, secs, beacon){
  if (!card || !card.dataset.app) return;
  var fd = new FormData();
  fd.append('app', card.dataset.app);
  fd.append('id', card.dataset.id);
  fd.append('src', secs > 0 ? src : '');
  fd.append('secs', secs.toFixed(1));
  if (beacon && navigator.sendBeacon) navigator.sendBeacon('/pos', fd);
  else fetch('/pos', {method: 'POST', body: fd, keepalive: true}).catch(function(){});
  card.dataset.pos = secs;
  card.dataset.posKey = secs > 0 ? src : '';
}
// savePos reports where a player is now: the plain position, or 0 once it is
// past the end or back near the start, which is how a finished item forgets it.
function savePos(el, beacon){
  var card = el.closest ? el.closest('article.card') : null;
  if (!card || !isFinite(el.duration) || !el.duration) return;
  var t = el.currentTime;
  if (t >= el.duration - POS_END || t < POS_MIN) t = 0;
  if (el._posSent === t) return;
  el._posSent = t;
  postPos(card, mediaSrc(el), t, beacon);
}
// resumeMedia puts a player back where the card says it was left, once the
// browser knows how long the media runs.
function resumeMedia(el){
  var card = el.closest ? el.closest('article.card') : null;
  if (!card || !isFinite(el.duration)) return;
  var at = parseFloat(card.dataset.pos || '0');
  if (!at || card.dataset.posKey !== mediaSrc(el)) return;
  if (at < POS_MIN || at > el.duration - POS_END) return;
  el._posSent = at; // already where the server has it; don't report it back
  el.currentTime = at;
}
document.addEventListener('loadedmetadata', function(e){ resumeMedia(e.target); }, true);
// An audio bar preloads its metadata as it is parsed, which can land before
// this script runs at all — so sweep once for players that are already ready
// rather than waiting for an event that has been and gone.
document.querySelectorAll('video.vid, audio.aud').forEach(function(m){
  if (m.readyState >= 1) resumeMedia(m);
});
document.addEventListener('timeupdate', function(e){
  var el = e.target;
  if (el.paused || !isFinite(el.duration)) return;
  if (Math.abs(el.currentTime - (el._posAt || 0)) < POS_EVERY) return;
  el._posAt = el.currentTime;
  savePos(el);
}, true);
document.addEventListener('pause', function(e){ savePos(e.target); }, true);
document.addEventListener('ended', function(e){ savePos(e.target); }, true);
// A YouTube embed has no media element to listen to, so its position is read
// off the player instead. 'yt:<id>' names the stream the way a media URL names
// a native one, so one saved item can only ever resume one of them.
// ytResumeAt is where this embed should start, or 0 for the beginning. The
// duration isn't known before the player exists, so "near the end" is judged
// when the position is reported instead, which is what stored a 0 in the first
// place.
function ytResumeAt(card, id){
  if (!card || card.dataset.posKey !== 'yt:' + id) return 0;
  var at = parseFloat(card.dataset.pos || '0');
  return at >= POS_MIN ? at : 0;
}
function ytSavePos(card, p, id, beacon){
  if (!card || !p || !p.getDuration) return;
  var d = p.getDuration(), t = p.getCurrentTime();
  if (!d) return;
  if (t >= d - POS_END || t < POS_MIN) t = 0;
  if (p._posSent === t) return;
  p._posSent = t;
  postPos(card, 'yt:' + id, t, beacon);
}
// A phone closing the tab gets no second chance: send whatever is in flight.
window.addEventListener('pagehide', function(){
  document.querySelectorAll('video.vid, audio.aud').forEach(function(m){
    if (m.currentTime > 0) savePos(m, true);
  });
  ytPlayers.forEach(function(p){
    if (p.getCurrentTime && p.getCurrentTime() > 0) ytSavePos(p._posCard, p, p._posId, true);
  });
});

// Fake fullscreen (pipepipe-web's trick): pin the card's player over the
// viewport, sized 100vh×100vw and rotated -90°, so a landscape video fills a
// portrait phone without native fullscreen. A transparent tap layer splits
// the screen into thirds — top seeks +30s, bottom -30s, middle toggles play —
// and the rotated × (or Escape) exits, restoring the scroll position.
var FFS_SEEK = 30;
var ffs = null; // {el, scrollY} while active
function ffsPlayers(){
  if (!ffs) return {};
  if (ffs.el.tagName === 'VIDEO') return {video: ffs.el};
  return {yt: ffs.el._ytPlayer}; // may still be null while the API loads
}
function enterFfs(card){
  if (ffs || !card) return;
  // a player the video toggle has put away is not the one to blow up
  var el = card.querySelector('.vidbox:not(.hid) video.vid') || card.querySelector('.yt-embed');
  if (!el){
    var thumb = card.querySelector('.yt'); // not started yet: start it now
    if (thumb) thumb.click();
    el = card.querySelector('.yt-embed');
    if (!el) return;
  }
  ffs = {el: el, scrollY: window.scrollY || 0};
  var v = ffsPlayers();
  if (v.video && v.video.paused) v.video.play();
  document.documentElement.classList.add('ffs-on');
  el.classList.add('ffs');
  var tap = document.createElement('div');
  tap.className = 'ffs-tap';
  tap.addEventListener('click', ffsTap);
  document.body.appendChild(tap);
  var exit = document.createElement('button');
  exit.className = 'ffs-exit'; exit.type = 'button'; exit.title = 'exit fullscreen';
  exit.textContent = '×';
  exit.addEventListener('click', exitFfs);
  document.body.appendChild(exit);
}
function exitFfs(){
  if (!ffs) return;
  document.documentElement.classList.remove('ffs-on');
  ffs.el.classList.remove('ffs');
  var t = document.querySelector('.ffs-tap'); if (t) t.remove();
  var x = document.querySelector('.ffs-exit'); if (x) x.remove();
  window.scrollTo(0, ffs.scrollY);
  ffs = null;
}
function ffsTap(e){
  e.preventDefault();
  var pos = e.clientY / window.innerHeight;
  if (pos < 1/3) ffsSeek(FFS_SEEK);
  else if (pos > 2/3) ffsSeek(-FFS_SEEK);
  else ffsToggle();
}
function ffsSeek(d){
  var v = ffsPlayers();
  if (v.yt && v.yt.seekTo){
    var dur = (v.yt.getDuration && v.yt.getDuration()) || Infinity;
    v.yt.seekTo(Math.min(dur, Math.max(0, v.yt.getCurrentTime() + d)), true);
  } else if (v.video){
    var vd = isFinite(v.video.duration) ? v.video.duration : Infinity;
    v.video.currentTime = Math.min(vd, Math.max(0, v.video.currentTime + d));
  }
}
function ffsToggle(){
  var v = ffsPlayers();
  if (v.yt && v.yt.getPlayerState){
    if (v.yt.getPlayerState() === YT.PlayerState.PLAYING) v.yt.pauseVideo();
    else v.yt.playVideo();
  } else if (v.video){
    if (v.video.paused) v.video.play(); else v.video.pause();
  }
}
document.addEventListener('click', function(e){
  var b = e.target.closest ? e.target.closest('button.rot') : null;
  if (b) enterFfs(b.closest('article.card'));
});
document.addEventListener('keydown', function(e){ if (e.key === 'Escape') exitFfs(); });

// Expand/collapse reveals the full post content — the card's own body and the
// quoted post's, which each render as their own preview/full pair. Expanding
// is the "+N words" count at the end of the clipped text (server-rendered, so
// delegate); collapsing is the footer button, which exists only while there is
// something expanded to collapse.
document.addEventListener('click', function(e){
  var b = e.target.closest ? e.target.closest('button.rest, button.expand') : null;
  if (!b) return;
  var card = b.closest('article.card');
  if (!card) return; // the briefing's own controls wear .rest and have no card
  card.querySelectorAll('.preview, .full').forEach(function(el){ el.classList.toggle('hid'); });
  var expanded = card.querySelector('.preview').classList.contains('hid');
  var less = card.querySelector('.footer > button.expand');
  if (less) less.classList.toggle('hid', !expanded);
});
// Mark the complete server-side pick read, not just the cards in this client
// window. The current filter travels with the request, while sort and layout do
// not affect which items belong to it.
var markAllBtn = document.getElementById('markAll');
if(markAllBtn) markAllBtn.addEventListener('click', function(){
  var total = markAllCount();
  var asks = BRIEF
    ? 'Mark the ' + total + (total === 1 ? ' item' : ' items') + ' this briefing read as read?'
    : 'Mark all ' + total + (total === 1 ? ' item' : ' items') + markAllScope() + ' read?';
  if((SWIPE || SUMMARY_ON) && !window.confirm(asks)) return;
  markAllBtn.disabled = true;
  if(flushTimer) clearTimeout(flushTimer);
  pending = {};
  var fd = new FormData(), q = new URLSearchParams(location.search);
  // Under a briefing the server is asked for exactly what that briefing read;
  // the pick's filters would be a different set of items and a wider one.
  // The stamp says which run of it: a tab holds the briefing it rendered while
  // the server holds the latest run, and clearing what a later one read is not
  // clearing what you were told.
  if(BRIEF){ fd.append('brief', BRIEF.key); if(BRIEF.gen) fd.append('gen', BRIEF.gen); }
  else ['app', 'type', 'x', 'sub', 'skipped'].forEach(function(k){ if(q.has(k)) fd.append(k, q.get(k)); });
  markFlights.then(function(){ return fetch('/mark-all', {method:'POST', body:fd}); })
    .then(function(res){ if(!res.ok) return res.text().then(function(m){ throw new Error(m); }); return res.json(); })
    .then(function(d){ if(!d.ok) throw new Error(''); location.reload(); })
    // The server's own words when it has any: a refusal that says why is the
    // difference between running the briefing again and tapping this forever.
    .catch(function(err){
      markAllBtn.disabled = false;
      toast((err && err.message || '').trim() || 'could not mark this feed read');
    });
});
var settingsDlg = document.getElementById('settingsdlg');
var settingsOpen = document.getElementById('settingsOpen');
var controlsLeft = document.getElementById('controlsLeft');
function positionDeckControls(){
  var nav = document.getElementById('deckNav');
  if(nav){ nav.classList.toggle('atleft', CONTROLS_LEFT); nav.classList.toggle('atright', !CONTROLS_LEFT); }
}
positionDeckControls();
if(settingsDlg && settingsOpen && controlsLeft){
  controlsLeft.checked = CONTROLS_LEFT;
  settingsOpen.addEventListener('click', function(){ settingsDlg.showModal(); });
  controlsLeft.addEventListener('change', function(){
    CONTROLS_LEFT = controlsLeft.checked;
    try { localStorage.setItem('tui:deck-controls-left', CONTROLS_LEFT ? '1' : '0'); } catch(e){}
    positionDeckControls();
  });
}
// The default every player starts at. Cards you have already given a say of
// their own keep it — the setting is what the next one takes.
var muteDefault = document.getElementById('muteDefault');
if (muteDefault){
  muteDefault.checked = MUTED;
  muteDefault.addEventListener('change', function(){
    MUTED = muteDefault.checked;
    try { localStorage.setItem('tui:muted', MUTED ? '1' : '0'); } catch(e){}
    applyMediaPrefs();
  });
}
// The interest list: what you are following at the moment, in your own words,
// which a sift asks about every unread item. It lives on the server rather than
// in this browser like the settings above it — the judging happens there, and
// the answer belongs to the backlog rather than to the tab that asked.
//
// Saving drops every judgment behind it, and stops there. Starting a run from
// here would be a second thing behind one button, and a sift is the header's to
// begin: it is one action that asks everything — what is worth reading, how
// much it repays opening, and which of your subjects it is about.
(function(){
  var text = document.getElementById('intext'), save = document.getElementById('insave');
  if (!text || !save) return;
  var sent = text.value;
  save.addEventListener('click', function(){
    if (text.value === sent){ toast('that is already the list'); return; }
    save.disabled = true;
    var fd = new FormData();
    fd.append('interests', text.value);
    fetch('/interests', {method:'POST', body:fd})
      .then(function(res){ if(!res.ok) return res.text().then(function(m){ throw new Error(m); }); return res.json(); })
      // The chips the old list filled are gone with it, so the page it left
      // behind is not the page the server would serve now.
      .then(function(){ location.reload(); })
      .catch(function(err){
        save.disabled = false;
        toast((err && err.message || '').trim() || 'could not save the list');
      });
  });
})();

// Changing the language does not rewrite the briefings already in hand: a
// summary is in the language it was written in. The sparkles re-read themselves
// instead, so one written in the language you have just left goes back to
// offering a run, and switching back finds it again where it was kept.
(function(){
  var box = document.getElementById('sumLang');
  if (!box) return;
  box.querySelectorAll('input[name="sumlang"]').forEach(function(r){
    r.checked = r.value === SUM_LANG;
    r.addEventListener('change', function(){
      if (!r.checked) return;
      SUM_LANG = r.value;
      try { localStorage.setItem('tui:summary-lang', SUM_LANG); } catch(e){}
      document.dispatchEvent(new CustomEvent('tui:sumlang'));
    });
  });
})();

// Changing it is the one thing that writes: the server is told, and every
// other page picks the new language up on its next load. Nothing sends on
// load — a page that pushed what it happens to hold would be a device quietly
// undoing the choice you made on the other one.
(function(){
  document.addEventListener('tui:sumlang', function(){
    var fd = new FormData();
    fd.append('do', 'lang');
    fd.append('lang', SUM_LANG);
    fetch('/digest', {method:'POST', body:fd})
      .catch(function(){ toast('the language is set here, but the server did not hear it'); });
  });
})();

// The deck (?deck=1): one card on screen, walked through from an edge column.
if (SWIPE) (function(){
  var deck = document.getElementById('deck');
  if (!deck) return;
  var cards = [].slice.call(deck.querySelectorAll('article.card'));
  var endEl = document.getElementById('deckEnd');
  var prevBtn = document.getElementById('deckPrev');
  var nextBtn = document.getElementById('deckNext');
  var at = Math.min(DECK_START, cards.length);

  function current(){ return at < cards.length ? cards[at] : null; }
  function updateControls(done){
    var controls = document.getElementById('deckNav');
    if(controls) controls.classList.toggle('hid', done);
    if(prevBtn) prevBtn.disabled = at === 0;
  }
  function show(){
    cards.forEach(function(c, i){ c.classList.toggle('hid', i !== at); });
    var left = cards.length - at;
    deck.classList.toggle('last2', left === 2);
    deck.classList.toggle('last', left <= 1);
    window.scrollTo(0, 0); // the card that scrolled is gone; start the next at its top
    var done = at >= cards.length;
    // Hide the centering wrapper, not just the deck, or its height would leave
    // a hole above the end note. Reversible: walking back brings it out again.
    deck.parentNode.classList.toggle('hid', done);
    if (endEl) endEl.classList.toggle('hid', !done);
    updateControls(done);
    if (markAllBtn) markAllBtn.classList.toggle('hid', done);
  }
  // A card that leaves the screen takes its audio with it.
  function quiet(card){
    card.querySelectorAll('video, audio').forEach(function(m){ m.pause(); });
    card.querySelectorAll('.yt-embed').forEach(function(w){
      if (w._ytPlayer && w._ytPlayer.pauseVideo) w._ytPlayer.pauseVideo();
    });
  }
  function deal(card){
    quiet(card);
    at++;
    show();
    if (at >= cards.length && MORE){
      document.getElementById('loading').classList.remove('hid');
      if (flushTimer) clearTimeout(flushTimer);
      flushPending().then(function(){ location.reload(); });
    }
  }
  function mark(card){
    if (!SAVED_VIEW) queueRead(card); // the flush decrements the header count
    deal(card);
  }
  // Walk back through what's already been dealt and restore that card to tui's
  // unread backlog. A mark request already in flight lands before its reversal.
  function back(){
    if (at === 0){ toast('this is the first one'); return false; }
    var leaving = current();
    if (leaving) quiet(leaving);
    at--;
    show();
    var card = current();
    queueUnread(card);
    return true;
  }
  function read(){
    var card = current();
    if(card) mark(card);
  }
  if (prevBtn) prevBtn.addEventListener('click', function(){ back(); });
  if (nextBtn) nextBtn.addEventListener('click', function(){ read(); });

  // The arrow keys walk the deck: left goes back, right marks read and moves on.
  document.addEventListener('keydown', function(e){
    // Not while the briefing is up: the deck is behind it, and a card dealt out
    // of sight is one marked read without having been seen.
    if (ffs || SUMMARY_ON || e.metaKey || e.ctrlKey || e.altKey) return;
    var k = e.key;
    if (k === 'ArrowLeft'){ e.preventDefault(); back(); }
    else if (k === 'ArrowRight'){ e.preventDefault(); read(); }
  });
  show();
})();

// A feed page is a read of the backlog cache, but a chip over a few hundred
// items still has to render them, and until it does the browser sits on the page
// you tapped from with nothing happening. Cover it as the tap happens, so the
// wait looks like a wait. The saved and blocked lists are short and instant, and
// anything opening a new tab leaves this page alone.
document.addEventListener('click', function(e){
  var a = e.target.closest ? e.target.closest('a[href]') : null;
  if (!a || a.target || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button) return;
  var u = new URL(a.getAttribute('href'), location.href);
  if (u.origin !== location.origin || u.pathname !== '/') return;
  if (u.searchParams.get('saved') === '1' || u.searchParams.get('blocked') === '1') return;
  document.getElementById('loading').classList.remove('hid');
});
// Coming back through history restores this page as it was left, cover and all.
window.addEventListener('pageshow', function(){ document.getElementById('loading').classList.add('hid'); });

var clearBlockedBtn = document.getElementById('clearBlocked');
if(clearBlockedBtn) clearBlockedBtn.addEventListener('click', function(){
  var total = parseInt(clearBlockedBtn.dataset.total, 10) || 0;
  if(!window.confirm('Delete all ' + total + ' blocked ' + (total === 1 ? 'item' : 'items') + '?')) return;
  clearBlockedBtn.disabled = true;
  fetch('/blocked/clear', {method:'POST'})
    .then(function(res){ return res.json(); })
    .then(function(d){ if(!d.ok) throw 0; location.reload(); })
    .catch(function(){ clearBlockedBtn.disabled = false; toast('could not clear blocked items'); });
});

// Sift: TypeSafe reads every unread item nothing has judged yet and says, one
// by one, whether there is anything in it. What it says no to leaves the feed
// for the skipped view rather than being marked read or deleted.
//
// The server sifts every fetch by itself, so this button is the early ask and
// the progress readout rather than the way it happens. The run belongs to the
// server either way: this starts it and then watches — a few hundred items is a
// minute of round trips, closing the tab does not stop it, and a second tab
// watching the same run sees the same numbers. The reload at the end is because
// the feed under it is a different feed by then.
//
// Only a run this tab asked for gets an answer in words. One that was already
// going when the page loaded is the server's own work, and "nothing was set
// aside" is a reply to a tap, not news.
var siftBtn = document.getElementById('siftBtn');
if(siftBtn) (function(){
  var label = document.getElementById('siftlabel');
  var poll = null, asked = false;
  function say(t){ if(label) label.textContent = t; }
  // How far through, on the button itself: a bare spinner over a minute of
  // work says nothing about whether it is moving.
  function running(j){
    if(!j || j.state !== 'running') return false;
    siftBtn.disabled = true;
    say(j.total ? j.done + '/' + j.total : 'sifting…');
    return true;
  }
  function ended(j){
    if(poll){ clearInterval(poll); poll = null; }
    siftBtn.disabled = false;
    say('sift');
    if(j && j.state === 'failed'){ toast(j.error || 'the sift failed'); return; }
    if(j && j.aside){ location.reload(); return; }
    if(asked) toast('nothing was set aside');
  }
  function watch(){
    if(poll) return;
    poll = setInterval(function(){
      fetch('/sift').then(function(res){ return res.json(); })
        .then(function(j){ if(!running(j)) ended(j); })
        .catch(function(){});
    }, 2000);
  }
  siftBtn.addEventListener('click', function(){
    siftBtn.disabled = true;
    asked = true;
    say('sifting…');
    fetch('/sift', {method:'POST'})
      .then(function(res){ if(!res.ok) return res.text().then(function(m){ throw new Error(m); }); return res.json(); })
      .then(function(j){ running(j); watch(); })
      .catch(function(err){
        siftBtn.disabled = false;
        say('sift');
        toast((err && err.message || '').trim() || 'could not sift');
      });
  });
  // A run the last fetch started, one from another tab, or one still going from
  // before this page loaded, is this button's to report on too. A run that died
  // is worth saying on hover: nothing else on the page would ever mention it,
  // and an unsifted feed looks exactly like a feed with nothing to set aside.
  fetch('/sift').then(function(res){ return res.json(); })
    .then(function(j){
      if(running(j)) { watch(); return; }
      if(j && j.state === 'failed' && j.error) siftBtn.title = 'the last sift failed: ' + j.error;
    }).catch(function(){});
})();

// Summarize: a briefing over one source's whole unread backlog, asked for from
// that source's own chip. A run costs minutes, so nothing here waits on one —
// the icon spins, the server keeps working after the tap that started it, and
// you carry on reading. Several sources can be spinning at once; the server runs
// them one at a time, which is the honest thing to do with a subprocess that
// costs tokens, and the icons say which are still going.
//
// A finished briefing is filled in, and tapping it then opens what it wrote: on
// this source's own page, in place of the cards it is a briefing of. The cards
// are hidden rather than thrown away, so scroll position, players and whatever
// is part-expanded are all still there when you come back — coming back to where
// you were is the point of a summary that names items to open.
//
// Results live in sessionStorage, so toggling the two views costs nothing and
// "next"/"retry" is how you spend another run. Session rather than local storage
// because a briefing is about a backlog as it stood, and a backlog is exactly
// what changes while a tab is closed.
(function(){
  var icons = {};
  document.querySelectorAll('button.fsum[data-app]').forEach(function(b){ icons[b.dataset.app] = b; });
  var panel = document.getElementById('summary');
  var mine = panel ? (panel.dataset.app || '') : ''; // the source this page can show
  if (!panel && !Object.keys(icons).length) return;

  var poll = null, open = false, atFeed = 0, getting = {};
  // How many items have arrived for each source since its briefing was written,
  // as the server last said. Kept out of what sessionStorage holds: the prose is
  // what a briefing is, and how overtaken it is has to be asked about again
  // every time it is opened.
  var behind = {}, behindNote = null;
  // How many items the briefing on screen read, which is what mark-all clears
  // under it, and which run of it wrote them: a tab keeps a briefing for as long
  // as it is open, while the server's job is only ever the latest run. Kept here
  // rather than read back off the panel, since the panel is prose by the time it
  // is on screen.
  var covered = 0, stampedAt = '';

  // Kept per language as well as per source: a briefing is in the language it
  // was written in, so the two are separate things to have and switching back
  // finds the earlier one still there.
  function slot(app){ return 'tui:summary:' + app + ':' + SUM_LANG; }
  function held(app){
    try { var raw = sessionStorage.getItem(slot(app)); return raw ? JSON.parse(raw) : null; }
    catch(e){ return null; }
  }
  function hold(app, d){
    try { sessionStorage.setItem(slot(app), JSON.stringify(d)); } catch(e){}
  }

  function state(app){ return icons[app] ? icons[app].dataset.state : ''; }
  // What to call a source out loud. The key is what the server knows it by, and
  // for x's two timelines that is not a name anybody would recognize.
  function named(app){
    var b = icons[app];
    return (b && b.dataset.says) || app;
  }
  function setState(app, s){
    var b = icons[app];
    if (!b) return;
    b.dataset.state = s;
    var says = s === 'running' ? 'summarizing ' + named(app) + '…'
      : s === 'done' ? 'read the summary of ' + named(app) + "'s backlog"
      : 'summarize ' + named(app) + "'s unread backlog";
    b.title = says;
    b.setAttribute('aria-label', says);
  }

  // The URL says which of the two views you are on, so a reload stays put and
  // the link a finished icon sends you to opens on the briefing.
  function stamp(on){
    try {
      var u = new URL(location.href);
      if (on) u.searchParams.set('summary', '1'); else u.searchParams.delete('summary');
      history.replaceState(null, '', u.pathname + (u.search || '') + u.hash);
    } catch(e){}
  }

  // Swapping the views is also swapping where you are on the page: the briefing
  // starts at its top, and leaving it puts the feed back where it was. Cards
  // that ended up above the viewport by that restore are exempted, since nobody
  // scrolled past them — the same care the page takes over a restored offset.
  // mark-all comes along into the briefing, relabelled: having read one and
  // decided the items behind it are not worth opening, clearing what it read is
  // the next thing you do. What it read, not what the pick holds — the whole
  // feed's briefing is capped, and the rest was never mentioned to you.
  function show(on){
    if (!panel) return;
    if (on && !open) atFeed = window.scrollY || 0;
    open = on;
    SUMMARY_ON = on;
    BRIEF = on && covered ? {key: mine, count: covered, gen: stampedAt} : null;
    document.body.classList.toggle('sumon', on);
    labelMarkAll();
    stamp(on);
    if (on){ window.scrollTo(0, 0); return; }
    window.scrollTo(0, atFeed);
    exemptBehind();
  }

  // A run is in flight and there is nothing on screen that has been read yet, so
  // mark-all goes back to meaning the pick until there is.
  function waiting(){
    if (!panel) return;
    covered = 0;
    stampedAt = '';
    BRIEF = null;
    labelMarkAll();
    panel.textContent = '';
    var note = document.createElement('div');
    note.className = 'note';
    note.textContent = 'Reading the backlog — this takes a minute or two.';
    panel.appendChild(note);
  }

  // Whether the briefing on screen is still about the backlog behind it. A
  // sweep lands every quarter of an hour, so a briefing read twenty minutes
  // after it was written can be missing items nobody would guess were there —
  // and the count is by id, not by totals, since reading some and fetching some
  // leaves a total where it was.
  function paintBehind(){
    if (!behindNote) return;
    var n = behind[mine] || 0;
    behindNote.textContent = n ? (n === 1 ? '1 new item since' : n + ' new items since') : '';
    behindNote.title = n ? 'this briefing was written before these arrived' : '';
  }

  // The server's word on how overtaken the briefings are, which is also what
  // settles the icons, so this is the same ask the page makes on load.
  function recount(){
    fetch('/summarize')
      .then(function(res){ return res.json(); })
      .then(function(d){ if (sync((d && d.jobs) || {})) watch(); paintBehind(); })
      .catch(function(){});
  }

  function render(d){
    if (!panel) return;
    panel.textContent = '';
    var meta = document.createElement('div');
    meta.className = 'smeta';
    var when = '';
    try { when = new Date(d.generated).toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'}); } catch(e){}
    var n = d.count || 0;
    covered = n;
    stampedAt = d.generated || '';
    if (open) BRIEF = {key: mine, count: n, gen: stampedAt};
    labelMarkAll();
    // "200 of 356" when the cap bit: a briefing that read part of a backlog has
    // to say so, or the next thing you do is act as though it read all of it.
    var of = (d.backlog && d.backlog > n) ? ' of ' + d.backlog : '';
    meta.textContent = n + of + (n === 1 && !of ? ' unread item' : ' unread items')
      + (when ? ', summarized ' + when : '');
    behindNote = document.createElement('span');
    behindNote.className = 'sold';
    meta.appendChild(behindNote);
    paintBehind();
    // Two ways to spend another run, and the difference matters: "next" reads the
    // backlog as it stands, which after a capped briefing is the items behind
    // these ones; "retry" reads this same batch over again, which is what a run
    // the model made a mess of needs and what "next" would quietly skip past.
    var next = document.createElement('button');
    next.type = 'button';
    next.className = 'rest';
    next.textContent = 'next';
    next.title = 'summarize the backlog as it stands now';
    next.addEventListener('click', function(){ start(mine); waiting(); });
    meta.appendChild(next);
    var gen = d.generated || '';
    var redo = document.createElement('button');
    redo.type = 'button';
    redo.className = 'rest';
    redo.textContent = 'retry';
    redo.title = 'write this briefing again over the same items';
    redo.addEventListener('click', function(){ start(mine, gen); waiting(); });
    meta.appendChild(redo);
    // What the tab held may predate a sweep or two, and the note is the whole
    // point of being told so: ask the server before believing the count.
    recount();
    var body = document.createElement('div');
    body.className = 'body';
    // Server-rendered from Markdown by the same renderer the cards use, which
    // escapes whatever HTML the model may have written.
    body.innerHTML = d.html;
    panel.appendChild(meta);
    panel.appendChild(body);
  }

  // gen asks for the run stamped that way to be written again over its own
  // items, rather than for the backlog as it stands.
  function start(app, gen){
    if (state(app) === 'running') return;
    setState(app, 'running');
    var fd = new FormData();
    fd.append('app', app);
    fd.append('lang', SUM_LANG);
    fd.append('order', FEED_ASC ? 'asc' : 'desc');
    if (gen) fd.append('gen', gen);
    fetch('/summarize', {method:'POST', body:fd})
      .then(function(res){ if(!res.ok) return res.text().then(function(m){ throw new Error(m); }); return res.json(); })
      .then(function(){ watch(); })
      .catch(function(err){
        setState(app, held(app) ? 'done' : 'idle');
        if (app === mine && open) show(false);
        toast((err && err.message || '').trim() || 'could not summarize ' + named(app));
      });
  }

  // The whole briefing, once its job says there is one. reveal is for the run
  // you are sitting in front of waiting for; anything else finishing says so in
  // a toast and leaves you where you are.
  function collect(app, reveal){
    if (getting[app]) return; // a poll every three seconds must not stack fetches
    getting[app] = 1;
    var was = state(app);
    fetch('/summarize?app=' + encodeURIComponent(app))
      .then(function(res){ if(!res.ok) throw 0; return res.json(); })
      .then(function(d){
        if (!d || !d.html) throw 0;
        if (d.lang && d.lang !== SUM_LANG) throw 0; // written in the other one
        hold(app, d);
        behind[app] = d['new'] || 0;
        setState(app, 'done');
        if (reveal && app === mine){ render(d); show(true); return; }
        paintBehind();
        if (was === 'running') toast(named(app) + "'s summary is ready");
      })
      .catch(function(){
        setState(app, held(app) ? 'done' : 'idle');
        if (reveal && app === mine) show(false);
      })
      .then(function(){ delete getting[app]; });
  }

  // What the server says about every source it has been asked about, folded into
  // the icons. Returns whether anything is still going, which is what decides
  // whether to keep asking.
  function sync(jobs){
    var going = false;
    Object.keys(icons).forEach(function(app){
      var j = jobs[app], was = state(app);
      if (!j){
        // The server has no job for it: whatever this tab already holds stands.
        if (was === 'running') setState(app, held(app) ? 'done' : 'idle');
        return;
      }
      // A job in the other language is not the one this browser is asking for,
      // so it counts for nothing here: no spinner to wait on, nothing to adopt.
      // Whatever is cached for the language in hand is what the icon says.
      if (j.lang && j.lang !== SUM_LANG){
        if (was === 'running') setState(app, held(app) ? 'done' : 'idle');
        return;
      }
      if (j.state === 'running'){ going = true; setState(app, 'running'); return; }
      if (j.state === 'done'){
        behind[app] = j['new'] || 0;
        if (was !== 'done') collect(app, was === 'running' && app === mine && open);
        return;
      }
      if (was === 'running'){
        setState(app, held(app) ? 'done' : 'idle');
        if (app === mine && open) show(false);
        toast(j.error || ('could not summarize ' + named(app)));
      }
    });
    return going;
  }

  function watch(){
    if (poll) return;
    poll = setInterval(function(){
      fetch('/summarize')
        .then(function(res){ return res.json(); })
        .then(function(d){
          if (sync((d && d.jobs) || {})) return;
          clearInterval(poll); poll = null;
        })
        .catch(function(){});
    }, 3000);
  }

  // A finished briefing belongs on its own source's page: closing it should
  // leave you in that source's cards, not in whatever list you tapped from.
  function opens(app){
    if (app === mine){
      // The icon is the switch between the two views, so the briefing it opened
      // is what it closes.
      if (open){ show(false); return; }
      var d = held(app);
      if (d && d.html){ render(d); show(true); return; }
      if (state(app) === 'running'){ waiting(); show(true); return; }
      collect(app, true);
      return;
    }
    var link = icons[app] ? icons[app].previousElementSibling : null;
    var href = (link && link.getAttribute('href')) || ('/?app=' + encodeURIComponent(app));
    try {
      var u = new URL(href, location.href);
      u.searchParams.set('summary', '1');
      href = u.pathname + u.search;
    } catch(e){}
    leaveFor(href);
  }

  document.addEventListener('click', function(e){
    var b = e.target.closest ? e.target.closest('button.fsum') : null;
    if (!b) return;
    // Tapping an idle icon fires and nothing else: firing is what you do so you
    // can keep reading, and taking the page away from you would be the opposite.
    if (b.dataset.state === 'idle'){ start(b.dataset.app); return; }
    opens(b.dataset.app);
  });

  // What this tab already holds settles the icons before the server is asked.
  Object.keys(icons).forEach(function(app){ if (held(app)) setState(app, 'done'); });

  // ...and the server settles the rest: what is still running, and what was run
  // from another tab or before this page was loaded.
  function arrive(jobs){
    if (sync(jobs)) watch();
    if (!panel || panel.dataset.open !== '1' || !mine) return;
    var d = held(mine);
    if (d && d.html){ render(d); show(true); return; }
    var j = jobs[mine];
    if (j && j.state === 'running'){ waiting(); show(true); return; }
    if (j && j.state === 'done'){ collect(mine, true); return; }
    stamp(false); // the link outlived the briefing it opened
  }
  fetch('/summarize')
    .then(function(res){ return res.json(); })
    .then(function(d){ arrive((d && d.jobs) || {}); })
    .catch(function(){ arrive({}); });

  // A briefing left open outlives sweeps. Coming back to the tab is the moment
  // to ask again how far behind it has fallen, rather than putting a timer on a
  // page that is otherwise quiet once it has loaded.
  document.addEventListener('visibilitychange', function(){
    if (!document.hidden && open) recount();
  });

  // The language setting changed. Nothing already written is rewritten — a
  // briefing is in the language it was written in — so the icons re-read
  // themselves against what is held for the language now in hand, and the server
  // is asked again in case a run is going in it. A briefing on screen in the
  // language you have just left gives way to the cards it was standing in for.
  document.addEventListener('tui:sumlang', function(){
    Object.keys(icons).forEach(function(app){
      if (state(app) !== 'running') setState(app, held(app) ? 'done' : 'idle');
    });
    if (open && mine){
      var d = held(mine);
      if (d && d.html) render(d); else show(false);
    }
    fetch('/summarize')
      .then(function(res){ return res.json(); })
      .then(function(d){ if (sync((d && d.jobs) || {})) watch(); })
      .catch(function(){});
  });
})();

// The summary chip: the digests a fetch writes by itself. The server renders
// the one waiting straight into the page, so there is nothing to fetch here and
// nothing to hold in the tab — only the two things that can be done to it.
//
// Both land as a page load, which is the honest thing for either: next has
// marked a couple of hundred items read and the counts everywhere on the page
// have moved, and retry is a run of a minute or two whose result is the page
// itself. A reload is also how the next digest arrives, so the pile is read by
// tapping one button over and over.
(function(){
  var panel = document.getElementById('digest');
  var note = document.getElementById('dignote');
  if (!panel && !note) return;
  var poll = null;

  function ask(){ return fetch('/digest').then(function(r){ return r.json(); }); }

  function stop(){ if (poll) { clearInterval(poll); poll = null; } }

  // A run is going: the page it lands on is this one, so come back for it
  // rather than leaving a stale digest on screen.
  //
  // With a digest in front of you the run worth reloading for is a rewrite of
  // that one, and the stamp it carries is what says so: a fetch's own run lands
  // behind this digest and leaves it exactly as it was, so the state alone
  // cannot tell the two apart and would reload the page for somebody else's
  // work. A run that failed says why instead of reloading into the same
  // summary with nothing to show for the tap.
  function watch(){
    if (poll) return;
    var gen = panel ? panel.dataset.gen : '';
    poll = setInterval(function(){
      ask().then(function(j){
        if (!j) return;
        if (panel && j.generated && j.generated !== gen) { stop(); location.reload(); return; }
        if (j.state === 'running') return;
        stop();
        if (!panel) { location.reload(); return; }
        // The run was somebody else's — a fetch's, which has filed its digest
        // behind this one and left this one alone. Take the note down and hand
        // the controls back rather than reloading a page that has not changed.
        working(false); busy(false, 'next');
        if (j.state === 'failed') toast((j.error || '').trim() || 'the summary could not be written');
      }).catch(function(){});
    }, 3000);
  }

  // The run, said on the panel itself. The old summary stays underneath rather
  // than being wiped: it is a minute or two of waiting, it is still the summary
  // of those items until the new one lands, and a blank panel is the one thing
  // that cannot say whether anything is happening at all.
  function working(on, say){
    if (!panel) return;
    var n = document.getElementById('digwait');
    if (!on) { if (n) n.remove(); return; }
    if (!n) {
      n = document.createElement('div');
      n.className = 'note';
      n.id = 'digwait';
      panel.insertBefore(n, panel.firstChild);
    }
    n.textContent = say || 'A summary is being written — a minute or two.';
  }

  function send(what){
    var fd = new FormData();
    fd.append('do', what);
    fd.append('id', panel.dataset.id);
    fd.append('lang', SUM_LANG);
    return fetch('/digest', {method:'POST', body:fd})
      .then(function(res){ if(!res.ok) return res.text().then(function(m){ throw new Error(m); }); return res.json(); });
  }

  var next = document.getElementById('dignext');
  var redo = document.getElementById('digretry');
  // Both taps are a couple of hundred items' worth of work before anything on
  // screen can change — next marks them read and reloads, retry starts a run —
  // so the controls go dead at once and the page cover goes up. Without it the
  // tap looks like it missed, and the next thing you do is tap it again.
  function busy(on, say){
    if (next) { next.disabled = on; if (say) next.textContent = say; }
    if (redo) redo.disabled = on;
    document.getElementById('loading').classList.toggle('hid', !on);
  }
  if (next) next.addEventListener('click', function(){
    busy(true, 'clearing…');
    send('next')
      .then(function(){ location.reload(); })
      .catch(function(err){ busy(false, 'next'); toast((err && err.message || '').trim() || 'could not clear that summary'); });
  });
  if (redo) redo.addEventListener('click', function(){
    busy(true);
    send('retry')
      // The cover comes down on the panel's own note, which takes over as the
      // indicator: the run is minutes long, and the page is yours again while
      // it goes.
      .then(function(){
        document.getElementById('loading').classList.add('hid');
        working(true, 'Writing this summary again — a minute or two. What is below is the old one until it lands.');
        watch();
      })
      .catch(function(err){ busy(false); toast((err && err.message || '').trim() || 'could not write that summary again'); });
  });

  // With nothing waiting, a run the last fetch started is what this page is
  // waiting for, so watch for it.
  //
  // With a digest on screen a run is worth saying so too: a retry survives the
  // page it was tapped on, and coming back to the same summary with nothing
  // moving is exactly the state that reads as a tap that went nowhere. Only
  // retry goes dead — it would be refused while a run is going — since next is
  // how the pile is read, and a fetch's own run is no reason to stop reading.
  if (note && note.dataset.running === '1') watch();
  else if (note) ask().then(function(j){ if (j && j.state === 'running') watch(); }).catch(function(){});
  else if (panel && panel.dataset.running === '1') {
    if (redo) redo.disabled = true;
    working(true);
    watch();
  }
})();

// Gist: the discussion under one Hacker News or reddit card. A story's item is
// a stub — the article's link and a count — a reddit post's is a title, and an
// HN comment's is one voice out of a room, so what the thread came to is the
// half of it the feed cannot carry. The button goes and gets the comments (all
// of them, replies included, from the service's own API) and hands them to the
// same worker the source briefings run on, so a thread and a backlog queue
// behind each other rather than racing.
//
// It lands under the footer that asked for it, inside the card, and the button
// then folds it away or offers to read the thread again: a briefing about one
// item belongs with that item, not in place of the feed the way a source's
// does.
(function(){
  var poll = null, getting = {};

  function buttons(){ return document.querySelectorAll('article.card button.gist'); }
  function cardOf(b){ return b.closest('article.card'); }
  function btn(card){ return card.querySelector(':scope > .footer > button.gist'); }
  function key(card){ return 'item:' + card.dataset.app + ':' + card.dataset.id; }
  function query(card){ return 'app=' + encodeURIComponent(card.dataset.app) + '&id=' + encodeURIComponent(card.dataset.id); }
  // Per language as well as per item, for the reason the source briefings are:
  // a summary is in the language it was written in, so the two are separate
  // things to have and switching back finds the earlier one still there.
  function slot(card){ return 'tui:gist:' + card.dataset.app + ':' + card.dataset.id + ':' + SUM_LANG; }
  function held(card){
    try { var raw = sessionStorage.getItem(slot(card)); return raw ? JSON.parse(raw) : null; }
    catch(e){ return null; }
  }
  function hold(card, d){
    try { sessionStorage.setItem(slot(card), JSON.stringify(d)); } catch(e){}
  }

  function state(card){ var b = btn(card); return b ? b.dataset.state : ''; }
  function setState(card, s){
    var b = btn(card);
    if (!b) return;
    b.dataset.state = s;
    b.textContent = s === 'running' ? 'reading…' : 'gist';
    b.title = s === 'running' ? 'reading the discussion…'
      : s === 'done' ? 'the discussion under this: hide it, or read the thread again'
      : 'summarize the discussion under this';
  }

  function box(card){
    var el = card.querySelector(':scope > .gistbox');
    if (el) return el;
    var foot = card.querySelector(':scope > .footer');
    if (!foot) return null;
    el = document.createElement('div');
    el.className = 'gistbox';
    foot.insertAdjacentElement('afterend', el);
    return el;
  }

  function waiting(card){
    var el = box(card);
    if (!el) return;
    el.textContent = '';
    el.classList.remove('hid');
    var note = document.createElement('div');
    note.className = 'gmeta';
    note.textContent = 'Reading the thread — this takes a minute or two.';
    el.appendChild(note);
  }

  function render(card, d){
    var el = box(card);
    if (!el) return;
    el.textContent = '';
    el.classList.remove('hid');
    var meta = document.createElement('div');
    meta.className = 'gmeta';
    var when = '';
    try { when = new Date(d.generated).toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'}); } catch(e){}
    var n = d.count || 0;
    meta.textContent = n + (n === 1 ? ' comment' : ' comments') + (when ? ', read ' + when : '');
    // Not class "rest": that is the card's own expand control, and this button
    // has no business unfolding the post it sits under.
    var again = document.createElement('button');
    again.type = 'button';
    again.className = 'gagain';
    again.textContent = 'again';
    again.title = 'summarize the discussion as it stands now';
    again.addEventListener('click', function(){ start(card); });
    meta.appendChild(again);
    var body = document.createElement('div');
    body.className = 'body';
    // Server-rendered from Markdown by the renderer the cards use, so the model's
    // output cannot bring HTML of its own with it.
    body.innerHTML = d.html;
    el.appendChild(meta);
    el.appendChild(body);
  }

  // Asking for a discussion takes the item out of the feed: the server has it in
  // the gist chip from here on, waiting with its thread rather than coming round
  // again before the reading is finished. The card left behind is marked the way
  // a read one is, so the counts and the deck agree with the server, and flagged
  // apart from one: it is not read, and moving on must not say it was. A card
  // already in the pile (the chip's own page, and its "again" button) is where it
  // belongs already.
  function setAside(card){
    if (GIST_PILE || card.dataset.gisting) return;
    card.dataset.gisting = '1';
    card.classList.add('read');
    decCount(1);
    decBulkCount(1);
    scheduleRecount();
  }
  // A thread nobody could read is no reason to lose the item: the server hands
  // it back to the feed when the reading fails, and the card here follows.
  function restore(card){
    if (!card.dataset.gisting) return;
    delete card.dataset.gisting;
    card.classList.remove('read');
    decCount(-1);
    decBulkCount(-1);
    scheduleRecount();
  }

  function start(card){
    if (state(card) === 'running') return;
    setState(card, 'running');
    waiting(card);
    var fd = new FormData();
    fd.append('app', card.dataset.app);
    fd.append('id', card.dataset.id);
    fd.append('lang', SUM_LANG);
    fetch('/summarize', {method:'POST', body:fd})
      .then(function(res){ if(!res.ok) return res.text().then(function(m){ throw new Error(m); }); return res.json(); })
      .then(function(){ setAside(card); watch(); })
      .catch(function(err){
        setState(card, held(card) ? 'done' : 'idle');
        restore(card);
        var el = card.querySelector(':scope > .gistbox');
        if (el) el.remove();
        toast((err && err.message || '').trim() || 'could not summarize that discussion');
      });
  }

  // The prose, once the job says there is some. open is for the card you are
  // sitting in front of waiting on; one that finished while you were elsewhere
  // fills its button in and waits to be asked.
  function collect(card, open){
    var k = key(card);
    if (getting[k]) return; // a poll every three seconds must not stack fetches
    getting[k] = 1;
    fetch('/summarize?' + query(card))
      .then(function(res){ if(!res.ok) throw 0; return res.json(); })
      .then(function(d){
        if (!d || !d.html) throw 0;
        if (d.lang && d.lang !== SUM_LANG) throw 0; // written in the other one
        hold(card, d);
        setState(card, 'done');
        if (open) render(card, d);
      })
      .catch(function(){
        setState(card, held(card) ? 'done' : 'idle');
      })
      .then(function(){ delete getting[k]; });
  }

  // What the server says about the cards on this page, folded into their
  // buttons. Returns whether any is still going, which is what decides whether
  // to keep asking. The map carries the source briefings too; a key that is not
  // a card here is not this loop's business.
  function sync(jobs){
    var going = false;
    buttons().forEach(function(b){
      var card = cardOf(b), j = jobs[key(card)], was = b.dataset.state;
      if (!j || (j.lang && j.lang !== SUM_LANG)){
        if (was === 'running') setState(card, held(card) ? 'done' : 'idle');
        return;
      }
      if (j.state === 'running'){ going = true; setState(card, 'running'); return; }
      if (j.state === 'done'){
        if (was !== 'done') collect(card, was === 'running');
        return;
      }
      if (was === 'running'){
        setState(card, held(card) ? 'done' : 'idle');
        restore(card);
        var el = card.querySelector(':scope > .gistbox');
        if (el) el.remove();
        toast(j.error || 'could not summarize that discussion');
      }
    });
    return going;
  }

  function watch(){
    if (poll) return;
    poll = setInterval(function(){
      fetch('/summarize')
        .then(function(res){ return res.json(); })
        .then(function(d){
          if (sync((d && d.jobs) || {})) return;
          clearInterval(poll); poll = null;
        })
        .catch(function(){});
    }, 3000);
  }

  document.addEventListener('click', function(e){
    var b = e.target.closest ? e.target.closest('button.gist') : null;
    if (!b) return;
    var card = cardOf(b);
    if (b.dataset.state === 'idle'){ start(card); return; }
    if (b.dataset.state === 'running'){ waiting(card); return; }
    var el = card.querySelector(':scope > .gistbox');
    // A summary that is already on screen: the thread has probably moved on
    // since it was written, so the button offers to read it again rather than
    // only folding it away. Asking costs a trip to the service and a minute of
    // the model, which is why it asks first; saying no folds it, which is what
    // the button did before there was anything to ask.
    if (el && !el.classList.contains('hid')){
      if (window.confirm('Read this discussion again? The gist below is replaced by what the thread says now.')) start(card);
      else el.classList.add('hid');
      return;
    }
    var d = held(card);
    if (d && d.html){ render(card, d); return; }
    collect(card, true);
  });

  if (!buttons().length) return;

  // What this tab already holds settles the buttons before the server is asked,
  // and the server settles the rest: a run started here and left, or one asked
  // for from another tab.
  buttons().forEach(function(b){ if (held(cardOf(b))) setState(cardOf(b), 'done'); });
  fetch('/summarize')
    .then(function(res){ return res.json(); })
    .then(function(d){ if (sync((d && d.jobs) || {})) watch(); })
    .catch(function(){});

  // The gist chip: a page of nothing but items whose discussion has already
  // been read, so every one of them opens on arrival. Waiting a minute for a
  // thread is what the chip exists to save you from — having to tap each card
  // once more, having got here, would be the same wait in another shape.
  if (GIST_PILE) buttons().forEach(function(b){
    var card = cardOf(b);
    var d = held(card);
    if (d && d.html) render(card, d);
    // The ones still being read have nothing to open yet; their buttons say so,
    // and the poll brings them in as they land.
    else if (card.dataset.gistready) collect(card, true);
  });

  // The language setting changed. Nothing already written is rewritten, so the
  // buttons re-read themselves against what is held for the language now in
  // hand, and anything on screen in the language you have just left goes away.
  document.addEventListener('tui:sumlang', function(){
    buttons().forEach(function(b){
      var card = cardOf(b);
      var el = card.querySelector(':scope > .gistbox');
      if (el) el.remove();
      if (b.dataset.state !== 'running') setState(card, held(card) ? 'done' : 'idle');
    });
  });
})();

// The block list, edited in the browser's own <dialog>: a textarea of one
// keyword per line, which is the shape the list already has, so there is
// nothing to add or delete a row at a time. Cancel puts back what the server
// sent rather than keeping a half-edit for the next open, and a save reloads —
// the words change the counts in the header and the rows on the page, and the
// server is the one that knows what they came to.
(function(){
  var dlg = document.getElementById('kwdlg'), open = document.getElementById('kwopen');
  if (!dlg || !open) return;
  var text = document.getElementById('kwtext');
  var sent = text.value;
  open.addEventListener('click', function(){ dlg.showModal(); });
  dlg.addEventListener('close', function(){
    if (dlg.returnValue !== 'save'){ text.value = sent; return; }
    var fd = new FormData();
    fd.append('words', text.value);
    fetch('/keywords', {method:'POST', body:fd})
      .then(function(res){ if(!res.ok) return res.text().then(function(m){ throw new Error(m); }); return res.json(); })
      .then(function(){ location.reload(); })
      .catch(function(err){ toast((err && err.message || '').trim() || 'could not save the keywords'); });
  });
})();

// The chips, on the feed as well as the saved list. One is on at a time and
// picking it is a page load of that chip's items alone, so each chip is a plain
// link — the server does the narrowing, and x's For You (which is scraped, not
// cached) can be a chip like any other. The click is still intercepted, because
// leaving the page is exactly when a mark that hasn't reached the server yet
// would be lost.
(function(){
  ['filters','subs'].forEach(function(id){
    var bar = document.getElementById(id);
    if (!bar) return;
    bar.addEventListener('click', function(e){
      var a = e.target.closest ? e.target.closest('a.fchip') : null;
      if (!a || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button) return;
      e.preventDefault();
      leaveFor(a.getAttribute('href'));
    });
  });
})();

// The subcategory row is kept to a single line: a source can carry dozens of
// them, and a block of chips that pushes the first card off the screen is worse
// than not offering the narrowing at all. Which ones fit is a question only the
// laid-out page can answer, so the server sends them all, busiest first, and
// this hides whatever wrapped — behind a "more" that has to fit on the line too,
// which is why the trim runs until the button lands back on the first row.
(function(){
  var bar = document.getElementById('subs');
  if (!bar) return;
  var more = document.getElementById('fmore');
  var chips = Array.prototype.slice.call(bar.querySelectorAll('a.fchip'));
  if (!chips.length) return;
  var open = false;
  // Expanding is a choice about this page, so it sticks until it is taken back:
  // the button that opened the row is the one that closes it again.
  function expand(forced){
    open = true;
    chips.forEach(function(c){ c.classList.remove('hid'); });
    // Forced open because the chip that is on would have been hidden: there is
    // no collapsing back to a row that denies the page you are looking at, so
    // don't offer it.
    if (forced){ more.classList.add('hid'); return; }
    more.classList.remove('hid');
    more.textContent = 'less';
    more.title = 'back to one row';
  }
  function layout(){
    if (open) return;
    chips.forEach(function(c){ c.classList.remove('hid'); });
    more.classList.remove('hid');
    more.textContent = 'more'; // a width to measure against; the count comes below
    var top = chips[0].offsetTop, cut = chips.length;
    for (var i = 0; i < chips.length; i++){
      if (chips[i].offsetTop > top){ cut = i; break; }
    }
    if (cut === chips.length && more.offsetTop <= top){ more.classList.add('hid'); return; }
    for (var j = cut; j < chips.length; j++) chips[j].classList.add('hid');
    while (cut > 1 && more.offsetTop > top){ cut--; chips[cut].classList.add('hid'); }
    // The chip that is on says what you are looking at; hiding it would leave
    // the row denying the page it belongs to.
    for (var k = cut; k < chips.length; k++){
      if (chips[k].dataset.on === '1'){ expand(true); return; }
    }
    more.textContent = '+' + (chips.length - cut) + ' more';
    more.title = 'show the rest of them';
  }
  more.addEventListener('click', function(){
    if (open){ open = false; layout(); return; }
    expand(false);
  });
  // Open by default: the narrowing is the point of the row, so show it all and
  // let "less" put it back. The layout pass still runs first, to learn whether
  // there is anything to expand at all.
  layout();
  if (!more.classList.contains('hid')) expand(false);
  window.addEventListener('resize', layout);
})();

// The order and layout toggles: each a link to this same page the other way
// round, so the sorting and the laying out stay the server's over the whole
// backlog rather than this page's over the window of it that got sent. The URL
// each goes to names what it picked, and the script in the head files that away
// as what this browser wants from here on. Both leave through leaveFor, because
// a queued read that hasn't reached the server yet would be lost otherwise.
['sortlink', 'decklink', 'savedmode'].forEach(function(id){
  var a = document.getElementById(id);
  if (!a) return;
  a.addEventListener('click', function(e){
    if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button) return;
    e.preventDefault();
    leaveFor(a.getAttribute('href'));
  });
});

document.addEventListener('click', function(e){
  var b = e.target.closest ? e.target.closest('button.detail') : null;
  if (!b) return;
  var card = b.closest('article.card');
  var compact = card.classList.toggle('compact');
  b.textContent = compact ? 'details' : 'compact';
  b.title = compact ? 'show this saved item in full' : 'return this saved item to compact view';
  if (!compact) return;
  card.querySelectorAll('video, audio').forEach(function(m){ m.pause(); });
  card.querySelectorAll('.yt-embed').forEach(function(w){
    if (w._ytPlayer && w._ytPlayer.pauseVideo) w._ytPlayer.pauseVideo();
  });
});
</script>
</div></body></html>
{{define "card"}}<article class="card{{if .Read}} read{{end}}{{if .Compact}} compact{{end}}{{if and .Compact .ShowActions}} expandable{{end}}" data-app="{{.App}}" data-id="{{.ID}}" data-type="{{.Type}}" data-sub="{{.Source}}"{{if .RankKey}} data-rank="{{.RankKey}}"{{end}}{{if .Gisted}} data-gistready="1"{{end}}{{if .YouTube}} data-yt="{{.YouTube}}"{{end}}{{if .Matched}} data-mine="mine"{{end}}{{if .Read}} data-history="1"{{end}}{{if .PosSrc}} data-pos="{{.Pos}}" data-pos-key="{{.PosSrc}}"{{end}}><div class="meta"><span class="chip" style="background:{{.Color}}">{{.Chip}}</span>{{if .Source}}<span class="src">{{.Source}}</span>{{end}}{{if .Author}}<span class="dot">·</span><span>{{.Author}}</span>{{end}}{{if .Age}}<span class="dot">·</span><span>{{.Age}}</span>{{end}}{{if .Keyword}}<span class="kw" title="the keyword that blocked this">{{.Keyword}}</span>{{end}}{{if .Worth}}<span class="kw" title="how likely the sift thought you would want this, from 0 to 1">{{.Worth}}</span>{{end}}{{if .MatchedFor}}<span class="kw" title="the subject on your list this answers">{{.MatchedFor}}</span>{{end}}</div><div class="preview">{{if .ListTitle}}<div class="ctitle compact-only">{{.ListTitle}}</div>{{end}}{{if .Title}}<div class="ctitle">{{.Title}}</div>{{end}}{{if .PreviewBody}}<div class="body">{{.PreviewBody}}</div>{{end}}</div>{{if .ShowActions}}<div class="full hid">{{if .Title}}<div class="ctitle">{{.Title}}</div>{{end}}{{if .FullBody}}<div class="body">{{.FullBody}}</div>{{end}}</div>{{end}}{{if .Video}}<div class="vidbox"><video class="vid" controls playsinline muted preload="none"{{if .Poster}} poster="{{.Poster}}"{{end}} src="{{.Video}}"></video>{{if .VidLen}}<span class="vlen">{{.VidLen}}</span>{{end}}</div>{{end}}{{if .Audio}}<audio class="aud" controls preload="metadata" src="{{.Audio}}"></audio>{{end}}{{if .Images}}<div class="imgbox hid">{{range .Images}}<img data-src="{{.}}" alt="" loading="lazy">{{end}}</div>{{end}}{{with .Quote}}<blockquote class="quote"><div class="qmeta">{{if .URL}}<a class="qsrc" href="{{.URL}}" target="_blank" rel="noopener" title="open the quoted post">{{.Source}} ↗</a>{{else}}<span class="qsrc">{{.Source}}</span>{{end}}{{if .Author}}<span class="dot">·</span><span>{{.Author}}</span>{{end}}</div>{{if .PreviewBody}}<div class="preview"><div class="body">{{.PreviewBody}}</div></div><div class="full hid"><div class="body">{{.FullBody}}</div></div>{{end}}{{if .Images}}<div class="imgbox hid">{{range .Images}}<img data-src="{{.}}" alt="" loading="lazy">{{end}}</div>{{end}}{{if .Video}}<div class="vidbox"><video class="vid" controls playsinline muted preload="none"{{if .Poster}} poster="{{.Poster}}"{{end}} src="{{.Video}}"></video>{{if .VidLen}}<span class="vlen">{{.VidLen}}</span>{{end}}</div><a class="open" href="/dl?n=x-{{$.ID}}-quote.mp4&u={{.Video}}" title="download the quoted video"><span>keep</span></a>{{end}}</blockquote>{{end}}<div class="footer">{{if .URL}}<a class="open" href="{{.URL}}" target="_blank" rel="noopener" title="open original"><span>open</span></a>{{end}}{{if .ShowActions}}<button class="save" type="button" data-saved="{{if .Saved}}1{{else}}0{{end}}" title="keep this item in the saved list">{{if .Saved}}saved{{else}}save{{end}}</button><button class="share" type="button" title="share this item">share</button>{{if .Link}}<a class="open" href="{{.Link}}" title="this item on a page of its own"><span>link</span></a>{{end}}{{if .Compact}}<button class="detail" type="button" title="show this saved item in full">details</button>{{end}}{{if .HasVideo}}<button class="speed" type="button" title="playback speed for every player">2×</button><button class="mute" type="button" title="sound for this item">unmute</button><button class="rot" type="button" title="rotated fullscreen">rotate</button>{{else if .Audio}}<button class="speed" type="button" title="playback speed for every player">2×</button><button class="mute" type="button" title="sound for this item">unmute</button>{{end}}{{if .HasImage}}<button class="img" type="button" data-on="0" title="show the attached images">image</button>{{end}}{{if .RedGif}}<button class="rgv" type="button" data-on="0" data-id="{{.RedGif}}" title="show the linked redgifs clip">video</button>{{end}}{{if .Keep}}<a class="open" href="{{.Keep}}" title="download video"><span>keep</span></a>{{end}}{{if .HasVideo}}<button class="loop" type="button" data-on="0" title="repeat every video">loop</button>{{end}}{{if .Gist}}<button class="gist" type="button" data-state="idle" title="summarize the discussion under this">gist</button>{{end}}{{if .Expand}}<button class="expand hid" type="button">less</button>{{end}}{{end}}</div></article>{{end}}
