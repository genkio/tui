<!doctype html>
<html lang="en"><head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="referrer" content="no-referrer">
<script>
// Which way the feed runs, whether it is a list or a deck, and how saved items
// are laid out are this browser's to remember. The server does the sorting and
// laying out because a page carries a window of the backlog; rearranging cards
// already here would work on a slice rather than the feed. These choices live
// in the URL. localStorage supplies a remembered choice when the URL names
// none; an explicit URL replaces the remembered choice. All preferences settle
// in one pass, so restoration redirects at most once.
//
// The server defaults to the list and full saved cards, so only remembered
// alternatives need a redirect. A browser with nothing remembered yet gets one
// guess from the device it is: a coarse pointer is a thumb, and a thumb wants a
// card at a time. Guessing once beats a flag on the server, which could only
// ever be right about one of the devices reading the same feed.
(function(){
  try{
    var u = new URL(location.href);
    if (u.pathname !== '/') return;
    function redirect(){ location.replace(u.toString()); }
    var moved = false;
    if (u.searchParams.get('saved') === '1'){
      var compact = u.searchParams.get('compact');
      if (compact === '1' || compact === '0') localStorage.setItem('tui:saved-compact', compact);
      else if (localStorage.getItem('tui:saved-compact') === '1'){
        u.searchParams.set('compact', '1'); moved = true;
      }
      if (moved) redirect();
      return;
    }
    if (u.searchParams.get('blocked') === '1') return;
    // In the list a card is marked read by scrolling past it, which makes where
    // the page starts ours rather than the browser's to restore: Firefox puts a
    // reload back at the old offset, and every card above it would then be
    // reported as scrolled past by an observer that never saw you scroll. Start
    // at the top, where what is left of the list begins.
    if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
    var order = u.searchParams.get('order');
    if (order === 'asc' || order === 'desc') localStorage.setItem('tui:order', order);
    else if (localStorage.getItem('tui:order') === 'desc'){ u.searchParams.set('order', 'desc'); moved = true; }
    var deck = u.searchParams.get('deck');
    if (deck === '1' || deck === '0') localStorage.setItem('tui:deck', deck);
    else {
      var kept = localStorage.getItem('tui:deck');
      if (kept !== '1' && kept !== '0' && matchMedia('(pointer: coarse)').matches) kept = '1';
      if (kept === '1'){ u.searchParams.set('deck', '1'); moved = true; }
    }
    if (moved) redirect();
  }catch(e){}
})();
</script>
<title>all — tui</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><text y='13' font-size='12'>🗞️</text></svg>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#111318; --card:#181c23; --line:#262b34; --fg:#e6e9ee;
  --muted:#949ba8; --accent:#4a9eff; --ok:#3fb950; --bad:#f85149;
}
@media (prefers-color-scheme: light){
  :root{ --bg:#f6f7f9; --card:#ffffff; --line:#e3e6eb; --fg:#1b1f26; --muted:#6b7280; --accent:#1a73e8; --bad:#d64545; }
}
*{box-sizing:border-box}
html,body{margin:0;padding:0}
body{
  background:var(--bg); color:var(--fg);
  font:16px/1.55 "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  -webkit-text-size-adjust:100%;
}
.wrap{max-width:640px;margin:0 auto;padding:14px 14px 40px}
header{
  position:sticky;top:0;z-index:10;background:var(--bg);
  display:flex;align-items:center;gap:10px;padding:12px 2px 10px;
  border-bottom:1px solid var(--line);margin-bottom:12px;
}
h1{font-size:20px;margin:0;font-weight:700;letter-spacing:-.02em}
/* the counts take the room the controls at the far end leave, and give it back
   by cropping themselves rather than pushing them off */
.sub{flex:1;min-width:0;color:var(--muted);font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.warn{background:rgba(214,69,69,.12);border:1px solid rgba(214,69,69,.5);color:var(--fg);border-radius:10px;padding:10px 12px;margin:-4px 0 12px;font-size:14px}
.card{
  background:var(--card);border:1px solid var(--line);border-radius:14px;
  padding:14px 16px;margin-bottom:12px;
}
.ctitle{font-size:17px;line-height:1.35;font-weight:650;color:var(--fg)}
#state[data-blockedview="true"]+.wrap .ctitle{font-weight:400}
.compact-only{display:none}
.card.compact.expandable>.preview>.ctitle:not(.compact-only),
.card.compact.expandable>.preview>.body,
.card.compact.expandable>.full,
.card.compact.expandable>.vidbox,
.card.compact.expandable>.aud,
.card.compact.expandable>.imgbox,
.card.compact.expandable>.quote,
.card.compact.expandable>.yt,
.card.compact.expandable>.yt-embed,
.card.compact.expandable>.yt-blocked{display:none}
.card.compact.expandable .compact-only{display:block}
.card.compact[data-app="x"] .ctitle{
  display:-webkit-box;overflow:hidden;-webkit-box-orient:vertical;-webkit-line-clamp:3;
  font-size:15px;font-weight:400;white-space:pre-wrap;word-break:break-word;
}
.meta{display:flex;align-items:center;gap:8px;margin-top:8px;font-size:13px;color:var(--muted);flex-wrap:wrap}
.chip{font-weight:700;padding:1px 8px;border-radius:999px;font-size:12px;color:#fff}
.src{font-weight:600;color:var(--fg)}
.dot{opacity:.5}
.body{margin:8px 0 4px;color:var(--fg);white-space:normal;overflow-wrap:anywhere;font-size:15px}
.body .link{color:var(--accent);text-decoration:underline;word-break:break-all}
.body>:first-child{margin-top:0}
.body>:last-child{margin-bottom:0}
.body p{margin:8px 0}
.body h1,.body h2,.body h3,.body h4,.body h5,.body h6{
  margin:14px 0 6px;font-size:16px;line-height:1.35;letter-spacing:0;
}
.body .table-scroll{width:100%;margin:12px 0;overflow-x:auto;overscroll-behavior-x:contain}
.body table{width:max-content;min-width:100%;border-collapse:collapse;font-size:13px;white-space:normal}
.body th,.body td{min-width:96px;padding:6px 8px;border:1px solid var(--line);vertical-align:top}
.body th{background:var(--bg);font-weight:700}
.body code{padding:1px 4px;border-radius:4px;background:var(--bg);font-size:.9em}
/* how much text the ellipsis is hiding, and the control that reveals it */
.rest{
  margin-left:5px;padding:0;border:0;background:none;font-family:inherit;font-size:13px;font-weight:600;
  color:var(--accent);white-space:nowrap;cursor:pointer;text-decoration:underline;text-underline-offset:2px;
}
/* the embedded post (x's quote box): inset and dimmed so it reads as context,
   not as the post you're on */
.quote{margin:10px 0 2px;padding:10px 12px;border:1px solid var(--line);border-radius:12px;background:rgba(128,128,128,.07)}
.qmeta{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--muted);flex-wrap:wrap}
.qsrc{color:var(--muted);font-weight:600;text-decoration:none}
/* attached stills stay collapsed until the footer's image toggle asks for them,
   so a feed of photo posts is scannable and costs no bandwidth unopened */
.imgbox{margin:10px 0 2px;display:flex;flex-direction:column;gap:8px}
.imgbox img{display:block;width:100%;border-radius:12px;background:var(--line)}
.img[data-on="1"]{color:var(--accent)}
.quote .body{margin:6px 0 0;font-size:14px;color:var(--muted)}
.quote .vidbox{margin-bottom:0}
.quote .vid{max-height:50vh}
.quote .open{font-size:13px;min-height:32px}
/* A row of chips over the first card, grouped by axis: which service it came
   from, what it carries. One is on at a time, and picking it loads a page of
   its items alone, so each chip is a link rather than a switch.
   The groups are display:contents so every chip is a flex item of the one row
   and they fill it as they come — a nested flex box per group would break the
   line at the group boundary and leave the rest of it empty. */
.filters{display:flex;flex-wrap:wrap;align-items:center;gap:6px;margin:0 0 12px}
.fgroup{display:contents}
/* groups are set apart by a wider gap, not a rule: the row wraps as chips are
   added, and a rule at the start of a wrapped line reads as a stray mark */
.fgroup+.fgroup>.fchip:first-child{margin-left:8px}
.filtersep{color:var(--line);font-size:16px;margin:0 2px}
.fchip{
  display:inline-flex;align-items:center;gap:5px;cursor:pointer;
  background:var(--card);border:1px solid var(--line);border-radius:999px;
  padding:3px 9px;min-height:32px;color:var(--muted);
  font:inherit;font-size:13px;font-weight:600;text-decoration:none;
}
.fchip[data-on="1"]{border-color:var(--accent);color:var(--fg)}
.fchip .fn{font-variant-numeric:tabular-nums;opacity:.65}
/* a source chip's count is that service's status light too, which is what the
   header's separate row of dots used to be: green means the last sweep of it
   worked, red means it didn't and this number is stale */
.fchip .fn.ok{color:var(--ok);opacity:1}
.fchip .fn.bad{color:var(--bad);opacity:1}
.fclear{margin-left:auto;color:var(--accent)}
/* the second layer, under the source row: which subreddit, which rss feed. Only
   the busiest of them fit — a source can have dozens, and a wall of them would
   push the first card off the screen — so the script keeps one row and the rest
   are behind "more". Pulled up tight against the row it narrows, so the two read
   as one control rather than two. */
.subs{margin-top:-6px}
/* a feed title runs as long as its owner felt like; the chip is capped and the
   whole of it stays in the tooltip */
.subs .slabel{max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.fmore{color:var(--accent)}
.card.read{opacity:.45}
/* The unread count opens browser-local settings without adding another header
   control to the narrow row. */
.settings{
  padding:0;border:0;background:none;font:inherit;color:inherit;cursor:pointer;
}
.settings .upd{opacity:.6}
/* a card with a player carries most of a dozen actions, more than a phone is
   wide: the row scrolls sideways rather than wrapping into a second line that
   would push the next card down */
.footer{
  display:flex;align-items:center;gap:18px;margin-top:12px;
  overflow-x:auto;overscroll-behavior-x:contain;scrollbar-width:none;
  touch-action:pan-x; /* sideways here is the row's, not the deck's */
}
.footer::-webkit-scrollbar{display:none}
.footer>*{flex:none}
.markall{
  display:block;width:100%;margin:20px 0 0;padding:14px;
  background:var(--card);border:1px dashed var(--line);color:var(--accent);
  border-radius:14px;font-size:15px;font-weight:700;cursor:pointer;min-height:48px;
}
.markall:disabled{opacity:.5;cursor:default}
/* why the button's number is smaller than the header's: the page carries a
   window of the backlog, and this is the rest of it */
.markall .behind{font-weight:600;font-size:12px;color:var(--muted);margin-left:6px}
/* The deck's single-item and bulk read actions sit under either thumb. */
.markall.fab{
  position:fixed;z-index:20;margin:0;
  bottom:calc(14px + env(safe-area-inset-bottom));
  width:52px;height:52px;min-height:0;padding:0;
  display:flex;align-items:center;justify-content:center;
  border:1px solid var(--line);border-radius:999px;
  box-shadow:0 6px 18px rgba(0,0,0,.3);color:var(--muted);opacity:.5;
}
.markall.fab#markAll{right:14px}
.markall.fab svg{display:block;height:22px;width:auto}
.markall.hid{display:none} /* .hid alone loses to .markall.fab */
.deckfeedback{
  position:fixed;z-index:20;top:50%;left:max(-8px,calc(50% - 328px));
  display:flex;flex-direction:column;transform:translateY(-50%);
}
.deckfeedback.right{left:auto;right:max(-8px,calc(50% - 328px))}
.feedbackbtn{
  width:44px;height:52px;padding:0;display:flex;align-items:center;justify-content:center;
  border:0;background:transparent;color:var(--muted);cursor:pointer;opacity:.5;
  font-size:28px;font-weight:400;line-height:1;transition:opacity .12s,color .12s,transform .12s;
}
.feedbackbtn.chosen{color:var(--accent);opacity:.9;transform:scale(1.08)}
.feedbackbtn#thumbUp{font-size:23px}
.feedbackbtn:disabled{opacity:.18;cursor:default}
.deckfeedback.hid{display:none}
.open{color:var(--accent);text-decoration:none;font-weight:600;font-size:14px;min-height:40px;display:inline-flex;align-items:center;gap:4px}
.expand{background:none;border:none;color:var(--muted);font-size:14px;cursor:pointer;padding:0;min-height:40px}
.speed,.mute,.rot,.save,.img,.share,.rgv,.loop,.detail,.deckback{background:none;border:none;color:var(--muted);font-size:14px;font-weight:700;cursor:pointer;padding:0;min-height:40px}
.deckback:disabled{opacity:.35;cursor:default}
.rgv:disabled{opacity:.6;cursor:default}
.rgv[data-on="1"]{color:var(--accent)}
.loop[data-on="1"]{color:var(--accent)}
.save[data-saved="1"]{color:var(--accent)}
.tagrow{display:flex;flex-wrap:wrap;gap:6px;margin-top:14px;padding-top:12px;border-top:1px solid var(--line)}
.itemtag{
  min-height:30px;padding:3px 9px;border:1px solid var(--line);border-radius:999px;
  background:transparent;color:var(--muted);font:inherit;font-size:12px;font-weight:600;cursor:pointer;
}
.itemtag[data-on="1"]{border-color:var(--accent);color:var(--accent);background:rgba(74,158,255,.08)}
.itemtag:disabled{opacity:.5;cursor:default}
.viewlink{color:var(--muted);text-decoration:none;border-bottom:1px dotted var(--line)}
/* which way the feed runs and which shape it is in, at the far end of the
   header: each word is what the page already is, and the tap turns it around.
   They keep their width while the counts beside them are free to ellipsis,
   since a header narrow enough to crop something should crop the numbers
   rather than the only controls there. */
.sortlink,.decklink{
  flex:none;display:inline-flex;align-items:center;gap:4px;
  color:var(--muted);font-size:13px;white-space:nowrap;text-decoration:none;
  border-bottom:1px dotted var(--line);
}
.sortlink .sarrow,.decklink .dmark{font-size:12px;opacity:.7}
button.headbutton{padding:0;background:none;border:0;border-bottom:1px dotted var(--line);font-family:inherit;font-size:13px;cursor:pointer}
/* the keywords link is a button (it opens a dialog, it doesn't go anywhere),
   so it has to be talked back into looking like the links beside it */
button.viewlink{background:none;border:0;border-bottom:1px dotted var(--line);padding:0;font:inherit;cursor:pointer}
/* which word caught a blocked post, on its row: the list's whole job is to be
   scanned, so this reads as a tag rather than as more of the post */
.kw{padding:0 7px;border-radius:999px;border:1px solid var(--line);font-size:12px;font-weight:600}
/* the block list, edited in the browser's own modal */
.kwdlg{
  width:min(92vw,460px);padding:16px;color:var(--fg);background:var(--card);
  border:1px solid var(--line);border-radius:14px;font:inherit;
}
.kwdlg::backdrop{background:rgba(0,0,0,.55)}
.kwdlg h2{margin:0 0 6px;font-size:17px;font-weight:700;letter-spacing:-.02em}
.kwdlg .kwhelp{margin:0 0 10px;color:var(--muted);font-size:13px;line-height:1.45}
/* 16px, not the 14px the rest of this dialog is set in: mobile Safari zooms the
   page into any text field it focuses that is set smaller, and the way out of
   that is a readable field, not a viewport that refuses to be pinched */
.kwdlg textarea{
  display:block;width:100%;padding:10px;color:var(--fg);background:var(--bg);
  border:1px solid var(--line);border-radius:10px;resize:vertical;
  font:16px/1.6 ui-monospace,SFMono-Regular,Menlo,monospace;
}
.kwdlg menu{display:flex;justify-content:flex-end;gap:10px;margin:12px 0 0;padding:0}
.kwdlg menu button{
  padding:8px 14px;min-height:40px;cursor:pointer;font:inherit;font-size:14px;font-weight:600;
  color:var(--muted);background:var(--card);border:1px solid var(--line);border-radius:10px;
}
.kwdlg menu button#kwsave{color:var(--accent);border-color:var(--accent)}
.settingrow{display:flex;align-items:center;justify-content:space-between;gap:18px;min-height:44px;font-size:14px;font-weight:600}
.settingrow input{width:20px;height:20px;margin:0;accent-color:var(--accent)}
.hid{display:none}
.empty{color:var(--muted);font-style:italic}
.note{padding:16px;color:var(--muted);border:1px dashed var(--line);border-radius:12px;font-size:15px}
.note a{color:var(--accent);font-weight:600;text-decoration:none}
.note.offer{margin-top:10px}
/* a feed page is fetched before it is sent, so a tap that refetches leaves the
   old page on screen with nothing happening; cover it while the wait runs */
.loading{
  position:fixed;inset:0;z-index:50;display:flex;align-items:center;justify-content:center;
  background:rgba(0,0,0,.5);color:#fff;font-size:15px;font-weight:600;
}
.loading.hid{display:none} /* .hid alone loses to .loading */
.loading span{animation:pulse 1.1s ease-in-out infinite}
@keyframes pulse{0%,100%{opacity:.45}50%{opacity:1}}
@media (prefers-color-scheme: light){
  .loading{background:rgba(246,247,249,.75);color:var(--fg)}
}
.toast{
  position:fixed;left:50%;bottom:calc(18px + env(safe-area-inset-bottom));transform:translateX(-50%);
  background:var(--fg);color:var(--bg);font-size:14px;font-weight:600;
  padding:8px 16px;border-radius:999px;opacity:0;pointer-events:none;transition:opacity .2s;
  z-index:60; /* the deck's floating mark-all sits down here too */
  max-width:min(88vw,380px);text-align:center;line-height:1.35;
}
.yt{position:relative;margin:10px 0 2px;border-radius:12px;overflow:hidden;cursor:pointer;aspect-ratio:16/9;background:#000}
.yt img{width:100%;height:100%;object-fit:cover;display:block;opacity:.85}
.yt .yt-play{
  position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
  font-size:26px;color:#fff;background:rgba(0,0,0,.25);text-shadow:0 1px 8px rgba(0,0,0,.6);
}
.yt-embed{aspect-ratio:16/9;margin:10px 0 2px}
.yt-embed iframe{display:block;width:100%;height:100%;border:0;border-radius:12px}
.yt-blocked{display:block;margin:10px 0 2px;padding:14px;border:1px dashed var(--line);border-radius:12px;color:var(--accent);font-size:14px;font-weight:600;text-decoration:none}
html.ffs-on,html.ffs-on body{overflow-x:hidden;background:#000 !important}
/* guarantee scroll room while rotated: Safari only hides its bars when a swipe
   actually scrolls, and a short or bottomed-out feed otherwise has nowhere to go */
html.ffs-on body{padding-bottom:100lvh}
/* iOS lays out fixed elements against the bars-visible viewport, so the player
   can't cover the status-bar strip or the area around the bottom address bar;
   blank the feed instead so every uncovered edge is seamless black */
html.ffs-on .wrap{visibility:hidden}
.ffs{
  position:fixed !important;top:50vh !important;left:50vw !important;
  top:50lvh !important;left:50lvw !important;
  width:100vh !important;height:100vw !important;
  width:100lvh !important;height:100lvw !important;
  max-height:none !important;margin:0 !important;
  transform:translate(-50%,-50%) rotate(-90deg) !important;transform-origin:center !important;
  border-radius:0 !important;background:#000 !important;
  z-index:2147483646 !important;overflow:hidden !important;
  touch-action:pan-y !important; /* vertical swipes scroll the page, letting mobile Safari hide its bars */
  visibility:visible !important; /* the player lives inside the hidden .wrap */
}
video.ffs{object-fit:cover !important}
.ffs iframe{display:block !important;width:100% !important;height:100% !important;border-radius:0 !important}
.ffs-tap{position:fixed;inset:0;z-index:2147483646;background:transparent;touch-action:manipulation;-webkit-tap-highlight-color:transparent}
.ffs-exit{
  position:fixed;top:max(16px,env(safe-area-inset-top));right:max(16px,env(safe-area-inset-right));
  width:44px;height:44px;border:0;border-radius:50%;padding:0;color:#fff;background:rgba(0,0,0,.65);
  font:24px/44px -apple-system,system-ui,sans-serif;text-align:center;cursor:pointer;
  z-index:2147483647;transform:rotate(-90deg);-webkit-tap-highlight-color:transparent;
}
/* Swipe mode: the feed becomes a deck. One card is on screen at a time, sized
   to the viewport and scrolling inside its own frame, with two empty offset
   cards drawn behind it so the stack reads as "more where that came from". */
/* the deck starts where the chips end, rather than floating in the middle of
   what's left of the screen: centring put a short card a long way down, and
   moved every card as the next one's height changed. Top-aligned, the card's
   top edge stays put across a whole swipe session, and one taller than the
   screen simply scrolls instead of being clipped above the fold. */
.deckwrap{display:flex}
.deckwrap.hid{display:none}
.deckwrap .deck{width:100%;min-width:0}
.deck{position:relative}
.deck::before,.deck::after{
  content:'';position:absolute;left:0;right:0;top:0;bottom:0;
  background:var(--card);border:1px solid var(--line);border-radius:14px;z-index:-1;
}
.deck::before{transform:scale(.97) translateY(10px)}
.deck::after{transform:scale(.94) translateY(20px)}
.deck.last::before,.deck.last::after,.deck.last2::after{display:none}
.deck .card{
  margin-bottom:0;
  -webkit-tap-highlight-color:transparent;
}
.deck .card.read{opacity:1} /* a dealt card leaves the screen; no need to grey it */
.vidbox{position:relative;margin:10px 0 2px}
.vid{display:block;width:100%;max-height:70vh;border-radius:12px;background:#000}
/* a podcast episode: the browser's own audio bar, full width. Unlike video it
   preloads metadata, so the controls can state how long the episode runs before
   a tap starts it — the audio answer to the .vlen badge */
.aud{display:block;width:100%;margin:10px 0 2px}
/* how long the clip runs, over the poster: enough to judge a tap before any of
   it downloads (preload="none" means nothing has yet) */
.vlen{
  position:absolute;top:8px;left:8px;pointer-events:none;
  background:rgba(0,0,0,.72);color:#fff;font-size:12px;font-weight:700;
  padding:2px 7px;border-radius:6px;font-variant-numeric:tabular-nums;
}
</style>
</head><body>
<div id="state" data-savedview="{{if .SavedView}}true{{else}}false{{end}}" data-blockedview="{{if .BlockedView}}true{{else}}false{{end}}" data-swipe="{{if .Swipe}}true{{else}}false{{end}}" data-more="{{if .More}}true{{else}}false{{end}}" data-sel="{{.Sel}}" hidden></div>
<div class="wrap">
<header>
  <div class="sub" id="sub">{{if .BlockedView}}<a class="viewlink" href="/">unread</a> <span id="blockedn">{{.Blocked}}</span> blocked <button class="viewlink" id="kwopen" type="button" title="edit the blocked keywords"><span id="kwn">{{.Keywords}}</span> keywords</button>{{else if .SavedView}}<a class="viewlink" href="/">unread</a> <span id="savedn">{{.Saved}}</span> saved{{else}}{{if .HasApps}}<button class="settings" id="settingsOpen" type="button" title="settings"><span id="unreadn">{{.Unread}}</span>{{if .Capped}}+{{end}} unread{{if .Updated}} <span class="upd" id="upd">{{if .Fetching}}fetching…{{else}}{{.Updated}}{{end}}</span>{{end}}</button> {{end}}<a class="viewlink" href="/?saved=1"><span id="savedn">{{.Saved}}</span> saved</a> <a class="viewlink" href="/?blocked=1"><span id="blockedn">{{.Blocked}}</span> blocked</a>{{end}}</div>
  {{if .SavedModeHref}}<a class="decklink" id="savedmode" href="{{.SavedModeHref}}" title="{{if .SavedCompact}}title-only saved items — tap for full cards{{else}}full saved cards — tap for titles only{{end}}"><span class="dmark">{{if .SavedCompact}}≡{{else}}▤{{end}}</span>{{if .SavedCompact}}compact{{else}}full{{end}}</a>
  {{end}}{{if .ClearBlocked}}<button class="sortlink headbutton" id="clearBlocked" type="button" data-total="{{.Blocked}}" title="delete all stored blocked items">clear</button>
  {{end}}{{if .DeckHref}}<a class="decklink" id="decklink" href="{{.DeckHref}}" title="{{if .Swipe}}a deck, one card at a time — tap for the scrolling list{{else}}a scrolling list — tap for the swipe deck{{end}}"><span class="dmark">{{if .Swipe}}▭{{else}}▤{{end}}</span>{{if .Swipe}}deck{{else}}list{{end}}</a>
  {{end}}{{if .SortHref}}<a class="sortlink" id="sortlink" href="{{.SortHref}}" title="{{if .Asc}}oldest first — tap for newest first{{else}}newest first — tap for oldest first{{end}}"><span class="sarrow">{{if .Asc}}↑{{else}}↓{{end}}</span>{{if .Asc}}oldest{{else}}newest{{end}}</a>
  {{end}}</header>
{{if .Warn}}<div class="warn">⚠ {{.Warn}}</div>
{{end}}{{if or .Filters .TagFilters}}<div class="filters" id="filters">{{range .Filters}}<div class="fgroup">{{range .Chips}}<a class="fchip" href="{{.Href}}" data-kind="{{.Kind}}" data-key="{{.Key}}" data-on="{{if .On}}1{{else}}0{{end}}"{{if .Title}} title="{{.Title}}"{{end}}>{{if .Color}}<span class="chip" style="background:{{.Color}}">{{.Label}}</span>{{else}}<span>{{.Label}}</span>{{end}}{{if not .Uncounted}}<span class="fn{{if .State}} {{.State}}{{end}}">{{.Count}}</span>{{end}}</a>{{end}}</div>{{end}}{{if and .Filters .TagFilters}}<span class="filtersep">|</span>{{end}}{{if .TagFilters}}<span class="fgroup tagfilters" id="tagfilters">{{range .TagFilters}}<a class="fchip{{if .Hidden}} hid{{end}}" href="{{.Href}}" data-kind="tag" data-key="{{.Key}}" data-on="{{if .On}}1{{else}}0{{end}}"><span>{{.Label}}</span><span class="fn">{{.Count}}</span></a>{{end}}</span>{{end}}{{if .ClearHref}}<a class="fchip fclear" href="{{.ClearHref}}" id="fclear">clear</a>{{end}}</div>
{{end}}{{if .Subs}}<div class="filters subs" id="subs">{{range .Subs}}<a class="fchip" href="{{.Href}}" data-kind="sub" data-key="{{.Key}}" data-on="{{if .On}}1{{else}}0{{end}}" title="{{.Title}}"><span class="slabel">{{.Label}}</span><span class="fn">{{.Count}}</span></a>{{end}}<button class="fchip fmore hid" id="fmore" type="button" title="show the rest of them">more</button></div>
{{end}}{{if .BlockedView}}{{if not .Cards}}<div class="note">{{if .Sel}}Nothing blocked from that chip.{{else}}Nothing blocked yet. Add a <b>keyword</b> and any post whose title carries it is kept out of the feed and filed here instead.{{end}}</div>
{{end}}{{else if .SavedView}}{{if not .Cards}}<div class="note">{{if or .Sel .TagSelected}}Nothing saved from that chip.{{else}}Nothing saved yet. Tap <b>save</b> on any item to keep it here.{{end}}</div>
{{end}}{{else if not .HasApps}}<div class="note">No reader app is logged in. Run <code>tui &lt;app&gt; --auth</code> on the host, then refresh this page.</div>
{{else if not .Cards}}<div class="note">{{if .Sel}}Nothing unread from that chip.{{else}}Inbox zero across every timeline.{{end}}</div>
{{end}}{{if and .Swipe .Cards}}<div class="deckwrap"><div class="deck" id="deck">{{range .Cards}}{{template "card" .}}
{{end}}</div></div>
<div class="note hid" id="deckEnd">Deck's empty — that's every card.</div>
{{else}}{{range .Cards}}{{template "card" .}}
{{end}}{{end}}{{if and .Swipe .Cards}}<div id="deckFeedback" class="deckfeedback"><button id="thumbDown" class="feedbackbtn" type="button" title="not interested and show the next item" aria-label="not interested">-</button><button id="thumbUp" class="feedbackbtn" type="button" title="interested and show the next item" aria-label="interested">+</button></div>
{{end}}{{if and .Cards .BulkMark}}<button id="markAll" class="markall{{if .Swipe}} fab{{end}}" type="button" data-total="{{.Total}}"{{if .Swipe}} title="mark all {{.Total}} items in this feed read"{{end}}>{{if .Swipe}}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5L10 17.5L19 6.5"/></svg>{{else}}✓ mark all {{.Total}} read{{end}}</button>
{{end}}{{if .HasApps}}<dialog id="settingsdlg" class="kwdlg settingsdlg"><form method="dialog"><h2>settings</h2><label class="settingrow"><span>place feedback buttons on right</span><input id="feedbackRight" type="checkbox"></label><menu><button value="done">done</button></menu></form></dialog>
{{end}}{{if .BlockedView}}<dialog id="kwdlg" class="kwdlg"><form method="dialog"><h2>blocked keywords</h2><p class="kwhelp">One per line. A post whose <b>title</b> carries one of these — anywhere in it, upper or lower case — is kept out of the feed and filed here instead. A post with no title of its own (an x post) is never blocked. Saving also clears whatever the words catch in the backlog you already have.</p><textarea id="kwtext" rows="10" spellcheck="false" autocapitalize="none" autocorrect="off" autocomplete="off">{{.KeywordText}}</textarea><menu><button value="cancel">cancel</button><button id="kwsave" value="save">save</button></menu></form></dialog>
{{end}}<div id="toast" class="toast"></div>
<div id="loading" class="loading hid"><span>loading…</span></div>
<script>
// ?deck=1 serves the same cards as a deck: one on screen, thrown away by hand.
// Everything else on the page (video, images, save, share, expand) is shared
// between the two modes; only the layout and what marks a card read differ.
var SWIPE = document.getElementById('state').getAttribute('data-swipe') === 'true';
var MORE = document.getElementById('state').getAttribute('data-more') === 'true';
var FEEDBACK_RIGHT = false;
try { FEEDBACK_RIGHT = localStorage.getItem('tui:deck-feedback-right') === '1'; } catch(e){}
var FEEDBACK = {{.Feedback}};
var SAVED_TAGS = {{.SavedTags}};
var TAG_OPTIONS = {{.TagOptions}};
var SAVED_VIEW = document.getElementById('state').getAttribute('data-savedview') === 'true';
// The blocked list: rows the feed never carried, so nothing here is unread, and
// each one is a title alone rather than a card to play or expand.
var BLOCKED_VIEW = document.getElementById('state').getAttribute('data-blockedview') === 'true';
// Which chip is on ("app:x"), blank for the whole list. The page carries that
// chip's items and nothing else, which is what stops the recount below from
// speaking for the chips it cannot see.
var SEL = document.getElementById('state').getAttribute('data-sel') || '';
// Reading = scrolling: the moment a card is fully off-screen (its bottom edge
// clears the top of the viewport) it is marked read and muted in place — it
// stays in the list, greyed, so scrolling back up shows what you've read.
// Marks are batched per app so a fast scroll is one --mark-read call per app.
var pending = {};   // app -> ids marked read, awaiting a flush
var flushTimer = null;
var markFlights = Promise.resolve();
// /mark only writes the server's cache, so it answers at once. A request that
// hangs instead is the same trouble as one that is refused, and quieter about
// it, so cap the wait — a failure has to be noticed either way.
function markFetch(fd){
  var o = {method:'POST', body:fd};
  if(window.AbortSignal && AbortSignal.timeout) o.signal = AbortSignal.timeout(15000);
  return fetch('/mark', o);
}
// Returns when every mark it sent has landed, so a caller that is about to
// throw the page away (clearing the filters reloads) can wait for it first.
function flushPending(){
  flushTimer = null;
  var apps = Object.keys(pending);
  var dirty = apps.some(function(a){ return pending[a].length > 0; });
  if(!dirty) return markFlights;
  var calls = [], failed = false;
  apps.forEach(function(app){
    var ids = pending[app]; if(!ids.length) return;
    pending[app] = [];
    var fd = new FormData(); fd.append('app', app); fd.append('json','1');
    ids.forEach(function(id){ fd.append('id', id); });
    calls.push(markFetch(fd)
      .then(function(res){ return res.json(); })
      .then(function(d){ if(!d.ok) throw 0; decCount(ids.length); decBulkCount(ids.length); retried = false; })
      // Put them back rather than dropping them, so the retry has something to
      // send and the queue stays the honest record of what the server has not
      // heard about.
      .catch(function(){ pending[app] = ids.concat(pending[app]); failed = true; }));
  });
  var flight = Promise.all(calls).then(function(){ if(failed) resync(); });
  markFlights = Promise.all([markFlights, flight]).then(function(){}, function(){});
  return flight;
}
// The queue waits 400ms for company, so a refresh or a closed tab inside that
// window would take the last few reads with it — the cards come back unread and
// you read them again. A beacon outlives the page, which a fetch does not, so
// send whatever is in hand; there is nobody left to hear a failure, and the next
// load is the honest record either way.
window.addEventListener('pagehide', function(){
  Object.keys(pending).forEach(function(app){
    var ids = pending[app]; if(!ids.length) return;
    pending[app] = [];
    var fd = new FormData(); fd.append('app', app); fd.append('json','1');
    ids.forEach(function(id){ fd.append('id', id); });
    if(navigator.sendBeacon) navigator.sendBeacon('/mark', fd);
    else markFetch(fd).catch(function(){});
  });
});
// Leaving this page for another of ours: whatever marks are still queued go
// first, because leaving is exactly when one that hasn't reached the server
// would be lost. The cover goes up as the tap lands, since the wait is the
// flush plus whatever the next page costs to build.
function leaveFor(href){
  document.getElementById('loading').classList.remove('hid');
  if (flushTimer) clearTimeout(flushTimer);
  flushPending().then(function(){ location.assign(href); });
}
// A mark the server never took leaves the page lying to you: those cards are
// greyed and off the counts over a state the server does not have, and swiping
// on only widens the gap. One retry covers a blip — a dropped packet, a phone
// waking up — because throwing the deck away for that would be its own
// annoyance. Past that, the page is beyond repairing in place, so reload: what
// comes back is what the server actually has. Reads that never landed return
// unread, which is the truth, and if the server really is gone the browser says
// so more plainly than this page could.
var retried = false;
function resync(){
  if(!retried){
    retried = true;
    if(!flushTimer) flushTimer = setTimeout(flushPending, 1500);
    return;
  }
  try { sessionStorage.setItem('tui:resync', '1'); } catch(e){}
  location.reload();
}
// Takes n off the header's unread count; a negative n hands them back, which is
// what a mark that failed after the count already moved has to do. The For You
// round is not in the backlog that count is of, so reading it leaves the number
// where it is rather than dropping it to somewhere a reload would undo.
function decCount(n){
  if(SEL === 'x:foryou') return;
  var s = document.getElementById('unreadn'); if(!s) return;
  var c = (parseInt(s.textContent, 10) || 0) - n; if(c < 0) c = 0;
  s.textContent = c;
}
function decBulkCount(n){
  var b = document.getElementById('markAll');
  if(!b) return;
  var total = Math.max(0, (parseInt(b.dataset.total, 10) || 0) - n);
  b.dataset.total = total;
  if(SWIPE) b.title = 'mark all ' + total + ' items in this feed read';
  else b.textContent = '✓ mark all ' + total + ' read';
}
// A chip's number is what picking it would bring, so reading takes it down with
// the header's. Debounced: a fast scroll marks cards faster than there is any
// point recounting.
var recountTimer = null;
function scheduleRecount(){
  if(recountTimer) return;
  recountTimer = setTimeout(recountChips, 150);
}
// What the server said each chip holds, kept before anything writes over it.
(function(){
  document.querySelectorAll('#filters .fchip[data-kind], #subs .fchip[data-kind]').forEach(function(chip){
    var n = chip.querySelector('.fn');
    if(n) chip.dataset.n0 = n.textContent;
  });
})();
function recountChips(){
  recountTimer = null;
  var gone = {app:{}, type:{}, sub:{}, all:0};
  document.querySelectorAll('article.card.read').forEach(function(c){
    gone.all++;
    gone.app[c.dataset.app] = (gone.app[c.dataset.app] || 0) + 1;
    gone.type[c.dataset.type] = (gone.type[c.dataset.type] || 0) + 1;
    if(c.dataset.sub) gone.sub[c.dataset.sub] = (gone.sub[c.dataset.sub] || 0) + 1;
  });
  document.querySelectorAll('#filters .fchip[data-kind], #subs .fchip[data-kind]').forEach(function(chip){
    var n = chip.querySelector('.fn'), base = parseInt(chip.dataset.n0, 10);
    if(!n || isNaN(base)) return;
    var group = gone[chip.dataset.kind];
    var off = chip.dataset.kind === 'x' ? gone.all : (group && group[chip.dataset.key] || 0);
    n.textContent = Math.max(0, base - off);
  });
}
function toast(m){ var t=document.getElementById('toast'); t.textContent=m; t.style.opacity='1'; setTimeout(function(){t.style.opacity='0'},1200); }
// A page that reloads itself under you is startling; say once, in passing, why.
// Nothing to act on — the reload was the fix — so it fades like any other note.
try {
  if(sessionStorage.getItem('tui:resync')){
    sessionStorage.removeItem('tui:resync');
    toast("reloaded: the server didn't take some reads");
  }
} catch(e){}
// queueRead marks one card read: muted in place and batched for the next flush.
function queueRead(el){
  if(el.classList.contains('read')) return false;  // already counted once
  var app = el.dataset.app, id = el.dataset.id;
  if(!app || !id) return false;
  el.classList.add('read');
  (pending[app] = pending[app] || []).push(id);
  if(!flushTimer) flushTimer = setTimeout(flushPending, 400);
  scheduleRecount();
  return true;
}
function queueUnread(el){
  var app = el.dataset.app, id = el.dataset.id;
  if(!app || !id) return Promise.resolve();
  var ids = pending[app] || [];
  pending[app] = ids.filter(function(q){ return q !== id; });
  return markFlights.then(function(){
    var fd = new FormData(); fd.append('app', app); fd.append('id', id);
    return fetch('/unmark', {method:'POST', body:fd})
      .then(function(res){ return res.json(); })
      .then(function(d){
        if(!d.ok) throw 0;
        el.classList.remove('read');
        if(d.changed){ decCount(-1); decBulkCount(-1); }
        scheduleRecount();
      });
  }).catch(function(){ toast('could not mark unread'); });
}
var obs = new IntersectionObserver(function(entries){
  if (ffs) return; // fake fullscreen scrolls the feed behind the video (hiding
                   // Safari's bars); that motion must not mark cards read
  entries.forEach(function(en){
    var el = en.target;
    // On screen: whatever it was before, it has now been in front of you, so
    // scrolling past it from here is a read.
    if(en.isIntersecting){ delete el.dataset.behind; return; }
    // Above the viewport since the page arrived and never seen since. The head
    // script asks the browser not to restore a scroll offset, but a browser
    // that restores one anyway (or an anchor, or a back button) must not turn
    // the whole list above it into reads: nobody scrolled past these.
    if(el.dataset.behind) return;
    var r = el.getBoundingClientRect();
    if(r.height === 0 && r.top === 0) return;
    if(r.bottom > 0) return;                      // below, not yet scrolled past
    queueRead(el);
  });
},{threshold:0});
// Exempt every card that is above the viewport right now: whatever put the page
// here, it wasn't you scrolling through them on this page.
function exemptBehind(){
  document.querySelectorAll('article.card:not(.read)').forEach(function(c){
    if (c.getBoundingClientRect().bottom <= 0) c.dataset.behind = '1';
  });
}
// The saved list is for re-reading and the blocked one for looking over, so
// scrolling through either must not mark anything read; in swipe mode the throw
// does the marking, not the scroll.
if (!SWIPE && !SAVED_VIEW && !BLOCKED_VIEW) {
  exemptBehind();
  document.querySelectorAll('article.card').forEach(function(c){ obs.observe(c); });
  // A restore can also land after this script has run, and it arrives as a
  // scroll event like any other. One that jumps a whole screen or more before
  // you have touched anything is the browser's, not yours, so what it leaves
  // above the viewport is exempt too. Only ever the first one: past that, a
  // jump that size is you dragging the scrollbar, which does read.
  var gestured = false;
  ['wheel', 'touchstart', 'keydown'].forEach(function(ev){
    window.addEventListener(ev, function(){ gestured = true; }, {passive:true});
  });
  var from = window.scrollY || 0;
  var onFirstScroll = function(){
    window.removeEventListener('scroll', onFirstScroll);
    if (!gestured && (window.scrollY || 0) - from >= window.innerHeight) exemptBehind();
  };
  window.addEventListener('scroll', onFirstScroll);
}

// Save / unsave one item. The button posts just app+id; the server pairs that
// with the item it last rendered and persists the whole thing, so a saved item
// survives the feed moving on.
function setSaved(card, on){
  var b = card.querySelector('button.save');
  var fd = new FormData();
  fd.append('app', card.dataset.app);
  fd.append('id', card.dataset.id);
  fd.append('save', on ? '1' : '0');
  if (b) b.disabled = true;
  return fetch('/save', {method:'POST', body:fd})
    .then(function(res){ if(!res.ok) throw new Error(res.status === 409 ? 'reload the page and try again' : 'could not save'); return res.json(); })
    .then(function(d){
      if (b){ b.dataset.saved = on ? '1' : '0'; b.textContent = on ? 'saved' : 'save'; }
      var n = document.getElementById('savedn');
      if (n) n.textContent = d.saved;
    })
    .catch(function(err){ toast(err.message || 'could not save'); })
    .then(function(){ if (b) b.disabled = false; });
}
document.addEventListener('click', function(e){
  var b = e.target.closest ? e.target.closest('button.save') : null;
  if (!b) return;
  setSaved(b.closest('article.card'), b.dataset.saved !== '1');
});

if(SAVED_VIEW) document.querySelectorAll('article.card').forEach(function(card){
  var footer = card.querySelector(':scope > .footer');
  if(!footer) return;
  var key = card.dataset.app + '\u0000' + card.dataset.id;
  var selected = SAVED_TAGS[key] || [];
  var row = document.createElement('div');
  row.className = 'tagrow';
  TAG_OPTIONS.forEach(function(tag){
    var button = document.createElement('button');
    button.className = 'itemtag';
    button.type = 'button';
    button.dataset.tag = tag;
    button.dataset.on = selected.indexOf(tag) >= 0 ? '1' : '0';
    button.setAttribute('aria-pressed', button.dataset.on === '1' ? 'true' : 'false');
    button.textContent = tag;
    row.appendChild(button);
  });
  footer.insertAdjacentElement('afterend', row);
});

function adjustTagCount(tag, amount){
  var chip = document.querySelector('#tagfilters a[data-key="' + tag + '"]');
  if(!chip) return;
  var count = chip.querySelector('.fn');
  var next = Math.max(0, (parseInt(count.textContent, 10) || 0) + amount);
  count.textContent = next;
  chip.classList.toggle('hid', next === 0 && chip.dataset.on !== '1');
}
document.addEventListener('click', function(e){
  var button = e.target.closest ? e.target.closest('button.itemtag') : null;
  if(!button) return;
  var card = button.closest('article.card');
  var row = button.closest('.tagrow');
  var before = row.querySelectorAll('button.itemtag[data-on="1"]').length;
  var on = button.dataset.on !== '1';
  var fd = new FormData();
  fd.append('app', card.dataset.app);
  fd.append('id', card.dataset.id);
  fd.append('tag', button.dataset.tag);
  fd.append('on', on ? '1' : '0');
  button.disabled = true;
  fetch('/tags', {method:'POST', body:fd})
    .then(function(res){ if(!res.ok) throw new Error(res.status === 409 ? 'item is no longer saved' : 'could not update tag'); return res.json(); })
    .then(function(d){
      button.dataset.on = d.on ? '1' : '0';
      button.setAttribute('aria-pressed', d.on ? 'true' : 'false');
      adjustTagCount(d.tag, d.on ? 1 : -1);
      if(before === 0 && d.on) adjustTagCount('untagged', -1);
      if(before === 1 && !d.on) adjustTagCount('untagged', 1);
      var active = document.querySelector('#tagfilters a[data-on="1"]');
      if(active && ((active.dataset.key === d.tag && !d.on) || (active.dataset.key === 'untagged' && before === 0 && d.on))){
        location.reload();
      }
    })
    .catch(function(err){ toast(err.message || 'could not update tag'); })
    .then(function(){ button.disabled = false; });
});

// Share hands the item's own text (not its quoted post's) to the OS share
// sheet. navigator.share needs a secure context, which a LAN http:// page is
// not, so the same text is copied to the clipboard there instead — the button
// always does something.
function sharePayload(card){
  var title = card.querySelector(':scope > .preview > .ctitle');
  var body = card.querySelector(':scope > .full > .body');   // full, so no clip and no word-count badge
  var link = card.querySelector(':scope > .footer > a.open[target]');
  var parts = [];
  if (title) parts.push(title.textContent.trim());
  if (body) parts.push(body.textContent.trim());
  var d = {text: parts.join('\n\n')};
  if (title) d.title = title.textContent.trim();
  if (link) d.url = link.href;
  return d;
}
function copyText(t){
  if (navigator.clipboard && navigator.clipboard.writeText) return navigator.clipboard.writeText(t);
  return new Promise(function(res, rej){
    var ta = document.createElement('textarea');
    ta.value = t; ta.setAttribute('readonly',''); ta.style.position = 'fixed'; ta.style.opacity = '0';
    document.body.appendChild(ta); ta.select();
    var ok = document.execCommand && document.execCommand('copy');
    ta.remove();
    ok ? res() : rej(new Error('copy failed'));
  });
}
document.addEventListener('click', function(e){
  var b = e.target.closest ? e.target.closest('button.share') : null;
  if (!b) return;
  var d = sharePayload(b.closest('article.card'));
  if (!d.text && !d.url) { toast('nothing to share'); return; }
  if (navigator.share){
    navigator.share(d).catch(function(err){
      if (err && err.name === 'AbortError') return; // sheet dismissed, not a failure
      toast('could not share');
    });
    return;
  }
  copyText([d.text, d.url].filter(Boolean).join('\n\n'))
    .then(function(){ toast('copied'); })
    .catch(function(){ toast('could not share'); });
});

// Attached stills render only when asked for: the footer's image toggle reveals
// every image block on the card (the post's own and its quoted post's) and
// swaps data-src to src the first time, so an unopened card downloads nothing.
document.addEventListener('click', function(e){
  var b = e.target.closest ? e.target.closest('button.img') : null;
  if (!b) return;
  var on = b.dataset.on !== '1';
  b.closest('article.card').querySelectorAll('.imgbox').forEach(function(box){
    box.classList.toggle('hid', !on);
    if (!on) return;
    box.querySelectorAll('img[data-src]').forEach(function(img){
      img.src = img.dataset.src;
      img.removeAttribute('data-src');
    });
  });
  b.dataset.on = on ? '1' : '0';
});

// The speed/mute/rotate toggles are server-rendered only for the players the
// server knew about; a player that arrives later — a YouTube embed, a resolved
// redgifs clip — needs the same footer controls added by hand. A card whose
// audio player already brought the speed button needs only the rest.
function addPlayerControls(foot){
  var ex = foot.querySelector('button.expand'); // null appends, which is the same place
  if (!foot.querySelector('button.speed')){
    var sp = document.createElement('button'); sp.type = 'button'; sp.className = 'speed'; sp.title = 'playback speed for every player';
    foot.insertBefore(sp, ex);
  }
  if (!foot.querySelector('button.rot')){
    var mu = document.createElement('button'); mu.type = 'button'; mu.className = 'mute'; mu.title = 'sound for all videos';
    var ro = document.createElement('button'); ro.type = 'button'; ro.className = 'rot'; ro.title = 'rotated fullscreen'; ro.textContent = 'rotate';
    foot.insertBefore(mu, ex); foot.insertBefore(ro, ex);
  }
  if (!foot.querySelector('button.loop')){
    var lo = document.createElement('button'); lo.type = 'button'; lo.className = 'loop'; lo.title = 'repeat every video'; lo.dataset.on = '0';
    foot.insertBefore(lo, ex); // last of the actions, as the server renders it
  }
}

// YouTube links get an inline click-to-play embed: a lazy thumbnail per video
// that swaps on tap to the official IFrame-API player, so the global speed and
// mute toggles drive it too. Embedding is the owner's call — when it's
// disabled (error 101/150) no embed can play the video, so the player is
// swapped for a watch-on-YouTube link instead of a dead black frame.
var ytPlayers = [];
var ytApiRequested = false;
function ytApi(cb){
  if (window.YT && window.YT.Player){ cb(); return; }
  if (!ytApiRequested){
    ytApiRequested = true;
    var s = document.createElement('script');
    s.src = 'https://www.youtube.com/iframe_api';
    document.head.appendChild(s);
  }
  var wait = setInterval(function(){
    if (window.YT && window.YT.Player){ clearInterval(wait); cb(); }
  }, 100);
}
function ytId(href){
  var m = href.match(/(?:youtube\.com\/watch\?[^#]*v=|youtu\.be\/|youtube\.com\/shorts\/|youtube\.com\/embed\/)([\w-]{11})/);
  return m ? m[1] : null;
}
// The length badge a native video renders server-side: YouTube states it
// nowhere the page can read, so the server looks it up and the badge lands on
// the thumbnail when the answer arrives. A tap before then just plays it.
function ytLen(thumb, id){
  fetch('/ytlen?v=' + encodeURIComponent(id))
    .then(function(res){ return res.json(); })
    .then(function(d){
      if (!d.len) return;
      var s = document.createElement('span');
      s.className = 'vlen';
      s.textContent = d.len;
      thumb.appendChild(s);
    })
    .catch(function(){}); // no badge is fine; it is a hint, not the content
}
function ytPlay(thumb, id){
  var card = thumb.closest('article.card');
  var wrap = document.createElement('div');
  wrap.className = 'yt-embed';
  var target = document.createElement('div');
  wrap.appendChild(target);
  thumb.replaceWith(wrap);
  ytApi(function(){
    var pending = true;
    var poll = null;
    // Where this one was left off, asked for as the player is built: `start` is
    // YouTube's own resume point, honored before the first frame, where a
    // seekTo() from onReady races the player's own loading.
    var at = ytResumeAt(card, id);
    var vars = {autoplay: 1, playsinline: 1, origin: location.origin};
    if (at) vars.start = Math.floor(at);
    var p = new YT.Player(target, {
      videoId: id,
      host: 'https://www.youtube-nocookie.com',
      playerVars: vars,
      events: {
        onReady: function(e){
          e.target.setPlaybackRate(ytRate());
          if (MUTED) e.target.mute(); else e.target.unMute();
          e.target._posSent = at; // already where the server has it
          e.target.playVideo();
        },
        onStateChange: function(e){
          if (e.data === YT.PlayerState.PLAYING && pending){
            e.target.setPlaybackRate(ytRate()); // loading resets the rate
            pending = false;
          }
          // An embed has no timeupdate to hang the position report on, so it is
          // polled while playing and taken once more when it stops.
          if (e.data === YT.PlayerState.PLAYING){
            if (!poll) poll = setInterval(function(){ ytSavePos(card, p, id); }, POS_EVERY * 1000);
          } else {
            clearInterval(poll); poll = null;
            if (e.data === YT.PlayerState.PAUSED || e.data === YT.PlayerState.ENDED) ytSavePos(card, e.target, id);
          }
          if (e.data === YT.PlayerState.ENDED && LOOP) e.target.playVideo(); // an embed has no loop attribute
        },
        onError: function(){
          var a = document.createElement('a');
          a.className = 'yt-blocked';
          a.href = 'https://www.youtube.com/watch?v=' + id;
          a.target = '_blank'; a.rel = 'noopener';
          a.textContent = 'embedding disabled — watch on YouTube ↗';
          wrap.replaceWith(a);
          ytPlayers = ytPlayers.filter(function(q){ return q !== p; });
        }
      }
    });
    ytPlayers.push(p);
    p._posCard = card; p._posId = id; // so a closing page can report this one too
    wrap._ytPlayer = p; // fake fullscreen finds the player via its wrapper
  });
}
// Not on the blocked list: a row there is a title and a link out, and growing a
// player under it would undo the whole point of the row being one line.
if (!BLOCKED_VIEW) document.querySelectorAll('article.card').forEach(function(card){
  var seen = {};
  card.querySelectorAll('a[href]').forEach(function(a){
    var id = ytId(a.href); if(!id || seen[id]) return; seen[id] = true;
    var d = document.createElement('div');
    d.className = 'yt';
    var img = document.createElement('img');
    img.src = 'https://i.ytimg.com/vi/' + id + '/hqdefault.jpg';
    img.alt = ''; img.loading = 'lazy';
    var play = document.createElement('span');
    play.className = 'yt-play'; play.textContent = '▶';
    d.appendChild(img); d.appendChild(play);
    ytLen(d, id);
    d.addEventListener('click', function(){ ytPlay(d, id); });
    var foot = card.querySelector('.footer');
    foot.before(d);
    // No save button: YouTube doesn't hand out direct streams the way
    // video.twimg.com does.
    addPlayerControls(foot);
  });
});

// A redgifs post is a link post: nothing on the card plays, and the mp4 hides
// behind an id casing only redgifs' API knows. The footer's video button asks
// the server for it, so a card nobody taps costs nothing, and then stays on as
// a show/hide toggle like the image one — the clip is resolved once, and a
// second tap puts the card back the way it was.
document.addEventListener('click', function(e){
  var b = e.target.closest ? e.target.closest('button.rgv') : null;
  if (!b || b.disabled) return;
  var card = b.closest('article.card');
  var shown = card.querySelector('.rgvbox');
  if (shown){
    var on = b.dataset.on !== '1';
    shown.classList.toggle('hid', !on);
    if (!on) shown.querySelector('video').pause();
    b.dataset.on = on ? '1' : '0';
    return;
  }
  b.disabled = true; b.textContent = 'loading…';
  fetch('/redgif?id=' + encodeURIComponent(b.dataset.id))
    .then(function(res){ if(!res.ok) throw 0; return res.json(); })
    .then(function(d){
      if (!d.video) throw 0;
      var box = document.createElement('div');
      box.className = 'vidbox rgvbox';
      var v = document.createElement('video');
      v.className = 'vid'; v.controls = true; v.playsInline = true; v.muted = MUTED; v.src = d.video;
      if (d.poster) v.poster = d.poster;
      box.appendChild(v);
      if (d.len){
        var len = document.createElement('span');
        len.className = 'vlen'; len.textContent = d.len;
        box.appendChild(len);
      }
      var foot = card.querySelector('.footer');
      foot.before(box);
      b.disabled = false; b.dataset.on = '1'; b.textContent = 'video';
      addPlayerControls(foot);
      v.addEventListener('play', function(){ v.playbackRate = SPEED; });
      applyMediaPrefs();
      // the tap that asked for it is the gesture that may play it
      var p = v.play();
      if (p && p.catch) p.catch(function(){});
    })
    .catch(function(){
      b.disabled = false; b.textContent = 'video';
      toast('could not load the video');
    });
});

// Playback settings are global: the speed (cycles 2× → 2.5× → 1×), mute (default muted)
// and loop (default off) buttons on any card apply to every player — native
// <video>, YouTube embeds, and podcast <audio> alike — so the whole feed
// behaves one way. The rate is re-applied on play because loading media resets
// it. Clicks are delegated since YouTube cards get their buttons injected
// after this runs.
var SPEEDS = [2, 2.5, 1];
var SPEED = SPEEDS[0];
// the IFrame API caps at 2× and ignores anything higher
function ytRate(){ return Math.min(SPEED, 2); }
var MUTED = true;
var LOOP = false;
function applyMediaPrefs(){
  document.querySelectorAll('video.vid').forEach(function(v){
    v.defaultPlaybackRate = SPEED; v.playbackRate = SPEED; v.muted = MUTED; v.loop = LOOP;
  });
  // Audio is the content, not a moving picture with a soundtrack: mute never
  // applies to it, so only the speed carries over.
  document.querySelectorAll('audio.aud').forEach(function(a){
    a.defaultPlaybackRate = SPEED; a.playbackRate = SPEED;
  });
  ytPlayers.forEach(function(p){
    if (p.setPlaybackRate) p.setPlaybackRate(ytRate());
    if (p.mute && p.unMute){ if (MUTED) p.mute(); else p.unMute(); }
  });
  document.querySelectorAll('button.speed').forEach(function(b){ b.textContent = SPEED + '×'; });
  document.querySelectorAll('button.mute').forEach(function(b){ b.textContent = MUTED ? 'unmute' : 'mute'; });
  document.querySelectorAll('button.loop').forEach(function(b){
    b.dataset.on = LOOP ? '1' : '0';
    b.textContent = LOOP ? 'looping' : 'loop';
  });
}
document.addEventListener('click', function(e){
  var b = e.target.closest ? e.target.closest('button.speed, button.mute, button.loop') : null;
  if (!b) return;
  if (b.classList.contains('speed')) SPEED = SPEEDS[(SPEEDS.indexOf(SPEED) + 1) % SPEEDS.length];
  else if (b.classList.contains('loop')) LOOP = !LOOP;
  else MUTED = !MUTED;
  applyMediaPrefs();
});
document.querySelectorAll('video.vid, audio.aud').forEach(function(m){
  m.addEventListener('play', function(){ m.playbackRate = SPEED; });
});
applyMediaPrefs();

// The length badge turns into a countdown once the clip is running: before a
// tap it answers "how long is this", after one the useful question is "how much
// is left". The badge's own text is the length, kept in the element so the end
// (or a restart) can put it back. Listens in the capture phase, which also
// catches players that arrive later (a resolved redgifs clip).
function lenBadge(el){
  var box = el.parentElement;
  return box && box.classList.contains('vidbox') ? box.querySelector('.vlen') : null;
}
function fmtLen(secs){
  secs = Math.max(0, Math.round(secs));
  var m = Math.floor(secs / 60) % 60, s = secs % 60;
  var h = Math.floor(secs / 3600);
  var mm = h ? (m < 10 ? '0' + m : '' + m) : '' + m;
  return (h ? h + ':' : '') + mm + ':' + (s < 10 ? '0' + s : '' + s);
}
function countdown(el){
  var b = lenBadge(el);
  if (!b || !isFinite(el.duration) || !el.duration) return;
  if (!b.dataset.len) b.dataset.len = b.textContent;
  var left = el.duration - el.currentTime;
  // Ceil so the last second reads 0:01 rather than sitting on 0:00.
  b.textContent = el.currentTime > 0 ? fmtLen(Math.ceil(left)) : b.dataset.len;
}
function countdownReset(el){
  var b = lenBadge(el);
  if (b && b.dataset.len) b.textContent = b.dataset.len;
}
document.addEventListener('timeupdate', function(e){ countdown(e.target); }, true);
document.addEventListener('seeked', function(e){ countdown(e.target); }, true);
document.addEventListener('ended', function(e){ countdownReset(e.target); }, true);

// Where you left off. A saved item is the one thing here that outlives the
// page, so the position in its player is kept with it: posted back as it plays
// and handed down with the card, so the next visit — on this phone or on
// another device reading the same synced store — picks up there. Media events
// don't bubble, so these listen in the capture phase, which also catches
// players that arrive later (a resolved redgifs clip).
var POS_EVERY = 15; // seconds of playback between reports
var POS_MIN = 5;    // less than this in is not worth coming back to
var POS_END = 10;   // this close to the end, it is finished, not paused
// A player this server streams itself (a bilibili clip) is reached under
// whatever address the phone typed, so its position is pinned to the path alone:
// the same saved item then resumes on another device reading the same store.
function mediaSrc(el){
  var s = el.currentSrc || el.src || '';
  return s.indexOf(location.origin + '/') === 0 ? s.slice(location.origin.length) : s;
}
// postPos sends a position for one player, or 0 to forget it. The card carries
// the last value so a re-render isn't needed to keep the page in step.
function postPos(card, src, secs, beacon){
  if (!card || !card.dataset.app) return;
  var fd = new FormData();
  fd.append('app', card.dataset.app);
  fd.append('id', card.dataset.id);
  fd.append('src', secs > 0 ? src : '');
  fd.append('secs', secs.toFixed(1));
  if (beacon && navigator.sendBeacon) navigator.sendBeacon('/pos', fd);
  else fetch('/pos', {method: 'POST', body: fd, keepalive: true}).catch(function(){});
  card.dataset.pos = secs;
  card.dataset.posKey = secs > 0 ? src : '';
}
// savePos reports where a player is now: the plain position, or 0 once it is
// past the end or back near the start, which is how a finished item forgets it.
function savePos(el, beacon){
  var card = el.closest ? el.closest('article.card') : null;
  if (!card || !isFinite(el.duration) || !el.duration) return;
  var t = el.currentTime;
  if (t >= el.duration - POS_END || t < POS_MIN) t = 0;
  if (el._posSent === t) return;
  el._posSent = t;
  postPos(card, mediaSrc(el), t, beacon);
}
// resumeMedia puts a player back where the card says it was left, once the
// browser knows how long the media runs.
function resumeMedia(el){
  var card = el.closest ? el.closest('article.card') : null;
  if (!card || !isFinite(el.duration)) return;
  var at = parseFloat(card.dataset.pos || '0');
  if (!at || card.dataset.posKey !== mediaSrc(el)) return;
  if (at < POS_MIN || at > el.duration - POS_END) return;
  el._posSent = at; // already where the server has it; don't report it back
  el.currentTime = at;
}
document.addEventListener('loadedmetadata', function(e){ resumeMedia(e.target); }, true);
// An audio bar preloads its metadata as it is parsed, which can land before
// this script runs at all — so sweep once for players that are already ready
// rather than waiting for an event that has been and gone.
document.querySelectorAll('video.vid, audio.aud').forEach(function(m){
  if (m.readyState >= 1) resumeMedia(m);
});
document.addEventListener('timeupdate', function(e){
  var el = e.target;
  if (el.paused || !isFinite(el.duration)) return;
  if (Math.abs(el.currentTime - (el._posAt || 0)) < POS_EVERY) return;
  el._posAt = el.currentTime;
  savePos(el);
}, true);
document.addEventListener('pause', function(e){ savePos(e.target); }, true);
document.addEventListener('ended', function(e){ savePos(e.target); }, true);
// A YouTube embed has no media element to listen to, so its position is read
// off the player instead. 'yt:<id>' names the stream the way a media URL names
// a native one, so one saved item can only ever resume one of them.
// ytResumeAt is where this embed should start, or 0 for the beginning. The
// duration isn't known before the player exists, so "near the end" is judged
// when the position is reported instead, which is what stored a 0 in the first
// place.
function ytResumeAt(card, id){
  if (!card || card.dataset.posKey !== 'yt:' + id) return 0;
  var at = parseFloat(card.dataset.pos || '0');
  return at >= POS_MIN ? at : 0;
}
function ytSavePos(card, p, id, beacon){
  if (!card || !p || !p.getDuration) return;
  var d = p.getDuration(), t = p.getCurrentTime();
  if (!d) return;
  if (t >= d - POS_END || t < POS_MIN) t = 0;
  if (p._posSent === t) return;
  p._posSent = t;
  postPos(card, 'yt:' + id, t, beacon);
}
// A phone closing the tab gets no second chance: send whatever is in flight.
window.addEventListener('pagehide', function(){
  document.querySelectorAll('video.vid, audio.aud').forEach(function(m){
    if (m.currentTime > 0) savePos(m, true);
  });
  ytPlayers.forEach(function(p){
    if (p.getCurrentTime && p.getCurrentTime() > 0) ytSavePos(p._posCard, p, p._posId, true);
  });
});

// Fake fullscreen (pipepipe-web's trick): pin the card's player over the
// viewport, sized 100vh×100vw and rotated -90°, so a landscape video fills a
// portrait phone without native fullscreen. A transparent tap layer splits
// the screen into thirds — top seeks +30s, bottom -30s, middle toggles play —
// and the rotated × (or Escape) exits, restoring the scroll position.
var FFS_SEEK = 30;
var ffs = null; // {el, scrollY} while active
function ffsPlayers(){
  if (!ffs) return {};
  if (ffs.el.tagName === 'VIDEO') return {video: ffs.el};
  return {yt: ffs.el._ytPlayer}; // may still be null while the API loads
}
function enterFfs(card){
  if (ffs || !card) return;
  // a player the video toggle has put away is not the one to blow up
  var el = card.querySelector('.vidbox:not(.hid) video.vid') || card.querySelector('.yt-embed');
  if (!el){
    var thumb = card.querySelector('.yt'); // not started yet: start it now
    if (thumb) thumb.click();
    el = card.querySelector('.yt-embed');
    if (!el) return;
  }
  ffs = {el: el, scrollY: window.scrollY || 0};
  var v = ffsPlayers();
  if (v.video && v.video.paused) v.video.play();
  document.documentElement.classList.add('ffs-on');
  el.classList.add('ffs');
  var tap = document.createElement('div');
  tap.className = 'ffs-tap';
  tap.addEventListener('click', ffsTap);
  document.body.appendChild(tap);
  var exit = document.createElement('button');
  exit.className = 'ffs-exit'; exit.type = 'button'; exit.title = 'exit fullscreen';
  exit.textContent = '×';
  exit.addEventListener('click', exitFfs);
  document.body.appendChild(exit);
}
function exitFfs(){
  if (!ffs) return;
  document.documentElement.classList.remove('ffs-on');
  ffs.el.classList.remove('ffs');
  var t = document.querySelector('.ffs-tap'); if (t) t.remove();
  var x = document.querySelector('.ffs-exit'); if (x) x.remove();
  window.scrollTo(0, ffs.scrollY);
  ffs = null;
}
function ffsTap(e){
  e.preventDefault();
  var pos = e.clientY / window.innerHeight;
  if (pos < 1/3) ffsSeek(FFS_SEEK);
  else if (pos > 2/3) ffsSeek(-FFS_SEEK);
  else ffsToggle();
}
function ffsSeek(d){
  var v = ffsPlayers();
  if (v.yt && v.yt.seekTo){
    var dur = (v.yt.getDuration && v.yt.getDuration()) || Infinity;
    v.yt.seekTo(Math.min(dur, Math.max(0, v.yt.getCurrentTime() + d)), true);
  } else if (v.video){
    var vd = isFinite(v.video.duration) ? v.video.duration : Infinity;
    v.video.currentTime = Math.min(vd, Math.max(0, v.video.currentTime + d));
  }
}
function ffsToggle(){
  var v = ffsPlayers();
  if (v.yt && v.yt.getPlayerState){
    if (v.yt.getPlayerState() === YT.PlayerState.PLAYING) v.yt.pauseVideo();
    else v.yt.playVideo();
  } else if (v.video){
    if (v.video.paused) v.video.play(); else v.video.pause();
  }
}
document.addEventListener('click', function(e){
  var b = e.target.closest ? e.target.closest('button.rot') : null;
  if (b) enterFfs(b.closest('article.card'));
});
document.addEventListener('keydown', function(e){ if (e.key === 'Escape') exitFfs(); });

// Expand/collapse reveals the full post content — the card's own body and the
// quoted post's, which each render as their own preview/full pair. Expanding
// is the "+N words" count at the end of the clipped text (server-rendered, so
// delegate); collapsing is the footer button, which exists only while there is
// something expanded to collapse.
document.addEventListener('click', function(e){
  var b = e.target.closest ? e.target.closest('button.rest, button.expand') : null;
  if (!b) return;
  var card = b.closest('article.card');
  card.querySelectorAll('.preview, .full').forEach(function(el){ el.classList.toggle('hid'); });
  var expanded = card.querySelector('.preview').classList.contains('hid');
  var less = card.querySelector('.footer > button.expand');
  if (less) less.classList.toggle('hid', !expanded);
});
// Mark the complete server-side pick read, not just the cards in this client
// window. The current filter travels with the request, while sort and layout do
// not affect which items belong to it.
var markAllBtn = document.getElementById('markAll');
if(markAllBtn) markAllBtn.addEventListener('click', function(){
  var total = parseInt(markAllBtn.dataset.total, 10) || 0;
  if(SWIPE && !window.confirm('Mark all ' + total + (total === 1 ? ' item' : ' items') + ' in this feed read?')) return;
  markAllBtn.disabled = true;
  if(flushTimer) clearTimeout(flushTimer);
  pending = {};
  var fd = new FormData(), q = new URLSearchParams(location.search);
  ['app', 'type', 'x', 'sub'].forEach(function(k){ if(q.has(k)) fd.append(k, q.get(k)); });
  markFlights.then(function(){ return fetch('/mark-all', {method:'POST', body:fd}); })
    .then(function(res){ return res.json(); })
    .then(function(d){ if(!d.ok) throw 0; location.reload(); })
    .catch(function(){ markAllBtn.disabled = false; toast('could not mark this feed read'); });
});
var settingsDlg = document.getElementById('settingsdlg');
var settingsOpen = document.getElementById('settingsOpen');
var feedbackRight = document.getElementById('feedbackRight');
function positionDeckFeedback(){
  var controls = document.getElementById('deckFeedback');
  if(controls) controls.classList.toggle('right', FEEDBACK_RIGHT);
}
positionDeckFeedback();
if(settingsDlg && settingsOpen && feedbackRight){
  feedbackRight.checked = FEEDBACK_RIGHT;
  settingsOpen.addEventListener('click', function(){ settingsDlg.showModal(); });
  feedbackRight.addEventListener('change', function(){
    FEEDBACK_RIGHT = feedbackRight.checked;
    try { localStorage.setItem('tui:deck-feedback-right', FEEDBACK_RIGHT ? '1' : '0'); } catch(e){}
    positionDeckFeedback();
  });
}

// The deck (?deck=1): one card on screen, with both feedback choices under one
// thumb. The footer goes back without clearing the choice already made.
if (SWIPE) (function(){
  var deck = document.getElementById('deck');
  if (!deck) return;
  var cards = [].slice.call(deck.querySelectorAll('article.card'));
  var endEl = document.getElementById('deckEnd');
  var downBtn = document.getElementById('thumbDown');
  var upBtn = document.getElementById('thumbUp');
  var at = 0;

  cards.forEach(function(card){
    var footer = card.querySelector(':scope > .footer');
    if(!footer) return;
    var button = document.createElement('button');
    button.className = 'deckback';
    button.type = 'button';
    button.title = 'mark unread and show the previous item';
    button.textContent = 'back';
    footer.insertBefore(button, footer.firstChild);
  });

  function current(){ return at < cards.length ? cards[at] : null; }
  function updateControls(done){
    var controls = document.getElementById('deckFeedback');
    if(controls) controls.classList.toggle('hid', done);
    var card = current(), key = card ? card.dataset.app + '\u0000' + card.dataset.id : '';
    var choice = card ? (card.dataset.feedback || FEEDBACK[key] || '') : '';
    if(downBtn) downBtn.classList.toggle('chosen', choice === 'down');
    if(upBtn) upBtn.classList.toggle('chosen', choice === 'up');
    if(card){
      var backBtn = card.querySelector('button.deckback');
      if(backBtn) backBtn.disabled = at === 0;
    }
  }
  function show(){
    cards.forEach(function(c, i){ c.classList.toggle('hid', i !== at); });
    var left = cards.length - at;
    deck.classList.toggle('last2', left === 2);
    deck.classList.toggle('last', left <= 1);
    window.scrollTo(0, 0); // the card that scrolled is gone; start the next at its top
    var done = at >= cards.length;
    // Hide the centering wrapper, not just the deck, or its height would leave
    // a hole above the end note. Reversible: walking back brings it out again.
    deck.parentNode.classList.toggle('hid', done);
    if (endEl) endEl.classList.toggle('hid', !done);
    updateControls(done);
    if (markAllBtn) markAllBtn.classList.toggle('hid', done);
  }
  // A card that leaves the screen takes its audio with it.
  function quiet(card){
    card.querySelectorAll('video, audio').forEach(function(m){ m.pause(); });
    card.querySelectorAll('.yt-embed').forEach(function(w){
      if (w._ytPlayer && w._ytPlayer.pauseVideo) w._ytPlayer.pauseVideo();
    });
  }
  function deal(card){
    quiet(card);
    at++;
    show();
    if (at >= cards.length && MORE){
      document.getElementById('loading').classList.remove('hid');
      if (flushTimer) clearTimeout(flushTimer);
      flushPending().then(function(){ location.reload(); });
    }
  }
  function mark(card){
    if (!SAVED_VIEW) queueRead(card); // the flush decrements the header count
    deal(card);
  }
  // Walk back through what's already been dealt and restore that card to tui's
  // unread backlog. A mark request already in flight lands before its reversal.
  function back(){
    if (at === 0){ toast('this is the first one'); return false; }
    var leaving = current();
    if (leaving) quiet(leaving);
    at--;
    show();
    var card = current();
    queueUnread(card);
    return true;
  }
  function sendFeedback(choice){
    var card = current();
    if (!card || (downBtn && downBtn.disabled) || (upBtn && upBtn.disabled)) return;
    if(downBtn) downBtn.disabled = true;
    if(upBtn) upBtn.disabled = true;
    var fd = new FormData();
    fd.append('app', card.dataset.app);
    fd.append('id', card.dataset.id);
    fd.append('feedback', choice);
    fetch('/feedback', {method:'POST', body:fd})
      .then(function(res){ if(!res.ok) throw new Error(res.status === 409 ? 'reload the page and try again' : 'could not save feedback'); return res.json(); })
      .then(function(d){
        card.dataset.feedback = d.feedback;
        updateControls(false);
        mark(card);
      })
      .catch(function(err){ toast(err.message || 'could not save feedback'); })
      .then(function(){
        if(downBtn) downBtn.disabled = false;
        if(upBtn) upBtn.disabled = false;
      });
  }
  function read(){
    var card = current();
    if(card) mark(card);
  }
  if (downBtn) downBtn.addEventListener('click', function(){ sendFeedback('down'); });
  if (upBtn) upBtn.addEventListener('click', function(){ sendFeedback('up'); });
  deck.addEventListener('click', function(e){
    var b = e.target.closest ? e.target.closest('button.deckback') : null;
    if(b) back();
  });

  // Horizontal arrows navigate without preference; vertical arrows react.
  document.addEventListener('keydown', function(e){
    if (ffs || e.metaKey || e.ctrlKey || e.altKey) return;
    var k = e.key;
    if (k === 'ArrowLeft'){ e.preventDefault(); back(); }
    else if (k === 'ArrowRight'){ e.preventDefault(); read(); }
    else if (k === 'ArrowUp'){ e.preventDefault(); sendFeedback('up'); }
    else if (k === 'ArrowDown'){ e.preventDefault(); sendFeedback('down'); }
  });
  show();
})();

// A feed page comes off the backlog cache and is instant, but the For You chip
// scrapes x live before a byte of it is sent, and until then the browser just
// sits on the page you tapped from. Cover it as the tap happens, so the wait
// looks like a wait. Only links that could refetch: the saved list is served
// from disk, and anything opening a new tab leaves this page alone.
document.addEventListener('click', function(e){
  var a = e.target.closest ? e.target.closest('a[href]') : null;
  if (!a || a.target || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button) return;
  var u = new URL(a.getAttribute('href'), location.href);
  if (u.origin !== location.origin || u.pathname !== '/') return;
  if (u.searchParams.get('saved') === '1' || u.searchParams.get('blocked') === '1') return;
  document.getElementById('loading').classList.remove('hid');
});
// Coming back through history restores this page as it was left, cover and all.
window.addEventListener('pageshow', function(){ document.getElementById('loading').classList.add('hid'); });

var clearBlockedBtn = document.getElementById('clearBlocked');
if(clearBlockedBtn) clearBlockedBtn.addEventListener('click', function(){
  var total = parseInt(clearBlockedBtn.dataset.total, 10) || 0;
  if(!window.confirm('Delete all ' + total + ' blocked ' + (total === 1 ? 'item' : 'items') + '?')) return;
  clearBlockedBtn.disabled = true;
  fetch('/blocked/clear', {method:'POST'})
    .then(function(res){ return res.json(); })
    .then(function(d){ if(!d.ok) throw 0; location.reload(); })
    .catch(function(){ clearBlockedBtn.disabled = false; toast('could not clear blocked items'); });
});

// The block list, edited in the browser's own <dialog>: a textarea of one
// keyword per line, which is the shape the list already has, so there is
// nothing to add or delete a row at a time. Cancel puts back what the server
// sent rather than keeping a half-edit for the next open, and a save reloads —
// the words change the counts in the header and the rows on the page, and the
// server is the one that knows what they came to.
(function(){
  var dlg = document.getElementById('kwdlg'), open = document.getElementById('kwopen');
  if (!dlg || !open) return;
  var text = document.getElementById('kwtext');
  var sent = text.value;
  open.addEventListener('click', function(){ dlg.showModal(); });
  dlg.addEventListener('close', function(){
    if (dlg.returnValue !== 'save'){ text.value = sent; return; }
    var fd = new FormData();
    fd.append('words', text.value);
    fetch('/keywords', {method:'POST', body:fd})
      .then(function(res){ if(!res.ok) return res.text().then(function(m){ throw new Error(m); }); return res.json(); })
      .then(function(){ location.reload(); })
      .catch(function(err){ toast((err && err.message || '').trim() || 'could not save the keywords'); });
  });
})();

// The chips, on the feed as well as the saved list. One is on at a time and
// picking it is a page load of that chip's items alone, so each chip is a plain
// link — the server does the narrowing, and x's For You (which is scraped, not
// cached) can be a chip like any other. The click is still intercepted, because
// leaving the page is exactly when a mark that hasn't reached the server yet
// would be lost.
(function(){
  ['filters','subs'].forEach(function(id){
    var bar = document.getElementById(id);
    if (!bar) return;
    bar.addEventListener('click', function(e){
      var a = e.target.closest ? e.target.closest('a.fchip') : null;
      if (!a || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button) return;
      e.preventDefault();
      leaveFor(a.getAttribute('href'));
    });
  });
})();

// The subcategory row is kept to a single line: a source can carry dozens of
// them, and a block of chips that pushes the first card off the screen is worse
// than not offering the narrowing at all. Which ones fit is a question only the
// laid-out page can answer, so the server sends them all, busiest first, and
// this hides whatever wrapped — behind a "more" that has to fit on the line too,
// which is why the trim runs until the button lands back on the first row.
(function(){
  var bar = document.getElementById('subs');
  if (!bar) return;
  var more = document.getElementById('fmore');
  var chips = Array.prototype.slice.call(bar.querySelectorAll('a.fchip'));
  if (!chips.length) return;
  var open = false;
  // Expanding is a choice about this page, so it sticks until it is taken back:
  // the button that opened the row is the one that closes it again.
  function expand(forced){
    open = true;
    chips.forEach(function(c){ c.classList.remove('hid'); });
    // Forced open because the chip that is on would have been hidden: there is
    // no collapsing back to a row that denies the page you are looking at, so
    // don't offer it.
    if (forced){ more.classList.add('hid'); return; }
    more.classList.remove('hid');
    more.textContent = 'less';
    more.title = 'back to one row';
  }
  function layout(){
    if (open) return;
    chips.forEach(function(c){ c.classList.remove('hid'); });
    more.classList.remove('hid');
    more.textContent = 'more'; // a width to measure against; the count comes below
    var top = chips[0].offsetTop, cut = chips.length;
    for (var i = 0; i < chips.length; i++){
      if (chips[i].offsetTop > top){ cut = i; break; }
    }
    if (cut === chips.length && more.offsetTop <= top){ more.classList.add('hid'); return; }
    for (var j = cut; j < chips.length; j++) chips[j].classList.add('hid');
    while (cut > 1 && more.offsetTop > top){ cut--; chips[cut].classList.add('hid'); }
    // The chip that is on says what you are looking at; hiding it would leave
    // the row denying the page it belongs to.
    for (var k = cut; k < chips.length; k++){
      if (chips[k].dataset.on === '1'){ expand(true); return; }
    }
    more.textContent = '+' + (chips.length - cut) + ' more';
    more.title = 'show the rest of them';
  }
  more.addEventListener('click', function(){
    if (open){ open = false; layout(); return; }
    expand(false);
  });
  layout();
  window.addEventListener('resize', layout);
})();

// The order and layout toggles: each a link to this same page the other way
// round, so the sorting and the laying out stay the server's over the whole
// backlog rather than this page's over the window of it that got sent. The URL
// each goes to names what it picked, and the script in the head files that away
// as what this browser wants from here on. Both leave through leaveFor, because
// a queued read that hasn't reached the server yet would be lost otherwise.
['sortlink', 'decklink', 'savedmode'].forEach(function(id){
  var a = document.getElementById(id);
  if (!a) return;
  a.addEventListener('click', function(e){
    if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button) return;
    e.preventDefault();
    leaveFor(a.getAttribute('href'));
  });
});

document.addEventListener('click', function(e){
  var b = e.target.closest ? e.target.closest('button.detail') : null;
  if (!b) return;
  var card = b.closest('article.card');
  var compact = card.classList.toggle('compact');
  b.textContent = compact ? 'details' : 'compact';
  b.title = compact ? 'show this saved item in full' : 'return this saved item to compact view';
  if (!compact) return;
  card.querySelectorAll('video, audio').forEach(function(m){ m.pause(); });
  card.querySelectorAll('.yt-embed').forEach(function(w){
    if (w._ytPlayer && w._ytPlayer.pauseVideo) w._ytPlayer.pauseVideo();
  });
});
</script>
</div></body></html>
{{define "card"}}<article class="card{{if .Compact}} compact{{end}}{{if and .Compact .ShowActions}} expandable{{end}}" data-app="{{.App}}" data-id="{{.ID}}" data-type="{{.Type}}" data-sub="{{.Source}}"{{if .PosSrc}} data-pos="{{.Pos}}" data-pos-key="{{.PosSrc}}"{{end}}><div class="meta"><span class="chip" style="background:{{.Color}}">{{.Chip}}</span>{{if .Source}}<span class="src">{{.Source}}</span>{{end}}{{if .Author}}<span class="dot">·</span><span>{{.Author}}</span>{{end}}{{if .Age}}<span class="dot">·</span><span>{{.Age}}</span>{{end}}{{if .Keyword}}<span class="kw" title="the keyword that blocked this">{{.Keyword}}</span>{{end}}</div><div class="preview">{{if .ListTitle}}<div class="ctitle compact-only">{{.ListTitle}}</div>{{end}}{{if .Title}}<div class="ctitle">{{.Title}}</div>{{end}}{{if .PreviewBody}}<div class="body">{{.PreviewBody}}</div>{{end}}</div>{{if .ShowActions}}<div class="full hid">{{if .Title}}<div class="ctitle">{{.Title}}</div>{{end}}{{if .FullBody}}<div class="body">{{.FullBody}}</div>{{end}}</div>{{end}}{{if .Video}}<div class="vidbox"><video class="vid" controls playsinline muted preload="none"{{if .Poster}} poster="{{.Poster}}"{{end}} src="{{.Video}}"></video>{{if .VidLen}}<span class="vlen">{{.VidLen}}</span>{{end}}</div>{{end}}{{if .Audio}}<audio class="aud" controls preload="metadata" src="{{.Audio}}"></audio>{{end}}{{if .Images}}<div class="imgbox hid">{{range .Images}}<img data-src="{{.}}" alt="" loading="lazy">{{end}}</div>{{end}}{{with .Quote}}<blockquote class="quote"><div class="qmeta">{{if .URL}}<a class="qsrc" href="{{.URL}}" target="_blank" rel="noopener" title="open the quoted post">{{.Source}} ↗</a>{{else}}<span class="qsrc">{{.Source}}</span>{{end}}{{if .Author}}<span class="dot">·</span><span>{{.Author}}</span>{{end}}</div>{{if .PreviewBody}}<div class="preview"><div class="body">{{.PreviewBody}}</div></div><div class="full hid"><div class="body">{{.FullBody}}</div></div>{{end}}{{if .Images}}<div class="imgbox hid">{{range .Images}}<img data-src="{{.}}" alt="" loading="lazy">{{end}}</div>{{end}}{{if .Video}}<div class="vidbox"><video class="vid" controls playsinline muted preload="none"{{if .Poster}} poster="{{.Poster}}"{{end}} src="{{.Video}}"></video>{{if .VidLen}}<span class="vlen">{{.VidLen}}</span>{{end}}</div><a class="open" href="/dl?n=x-{{$.ID}}-quote.mp4&u={{.Video}}" title="download the quoted video"><span>keep</span></a>{{end}}</blockquote>{{end}}<div class="footer">{{if .URL}}<a class="open" href="{{.URL}}" target="_blank" rel="noopener" title="open original"><span>open</span></a>{{end}}{{if .ShowActions}}<button class="save" type="button" data-saved="{{if .Saved}}1{{else}}0{{end}}" title="keep this item in the saved list">{{if .Saved}}saved{{else}}save{{end}}</button><button class="share" type="button" title="share this item">share</button>{{if .Compact}}<button class="detail" type="button" title="show this saved item in full">details</button>{{end}}{{if .HasVideo}}<button class="speed" type="button" title="playback speed for every player">2×</button><button class="mute" type="button" title="sound for all videos">unmute</button><button class="rot" type="button" title="rotated fullscreen">rotate</button>{{else if .Audio}}<button class="speed" type="button" title="playback speed for every player">2×</button>{{end}}{{if .HasImage}}<button class="img" type="button" data-on="0" title="show the attached images">image</button>{{end}}{{if .RedGif}}<button class="rgv" type="button" data-on="0" data-id="{{.RedGif}}" title="show the linked redgifs clip">video</button>{{end}}{{if .Keep}}<a class="open" href="{{.Keep}}" title="download video"><span>keep</span></a>{{end}}{{if .HasVideo}}<button class="loop" type="button" data-on="0" title="repeat every video">loop</button>{{end}}{{if .Expand}}<button class="expand hid" type="button">less</button>{{end}}{{end}}</div></article>{{end}}
