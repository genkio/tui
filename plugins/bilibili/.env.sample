# bilibili-tui credentials and settings.
#
# `tui bilibili --auth` (or `make auth`) captures your session to
# ~/.config/tui/env, which every run reads. This per-plugin .env is only an
# optional manual override for a source checkout:
#
#   cp .env.sample .env       # .env is gitignored; never commit real tokens
#   source .env && ./bilibili-tui
#
# Shell exports always win over values set here.

# Browser-session credentials (cookie-stealth). `tui bilibili --auth` captures
# these to ~/.config/tui/env; set them here only to override in a source
# checkout. BLTUI_COOKIE is the whole bilibili.com cookie set, joined as a Cookie
# header ("SESSDATA=...; bili_jct=...; buvid3=...; ...").
export BLTUI_COOKIE=

# bilibili-tui options. All optional; commented values are the defaults.

# Color theme: auto (match terminal background) | light | dark.
# export BLTUI_THEME=auto

# Auto-refresh interval, e.g. 30s or 2m. Empty = off. Keep it slow: bilibili
# risk-controls bursts of requests.
# export BLTUI_REFRESH=

# Max video posts to fetch per refresh. The feed pages about a dozen at a time,
# up to five pages.
# export BLTUI_MAX_VIDEOS=40

# User-Agent override, if you want it to match the browser the cookie came from.
# export BLTUI_UA=

# Read tracking. bilibili exposes no read state for the 动态 timeline, so
# bilibili-tui stores which posts you've seen locally in
# ~/.local/state/bilibili-tui/read.json. With unread-only on (default), read
# posts drop off on the next refresh; set false to keep them, greyed.
# export BLTUI_UNREAD_ONLY=true
