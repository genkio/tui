# douban-tui credentials and settings.
#
# `tui douban --auth` (or `make auth`) captures your session to
# ~/.config/tui/env, which every run reads. This per-plugin .env is only an
# optional manual override for a source checkout:
#
#   cp .env.sample .env       # .env is gitignored; never commit real tokens
#   source .env && ./douban-tui
#
# Shell exports always win over values set here.

# Browser-session credentials (cookie-stealth). `tui douban --auth` captures
# these to ~/.config/tui/env; set them here only to override in a source
# checkout. DBTUI_COOKIE is the whole douban.com cookie set, joined as a Cookie
# header ("dbcl2=...; bid=...; ...").
export DBTUI_COOKIE=

# douban-tui options. All optional; commented values are the defaults.

# Color theme: auto (match terminal background) | light | dark.
# export DBTUI_THEME=auto

# Auto-refresh interval, e.g. 30s or 2m. Empty = off. Keep it slow to stay
# under douban's rate limits.
# export DBTUI_REFRESH=

# Max statuses to fetch per refresh.
# export DBTUI_MAX_STATUSES=50

# Weekly 榜单 mixed into the feed, comma separated. Each id is the tail of an
# m.douban.com/subject_collection/<id> address. Set it empty for none.
# export DBTUI_CHARTS=movie_weekly_best,tv_global_best_weekly,show_global_best_weekly

# User-Agent override, if you want it to match the browser the cookie came from.
# export DBTUI_UA=

# Read tracking. Douban exposes no read state for the timeline, so douban-tui
# stores which statuses you've read locally in
# ~/.local/state/douban-tui/read.json. With unread-only on (default), read
# statuses drop off on the next refresh; set false to keep them, greyed.
# export DBTUI_UNREAD_ONLY=true
